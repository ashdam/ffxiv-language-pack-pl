    { "en": "Warrior of Light", "fr": "Guerrier de la Lumière", "ja": "光の戦士", "pl": "<if(gnum4,Wojowniczka,Wojownik)> Światła", "protect": false, "note": "Z makrem, gdy nazywa gracza; w liczbie mnogiej i historycznie «Wojownicy Światła». Warrior of Darkness tak samo, «Ciemności»." },
    { "en": "the Twelve", "fr": "les Douze", "ja": "十二神", "pl": "Dwunastu", "protect": false, "note": "Imiona bogów zostają." },
