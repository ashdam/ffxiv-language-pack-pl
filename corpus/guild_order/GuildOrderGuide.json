    { "gameKey": "guild_order/GuildOrderGuide#TEXT_GUILDORDERGUIDE_INFO_TALK_00", "hash": "8B61FC6657494273", "target": "Guildhest to niewielkie operacje drużynowe nadzorowane przez Gildię Poszukiwaczy Przygód." },
    { "gameKey": "guild_order/GuildOrderGuide#TEXT_GUILDORDERGUIDE_INFO_TALK_01", "hash": "B05AFFBA88415412", "target": "Walki odbywają się w instancjach i mają różne limity czasu." },
    { "gameKey": "guild_order/GuildOrderGuide#TEXT_GUILDORDERGUIDE_INFO_TALK_02", "hash": "1185AFE72F573802", "target": "Nagrody za ukończenie operacji zależą od wyników drużyny. Premię przyznaje się za pierwsze ukończenie danego guildhest każdą klasą." },
    { "gameKey": "guild_order/GuildOrderGuide#TEXT_GUILDORDERGUIDE_INFO_TALK_03", "hash": "EE149A8CFE8AEF5F", "target": "Premia przysługuje także za ukończenie operacji z minimalną liczbą nokautów." },
    { "gameKey": "guild_order/GuildOrderGuide#TEXT_GUILDORDERGUIDE_INFO_TALK_04", "hash": "9F8C4D6BDD56D9E8", "target": "Nowe operacje stają się dostępne wraz ze wzrostem poziomu lub kończeniem istniejących guildhest. Niektóre można odblokować tylko rozmową z określonymi nadzorcami bojowymi." },
