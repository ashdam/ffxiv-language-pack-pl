  "entries": [
    { "gameKey": "cut_scene/074/VoiceMan_07410#TEXT_VOICEMAN_07410_000010_METEM", "hash": "C7906DD301648913", "target": "Przyspieszy wam puls, jednocześnie mrożąc krew w żyłach! Ponętna Vamp Fatale!" },
    { "gameKey": "cut_scene/074/VoiceMan_07410#TEXT_VOICEMAN_07410_000020_METEM", "hash": "18CD5829CEC8923E", "target": "Mkną na falach i płomieniach. Zabójczy duet─the Xtremes!" },
    { "gameKey": "cut_scene/074/VoiceMan_07410#TEXT_VOICEMAN_07410_000030_REFEREE", "hash": "CA621B31BD7B123C", "target": "K.O.!" },
    { "gameKey": "cut_scene/074/VoiceMan_07410#TEXT_VOICEMAN_07410_000040_METEM", "hash": "34549C9993C3C643", "target": "Walka rozstrzygnięta! Zwycięstwo <if(gnum4,pretendentki,pretendenta)>!" },
    { "gameKey": "cut_scene/074/VoiceMan_07410#TEXT_VOICEMAN_07410_000050_METEM", "hash": "20871B1D49158AD4", "target": "Rządzi wszystkimi żelazną pięścią, wielki mistrz Arcadionu─the Tyrant!" },
    { "gameKey": "cut_scene/074/VoiceMan_07410#TEXT_VOICEMAN_07410_000060_REFEREE", "hash": "E056744575ED032C", "target": "K.O.!" },
    { "gameKey": "cut_scene/074/VoiceMan_07410#TEXT_VOICEMAN_07410_000070_METEM", "hash": "2A6B2D471CEEFC9E", "target": "Walka rozstrzygnięta! Na waszych oczach rodzi się <if(gnum4,nowa wielka mistrzyni,nowy wielki mistrz)>!" },
    { "gameKey": "cut_scene/074/VoiceMan_07410#TEXT_VOICEMAN_07410_000080_METEM", "hash": "3289FF26C02904F3", "target": "Oto szokujące prawdziwe oblicze nikczemnego prezesa! Potężny pradawny wąż─Lindwurm!" },
    { "gameKey": "cut_scene/074/VoiceMan_07410#TEXT_VOICEMAN_07410_000090_METEM", "hash": "E75D2C2652C4C652", "target": "Niewiarygodne─<if(gnum4,mistrzyni tego dokonała,mistrz tego dokonał)>! Prezes pokonany!" }
