{
  "conversation": "cut_scene/050/VoiceMan_05006",
  "gameVersion": "2026.09.15.0000.0000",
  "entries": [
    { "gameKey": "cut_scene/050/VoiceMan_05006#TEXT_VOICEMAN_05006_000001_OLDTITANIA", "hash": "C563DA51EB6B0615", "target": "Kto tam? Czy to ty odpowiadasz za przełamanie pieczęci?" },
    { "gameKey": "cut_scene/050/VoiceMan_05006#TEXT_VOICEMAN_05006_000002_OLDTITANIA", "hash": "6F06D40A3ADCA366", "target": "Ach, tyle czasu straconego... Tyle zabaw i uczt przepadło..." },
    { "gameKey": "cut_scene/050/VoiceMan_05006#TEXT_VOICEMAN_05006_000003_OLDTITANIA", "hash": "0A5521D2E22C6AAA", "target": "Musimy to nadrobić, musimy... Zacznijmy od zabawy z <italic(1)>tobą<italic(0)>!" },
    { "gameKey": "cut_scene/050/VoiceMan_05006#TEXT_VOICEMAN_05006_000010_OLDTITANIA", "hash": "F6750105EA33FFB6", "target": "Nie możemy się już... bawić..." },
    { "gameKey": "cut_scene/050/VoiceMan_05006#TEXT_VOICEMAN_05006_000110_VAUTHRY", "hash": "BD6CF9EB7F3ED4EC", "target": "Tak bardzo chcecie umrzeć? Ostatnia szansa, nikczemnicy: padnijcie na kolana i uznajcie swojego króla. Swojego boga!" },
    { "gameKey": "cut_scene/050/VoiceMan_05006#TEXT_VOICEMAN_05006_000120_VAUTHRY", "hash": "1BB2136161BB98A7", "target": "Ale... przecież jestem wszechmocny..." },
    { "gameKey": "cut_scene/050/VoiceMan_05006#TEXT_VOICEMAN_05006_000210_EMETSELCH", "hash": "3164D5E59540FB73", "target": "Pokaż mi swą „słynną” siłę. A ja obnażę kłamstwo twojego rozbitego istnienia!" },
    { "gameKey": "cut_scene/050/VoiceMan_05006#TEXT_VOICEMAN_05006_000220_EMETSELCH", "hash": "04BF5A9209AB3A78", "target": "Ty... ty nie masz nade mną władzy!" }
  ]
}
