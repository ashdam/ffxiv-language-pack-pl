    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_MY_CHOCOBO_DETAIL", "hash": "56E466B048D8DD41", "target": "Obejrzeć chocobo." },
