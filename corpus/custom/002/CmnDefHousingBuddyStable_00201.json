    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_MENU_EXPLAIN_TRAIN_B", "hash": "35576ECD9FF443BF", "target": "Specjalna pasza" },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_MENU_EXPLAIN_TRAIN_C", "hash": "3FE9A6A8EDA4E231", "target": "Trenowanie cudzych chocobo" },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_MENU_EXPLAIN_CHANGE_COLOR_A", "hash": "526C65131FB1368E", "target": "Przekąski" },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_MENU_EXPLAIN_CHANGE_COLOR_B", "hash": "BE3FF1FB5025553E", "target": "Przywracanie pierwotnej barwy upierzenia" },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_MENU_EXPLAIN_CLEAN", "hash": "4259C34DDE3E71DA", "target": "Utrzymywanie stajni w czystości" },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_MENU_EXPLAIN_CANCEL", "hash": "A885FEE6F609FE03", "target": "Wróć" },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_A1", "hash": "AD7313FB940631FB", "target": "Możesz trenować swojego chocobo, gdy przebywa w stajni. Dzięki temu zdobywa PD towarzysza. Aby trenować chocobo, najpierw przygotuj <colortype(500)><edgecolortype(501)>paszę<edgecolortype(0)><colortype(0)>, która posłuży jako <colortype(500)><edgecolortype(501)>nagroda<edgecolortype(0)><colortype(0)>." },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_A2", "hash": "52EF2C86C18BCCCC", "target": "Po treningu chocobo musi odpocząć i odzyskać siły, zanim będzie można trenować go ponownie." },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_A3", "hash": "08FF1F56FA703FF8", "target": "Gdy twój chocobo zgromadzi maksymalną liczbę PD towarzysza dla swojej obecnej rangi, możesz podnieść jego rangę w walce." },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_A4", "hash": "76929AF23367D297", "target": "Ponadto, jeśli twój chocobo osiągnął już maksymalną rangę, możesz po treningu nakarmić go przedmiotem Thavnairian Onion, aby podnieść ten limit." },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_A5", "hash": "3B9FCB86782F119F", "target": "Możesz też trenować cudze chocobo, jeśli masz odpowiednie uprawnienia. Pamiętaj jednak, że nie możesz podnosić ich maksymalnej rangi ani wpływać na ich upodobania żywieniowe." },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_A6", "hash": "D0E9C712B735DF0A", "target": "Między twoimi treningami chocobo musi odpocząć i odzyskać siły. Ponieważ jednak dobrze reaguje na nowe bodźce, inni członkowie mogą w tym czasie trenować tego samego chocobo─po czym sami muszą odczekać, zanim zrobią to ponownie." },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_B1", "hash": "74903C4F93011FE2", "target": "Niektóre rodzaje paszy zapewniają chocobo korzystne efekty, gdy zostanie przywołany do walki." },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_B2", "hash": "541BCB3277EB9AE2", "target": "Do takich rodzajów paszy należą przedmioty Curiel Root, Sylkis Bud, Mimett Gourd i Pahsana Fruit." },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_B3", "hash": "357BF2597E077D48", "target": "Jeśli stale nagradzasz chocobo tą samą paszą, stanie się ona jego <colortype(500)><edgecolortype(501)>ulubioną paszą<edgecolortype(0)><colortype(0)>, a korzystne efekty, które zapewnia po przywołaniu go do walki, będą silniejsze." },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_B4", "hash": "79AABE786B539964", "target": "Ponadto, gdy twój chocobo osiągnie maksymalną rangę, nakarmienie go przedmiotem Thavnairian Onion podniesie ten limit." },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_C1", "hash": "37758DEF20F1D0D9", "target": "Możesz trenować cudze chocobo, jeśli masz odpowiednie uprawnienia." },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_C2", "hash": "C7FDC3CCF9050886", "target": "Jeśli udostępniasz komuś swoją prywatną posiadłość, możesz nadać tej osobie uprawnienia do umieszczania swojego chocobo w stajni i trenowania cudzych." },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_C3", "hash": "C0C0433BCAF12BBE", "target": "Jeśli masz mieszkanie, możesz również trenować chocobo osób, które zajmują inne lokale w tym samym budynku." },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_C4", "hash": "C844C32853F44607", "target": "Aby trenować cudzego chocobo, trzeba odczekać pewien czas od umieszczenia go w stajni." },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_C5", "hash": "9EEECFF490A8A4E8", "target": "Trening prowadzony przez właściciela chocobo i trening prowadzony przez inną osobę są traktowane oddzielnie. Czas odpoczynku po jednym nie wpływa na drugi. Ponadto nie możesz podnosić maksymalnej rangi cudzych chocobo ani wpływać na ich upodobania żywieniowe." },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_CLEAN_1", "hash": "65CE341D5C7375A2", "target": "Trening jest skuteczniejszy, jeśli chocobo przebywa w czystej stajni." },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_CLEAN_2", "hash": "417F2BE19A5D2088", "target": "Stajnię można sprzątać za pomocą <colortype(500)><edgecolortype(501)>przedmiotów Magicked Stable Broom<edgecolortype(0)><colortype(0)>." },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_CHANGE_COLOR_A1", "hash": "61BA4FE3A4AC3A03", "target": "Jeśli chcesz zmienić upierzenie swojego chocobo, możesz <colortype(500)><edgecolortype(501)>karmić<edgecolortype(0)><colortype(0)> go przekąskami." },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_CHANGE_COLOR_A2", "hash": "0DBC00EB5351633C", "target": "Do przekąsek należą przedmioty Xelphatol Apple, Valfruit, Mamook Pear, Cieldalaes Pineapple, O'Ghomoro Berries i Doman Plum. Każdy z nich inaczej wpływa na upierzenie twojego chocobo." },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_CHANGE_COLOR_A3", "hash": "71AD8A350CDCF350", "target": "Po pierwszym karmieniu musisz pozostawić chocobo w stajni na co najmniej sześć godzin, aby jego upierzenie zmieniło barwę." },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_CHANGE_COLOR_A4", "hash": "A32AD5D845B81472", "target": "Jeśli wyprowadzisz chocobo ze stajni zbyt wcześnie, zmiana nie nastąpi." },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_CHANGE_COLOR_B1", "hash": "66EF1F82F545B2DF", "target": "Nakarmienie chocobo przedmiotem Han Lemon przywróci jego upierzeniu pierwotną żółtą barwę." },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_MY_CHOCOBO_TITLE", "hash": "6FA0DD41CBF4D0E3", "target": "Wybierz opcję." },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_MY_CHOCOBO_TRAIN", "hash": "C5591BE53F7DCF8C", "target": "Trenować mojego chocobo." },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_MY_CHOCOBO_FEED", "hash": "59CBB346CBBA6AD6", "target": "Nakarmić mojego chocobo." },
