    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_PROMPT_BUDDY_RENAME_CAPTION", "hash": "7412C014F5FBEF17", "target": "Imię" },
    { "gameKey": "custom/002/CmnDefHousingBuddyStable_00201#TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_PROMPT_BUDDY_RENAME_MES0", "hash": "BFB94B02A060AC39", "target": "Imię musi zawierać od 2 do 20 liter. Może zawierać apostrofy, ale nie łączniki." },
