{
  "conversation": "custom/007/CtsMjiEntrance_00798",
  "gameVersion": "2026.10.16.0000.0000",
  "entries": [
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_BARDIN_000_000", "hash": "3D06F797198F019B", "target": "Ahoj, <if(gnum4,dziewczyno,chłopcze)>. Dokąd cię zabrać?" },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_SYSTEM_000_020", "hash": "993BE6DCD5FF5AC7", "target": "Musisz wrócić na swój świat macierzysty, by popłynąć na prywatną wyspę w Island Sanctuary." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_SYSTEM_000_000", "hash": "9001FF9D67685FF6", "target": "Co zrobisz?" },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_SYSTEM_000_005", "hash": "BCDE85DBB5B07F5E", "target": "Popłynąć na swoją wyspę?" },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_SYSTEM_000_010", "hash": "85A5EA89029892CB", "target": "Czyją wyspę odwiedzisz?" },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_SYSTEM_000_015", "hash": "499D436C2379EF57", "target": "O co zapytasz?" },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_Q1_000_000", "hash": "264B296B9D81AFC4", "target": "Popłynąć na swoją wyspę." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_Q1_000_005", "hash": "03B7445ABEB84BE3", "target": "Popłynąć na wyspę znajomej osoby." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_Q1_000_010", "hash": "D812E7AFD733BF96", "target": "Dowiedzieć się więcej." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_Q1_000_015", "hash": "E05B8B330D14F7AA", "target": "Nic." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_Q2_000_000", "hash": "3631EBAB3EE585C8", "target": "Zapytać o swoją wyspę." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_Q2_000_005", "hash": "458B074F50629AB0", "target": "Zapytać o swoją wyspę." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_Q2_000_010", "hash": "7013CBAFF4D69EFD", "target": "Zapytać o wyspy znajomych." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_Q2_000_015", "hash": "E1856FA1DA727551", "target": "Nic." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_Q3_000_000", "hash": "EFFCAEB962945FEB", "target": "Przyjaciel." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_Q3_000_005", "hash": "403BA90E3B6BD1AC", "target": "Członek mojej Free Company." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_Q3_000_010", "hash": "BFD1F1A1562EE085", "target": "Członek drużyny." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_Q3_000_015", "hash": "A9F582348D6A6FFB", "target": "Nieważne." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_BARDIN_100_000", "hash": "5371ABFE572E31EC", "target": "Pytasz mnie o własną cholerną wyspę? Chyba sobie kpisz. \\<wzdycha> Mam nadzieję, że ten pomysł Tataru wychodzi ci na dobre." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_BARDIN_200_000", "hash": "6FAEE783162A48EE", "target": "Chcesz wiedzieć, co można robić na własnej wyspie? Co tylko zechcesz, o to właśnie chodzi. Zbuduj małe pastwisko dla zwierząt, zasadź coś albo po prostu zwiedzaj. Wszystko zależy od ciebie. Jeśli chcesz mieć własną, potrzebujesz znajomości." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_SYSTEM_200_000", "hash": "78E2150E3EB2957F", "target": "Aby odblokować prywatną wyspę w Island Sanctuary, musisz najpierw ukończyć zadanie głównego scenariusza „Endwalker” i poczynić postępy w zadaniu „W poszukiwaniu azylu”." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_SYSTEM_200_005", "hash": "54A230D1B548CDB7", "target": "Aby odblokować prywatną wyspę w Island Sanctuary, musisz dotrzeć do określonego etapu zadania „W poszukiwaniu azylu”. Można je rozpocząć u niezorientowanego naganiacza w Old Sharlayan." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_BARDIN_300_000", "hash": "DFAB85234679858A", "target": "Pani admirał pozwoliła pewnej liczbie poszukiwaczy przygód zagospodarować Cieldalaes─wielki archipelag niezamieszkanych wysp na Morzu Rhotano, gdyby nie było ci to wiadome. Znam te wody jak własną kieszeń, więc daj tylko słowo, a możemy wypływać." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_SYSTEM_300_000", "hash": "A70E44F008B23EAB", "target": "Możesz odwiedzić wyspę w Island Sanctuary należącą do znajomego, członka drużyny lub członka Free Company, który odblokował tę funkcję." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_SYSTEM_300_005", "hash": "E19AA19B08B9DF4F", "target": "Nie odwiedzisz wyspy w Island Sanctuary, jeśli jej właściciel zabronił wstępu, nie ma na niej nikogo lub osiągnęła już maksymalną liczbę gości." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_SYSTEM_300_010", "hash": "4DB795307AA2B389", "target": "Ponadto, aby odwiedzić wyspę znajomej osoby w Island Sanctuary, musisz przebywać na jej świecie macierzystym." }
  ]
}
