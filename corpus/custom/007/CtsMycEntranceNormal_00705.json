    { "gameKey": "custom/007/CtsMycEntranceNormal_00705#TEXT_CTSMYCENTRANCENORMAL_00705_A3_000_005", "hash": "01C501F8981CCF5D", "target": "Wróć." },
    { "gameKey": "custom/007/CtsMycEntranceNormal_00705#TEXT_CTSMYCENTRANCENORMAL_00705_SERAOUSH_000_000", "hash": "F434B14FAA53ED7E", "target": "Śmiem twierdzić, że w całym Ruchu Oporu nie ma żołnierza, który nie słyszał jeszcze o <if(gnum4,pani,pana)> dokonaniach na południowym froncie." },
    { "gameKey": "custom/007/CtsMycEntranceNormal_00705#TEXT_CTSMYCENTRANCENORMAL_00705_SYSTEM_000_001", "hash": "6205734ACCF6D048", "target": "Twoja ranga Ruchu Oporu to <num(lnum1)>, a zgromadzone męstwo wynosi <kilo(lnum2,\\,)>." },
    { "gameKey": "custom/007/CtsMycEntranceNormal_00705#TEXT_CTSMYCENTRANCENORMAL_00705_SYSTEM_000_005", "hash": "79FF7C34D841FF29", "target": "Masz już najwyższą rangę Ruchu Oporu." },
    { "gameKey": "custom/007/CtsMycEntranceNormal_00705#TEXT_CTSMYCENTRANCENORMAL_00705_SYSTEM_000_010", "hash": "27480C3D906783F2", "target": "Do następnej rangi Ruchu Oporu potrzeba <kilo(lnum1,\\,)> punktów męstwa." },
    { "gameKey": "custom/007/CtsMycEntranceNormal_00705#TEXT_CTSMYCENTRANCENORMAL_00705_SYSTEM_000_015", "hash": "E96A4DDEDC562C48", "target": "Masz dość męstwa, by podnieść rangę Ruchu Oporu. Zgłoś się do dowódcy Ruchu Oporu w strefie Bozjan southern front." },
    { "gameKey": "custom/007/CtsMycEntranceNormal_00705#TEXT_CTSMYCENTRANCENORMAL_00705_Q4_000_000", "hash": "FAED406344807E0E", "target": "Co zrobisz?" },
    { "gameKey": "custom/007/CtsMycEntranceNormal_00705#TEXT_CTSMYCENTRANCENORMAL_00705_A4_000_000", "hash": "8C541B7A44FA952F", "target": "Wejdę do Delubrum Reginae." },
    { "gameKey": "custom/007/CtsMycEntranceNormal_00705#TEXT_CTSMYCENTRANCENORMAL_00705_A4_000_001", "hash": "AC232D32F4F31C0F", "target": "Zapytam o Delubrum Reginae." },
    { "gameKey": "custom/007/CtsMycEntranceNormal_00705#TEXT_CTSMYCENTRANCENORMAL_00705_A4_000_002", "hash": "7DB581EE9AB3514D", "target": "Porozmawiam." },
    { "gameKey": "custom/007/CtsMycEntranceNormal_00705#TEXT_CTSMYCENTRANCENORMAL_00705_A4_000_005", "hash": "4AF32DFC789AB94C", "target": "Nic." },
    { "gameKey": "custom/007/CtsMycEntranceNormal_00705#TEXT_CTSMYCENTRANCENORMAL_00705_MIKOTO_000_100", "hash": "D1927F35CE34C860", "target": "Gdybym tylko pamiętała, co zrobiła mi Misija. Przypominam sobie dziwne urządzenie i to, że mnie przywiązano, ale niestety reszta tonie we mgle..." },
    { "gameKey": "custom/007/CtsMycEntranceNormal_00705#TEXT_CTSMYCENTRANCENORMAL_00705_MIKOTO_000_101", "hash": "D1258769392B376E", "target": "Skoro posunęła się tak daleko, by opanować te ruiny, może to oznaczać tylko jedno─w środku musi znajdować się zapas kryształów zdolnych zasilić Save the Queen." },
    { "gameKey": "custom/007/CtsMycEntranceNormal_00705#TEXT_CTSMYCENTRANCENORMAL_00705_MIKOTO_000_102", "hash": "38DE4AC6549E88E2", "target": "Proszę ją powstrzymać! Jeśli zdoła uwolnić pełną moc tego ostrza, wszelka nadzieja przepadnie!" }
  ]
