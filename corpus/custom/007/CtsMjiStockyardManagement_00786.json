    { "gameKey": "custom/007/CtsMjiStockyardManagement_00786#TEXT_CTSMJISTOCKYARDMANAGEMENT_00786_Q1_000_010", "hash": "0C9B656E09023D95", "target": "Nic." },
    { "gameKey": "custom/007/CtsMjiStockyardManagement_00786#TEXT_CTSMJISTOCKYARDMANAGEMENT_00786_OFFICER_000_000", "hash": "2ED22FEEB348906A", "target": "Dokąd wysłać następną wyprawę?" },
    { "gameKey": "custom/007/CtsMjiStockyardManagement_00786#TEXT_CTSMJISTOCKYARDMANAGEMENT_00786_OFFICER_000_005", "hash": "FD48295513DFABB0", "target": "Właśnie wróciła ekipa z wyprawy! Mam tu wszystko, co zebrali, więc pamiętaj odebrać materiały, gdy znajdziesz chwilę." },
    { "gameKey": "custom/007/CtsMjiStockyardManagement_00786#TEXT_CTSMJISTOCKYARDMANAGEMENT_00786_OFFICER_100_000", "hash": "9A1868B4498007C2", "target": "Ze spichlerza możesz wysłać ekipę najlepszych mammetów odkrywców, by zebrała rozmaite materiały w wybranym przez ciebie miejscu. Powiedz tylko dokąd, a poślę ich tam w mgnieniu oka." },
    { "gameKey": "custom/007/CtsMjiStockyardManagement_00786#TEXT_CTSMJISTOCKYARDMANAGEMENT_00786_OFFICER_200_000", "hash": "9C377C8E4E1C7FEB", "target": "Widzę bratnią odkrywczą duszę. Możesz zwiedzać wyspę─eee, o ile masz zgodę właściciela─ale obawiam się, że działalność tego obiektu jest ściśle poufna." },
    { "gameKey": "custom/007/CtsMjiStockyardManagement_00786#TEXT_CTSMJISTOCKYARDMANAGEMENT_00786_OFFICER_300_000", "hash": "A84BC8BFA39DBB1A", "target": "Cała wyspa mówi o tej nowej jaskini! Jeśli chcesz, mogę wysłać tam ekipę i sprawdzić, jakie cenne materiały da się znaleźć." }
