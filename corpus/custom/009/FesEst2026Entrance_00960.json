    { "gameKey": "custom/009/FesEst2026Entrance_00960#TEXT_FESEST2026ENTRANCE_00960_A1_000_001", "hash": "93B33CAA420CEAFE", "target": "Wziąć udział w minigrze „Pęd do porządków”." },
    { "gameKey": "custom/009/FesEst2026Entrance_00960#TEXT_FESEST2026ENTRANCE_00960_A1_000_002", "hash": "3450EAFA319C5D4B", "target": "Dowiedzieć się więcej o minigrze „Pęd do porządków”." },
    { "gameKey": "custom/009/FesEst2026Entrance_00960#TEXT_FESEST2026ENTRANCE_00960_A1_000_003", "hash": "0B819579CCCC2A00", "target": "Nic." },
    { "gameKey": "custom/009/FesEst2026Entrance_00960#TEXT_FESEST2026ENTRANCE_00960_TALK_SYSTEM_000_010", "hash": "842F155FD66603CA", "target": "Przed udziałem w minigrze „Pęd do porządków” musisz anulować oczekujące zgłoszenia w Wyszukiwarce aktywności oraz nabór członków drużyny, a także opuścić drużynę, do której obecnie należysz." },
    { "gameKey": "custom/009/FesEst2026Entrance_00960#TEXT_FESEST2026ENTRANCE_00960_TALK_SYSTEM_000_015", "hash": "F876E11541BEC214", "target": "Twój ekwipunek jest pełny, więc otrzymanie wszystkich nagród może być niemożliwe." },
