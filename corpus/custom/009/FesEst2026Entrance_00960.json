    { "gameKey": "custom/009/FesEst2026Entrance_00960#TEXT_FESEST2026ENTRANCE_00960_ENTRANCEMAN0960_000_000", "hash": "6E075703A3B39EC6", "target": "Za zgodą Nonotty zabierzemy <if(gnum4,panią,pana)> na arenę, gdy tylko będzie trzeba." },
    { "gameKey": "custom/009/FesEst2026Entrance_00960#TEXT_FESEST2026ENTRANCE_00960_ENTRANCEMAN0960_000_001", "hash": "E1E012D61339EA46", "target": "Gdy będzie <if(gnum4,pani gotowa,pan gotowy)>, odprowadzę <if(gnum4,panią,pana)> na jajeczną arenę. Jeśli mogę jeszcze w czymś pomóc, proszę śmiało powiedzieć." },
    { "gameKey": "custom/009/FesEst2026Entrance_00960#TEXT_FESEST2026ENTRANCE_00960_SYSTEM_000_002", "hash": "F686E42A50A91EEE", "target": "Aby kontynuować to zadanie, musisz najpierw ukończyć cztery etapy minigry „Pęd do porządków”." },
    { "gameKey": "custom/009/FesEst2026Entrance_00960#TEXT_FESEST2026ENTRANCE_00960_SYSTEM_000_003", "hash": "D03644A3BC0E5FF5", "target": "Więcej o minigrze „Pęd do porządków” dowiesz się od przewodniczki jaj." },
    { "gameKey": "custom/009/FesEst2026Entrance_00960#TEXT_FESEST2026ENTRANCE_00960_Q1_000_000", "hash": "CA55323203D8EB0C", "target": "Co zrobisz?" },
