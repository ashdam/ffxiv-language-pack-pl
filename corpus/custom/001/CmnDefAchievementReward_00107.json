    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_TERREMIAUX_A4_03", "hash": "B95823976323FD69", "target": "<sheet(AchievementKind,3,0)>." },
    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_TERREMIAUX_A4_04", "hash": "E5B4055B95E7535D", "target": "<sheet(AchievementKind,4,0)>." },
    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_TERREMIAUX_A4_05", "hash": "1B0841AA1DC54859", "target": "<sheet(AchievementKind,5,0)>." },
    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_TERREMIAUX_A4_07", "hash": "0AC0074E7E0FFFEA", "target": "<sheet(AchievementKind,8,0)>." },
    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_TERREMIAUX_A4_08", "hash": "5462FDC87EABB989", "target": "<sheet(AchievementKind,11,0)>." },
    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_TERREMIAUX_A4_09", "hash": "FAF3409A9D44499E", "target": "<sheet(AchievementKind,12,0)>." },
    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_TERREMIAUX_A4_10", "hash": "B7105CE8118271C5", "target": "Anuluj." },
    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_SYSTEM_000_041", "hash": "CFB4BFE092B1FC6D", "target": "Nagrody można też odbierać bezpośrednio z menu „Osiągnięcia” w kategorii „Postać” menu głównego. " }
