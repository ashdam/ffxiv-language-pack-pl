{
  "conversation": "custom/001/CmnDefAchievementReward_00107",
  "gameVersion": "2026.10.16.0000.0000",
  "entries": [
    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_JONATHAS_000_001", "hash": "2B976CE8D4508355", "target": "Witaj, <if(gnum4,młoda damo,młodzieńcze)>. Jak miło, że chcesz dotrzymać towarzystwa takiemu niedołężnemu staruszkowi jak ja. Powiedz, lubisz opowieści? Ja przepadam za dobrymi historiami, zwłaszcza prawdziwymi, opowiadanymi przez tych, którzy sami je przeżyli. Jeśli masz jakieś własne, zamieniam się w słuch." },
    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_TERREMIAUX_Q1_01", "hash": "DA892CFD8F01B999", "target": "Co chcesz zrobić?" },
    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_TERREMIAUX_A1_01", "hash": "5D2F2458E450CBCC", "target": "Odbierz nagrodę za osiągnięcie." },
    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_TERREMIAUX_A1_02", "hash": "5E225F3E99C67EA7", "target": "Zapytaj o Jonathasa." },
    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_TERREMIAUX_A1_03", "hash": "A2D205B55D3A00A4", "target": "Nic." },
    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_TERREMIAUX_A1_04", "hash": "D8FD83291FF541EB", "target": "Wymień certyfikat achievement certificate." },
    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_JONATHAS_000_010", "hash": "3A960A4939A78579", "target": "Za młodu miałem zaszczyt pracować jako nadworny skryba. Ach, stare dobre czasy, gdy wzrok miałem jeszcze bystry, a rodzina królewska wciąż sprawowała prawdziwą władzę w Ul'dah." },
    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_JONATHAS_000_011", "hash": "DBD11954C54799AA", "target": "Zdawało się, że nie mija dzień, by pałac królewski nie rozbłysnął tęczą barw podczas wystawnych uroczystości i hucznych uczt. Dziś jednak najbardziej cieszą mnie prawdziwe opowieści o przygodach i śmiałych czynach." },
    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_JONATHAS_000_012", "hash": "F3D23A25CC398658", "target": "Jeśli masz na koncie czyny, z których jesteś <if(gnum4,dumna,dumny)>, z wielką chęcią o nich posłucham. Może nawet dam ci coś w zamian." },
    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_SYSTEM_000_013", "hash": "A83E65B686B18198", "target": "Za zdobycie niektórych osiągnięć przysługuje nagroda, którą można odebrać podczas rozmowy z Jonathasem." },
    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_SYSTEM_010_031", "hash": "45B20D68D47AEBCA", "target": "Każde zdobyte osiągnięcie daje punkty osiągnięć. Gdy uzbierasz ich określoną liczbę, otrzymasz certyfikat achievement certificate." },
    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_JONATHAS_000_030", "hash": "1F7B9CA3E08C6F4C", "target": "Twoich dokonań starczyłoby bardom na pieśni do końca życia, <if(gnum4,moja droga,mój drogi)>. Takie osiągnięcia zasługują na uznanie, dlatego chcę ci to podarować. Przyjmij ten dar jako wyraz mojego najwyższego szacunku.   " },
    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_SYSTEM_000_031", "hash": "116D15C33C0797A6", "target": "Zgromadzone punkty osiągnięć zapewniły ci certyfikat achievement certificate." },
    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_SYSTEM_000_032", "hash": "37347483A0D34E24", "target": "Certyfikaty można wymienić na wybraną specjalną nagrodę podczas rozmowy z Jonathasem." },
    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_TERREMIAUX_Q4_01", "hash": "DA640115075B3106", "target": "Wybierz kategorię osiągnięć." },
    { "gameKey": "custom/001/CmnDefAchievementReward_00107#TEXT_CMNDEFACHIEVEMENTREWARD_00107_TERREMIAUX_A4_01", "hash": "8CC0BF668FCDC3E5", "target": "<sheet(AchievementKind,1,0)>." },
