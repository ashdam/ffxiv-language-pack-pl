{
  "conversation": "custom/001/RegWilVesperBay_00124",
  "gameVersion": "2026.10.16.0000.0000",
  "entries": [
    { "gameKey": "custom/001/RegWilVesperBay_00124#TEXT_REGWILVESPERBAY_00124_WILFRID_000_000", "hash": "F3D7AE2128ACD2AA", "target": "Masz do mnie jakąś sprawę?" },
    { "gameKey": "custom/001/RegWilVesperBay_00124#TEXT_REGWILVESPERBAY_00124_WILFRID_000_010", "hash": "A74479F1510662B5", "target": "Jestem kapitanem tutejszego portu w Zatoce Nieszporów. Odpowiadam za to, żeby wszystko zawsze szło gładko." },
    { "gameKey": "custom/001/RegWilVesperBay_00124#TEXT_REGWILVESPERBAY_00124_WILFRID_000_011", "hash": "053780F0CDD7BCFD", "target": "Szczycę się tym, że utrzymuję najlepszy port na kontynencie. Ruch tu wielki i bez sprawnego zarządzania bardzo szybko zapanowałby chaos." },
    { "gameKey": "custom/001/RegWilVesperBay_00124#TEXT_REGWILVESPERBAY_00124_WILFRID_000_020", "hash": "610F245F0E693D5B", "target": "Zatokę Nieszporów zbudowano zaledwie kilka lat temu, ale w tak krótkim czasie stała się główną morską bramą do Ul'dah." },
    { "gameKey": "custom/001/RegWilVesperBay_00124#TEXT_REGWILVESPERBAY_00124_WILFRID_000_021", "hash": "9D5F1AD8C30DDF6A", "target": "Żeby mogły tu cumować nawet największe statki, przeprowadzono ogromne prace pogłębiające dno morskie. Kosztowne przedsięwzięcie umożliwiła wyłącznie hojność lorda Lolorita." },
    { "gameKey": "custom/001/RegWilVesperBay_00124#TEXT_REGWILVESPERBAY_00124_WILFRID_000_022", "hash": "0C91F584E9FFA3D6", "target": "To jemu nasz port zawdzięcza swój rozkwit. Przedsiębiorczym osobom nie brakuje tu okazji." },
    { "gameKey": "custom/001/RegWilVesperBay_00124#TEXT_REGWILVESPERBAY_00124_Q1_000_000", "hash": "84325050D3DD2379", "target": "O co zapytasz?" },
    { "gameKey": "custom/001/RegWilVesperBay_00124#TEXT_REGWILVESPERBAY_00124_A1_000_001", "hash": "AF3B6F34A3706954", "target": "Co tu robisz?" },
    { "gameKey": "custom/001/RegWilVesperBay_00124#TEXT_REGWILVESPERBAY_00124_A1_000_002", "hash": "EF8648BF9DC9C43B", "target": "Co to za miejsce?" },
    { "gameKey": "custom/001/RegWilVesperBay_00124#TEXT_REGWILVESPERBAY_00124_A1_000_003", "hash": "4B946F63AB00F49D", "target": "Nic." }
  ]
}
