{
  "conversation": "custom/006/RegNor4Girutt_00688",
  "gameVersion": "2026.10.16.0000.0000",
  "entries": [
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_GIRUTT_000_000", "hash": "C590590ECF271B6C", "target": "Na drinka? Pech, zamknięte." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_GIRUTT_000_001", "hash": "01F660295752F7EB", "target": "Chcesz pomóc za barem, jak mniemam?" },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_GIRUTT_000_002", "hash": "F7F14D3C878289B3", "target": "Dobrze. W Luca's Locket chcemy zadowolić klienta, ale bez tanich sztuczek w rodzaju „ciepłej i przyjaznej obsługi”. Sekret tkwi w zrozumieniu jego potrzeb i nalaniu mu dokładnie tego, na co ma ochotę, zanim sam się zorientuje. Wszystko, co musisz wiedzieć, jest w tej książce z przepisami." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_Q1_000_000", "hash": "1530E6424F0839FD", "target": "Co zrobisz?" },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_A1_000_001", "hash": "E40517DB84D22F92", "target": "Sprawdź książkę z przepisami." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_A1_000_002", "hash": "1BFEC45633C803EC", "target": "Stań za barem." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_A1_000_003", "hash": "A0D99D6EEFDD19DE", "target": "Nic." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_Q2_000_000", "hash": "4EC0532ABE604F47", "target": "Który rozdział chcesz przeczytać?" },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_A2_000_001", "hash": "13BC2C7C0044A0FC", "target": "Ważne wskazówki dla odpowiedzialnych barmanów." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_A2_000_002", "hash": "D12844B87C5D51C7", "target": "Przepisy na upicie się." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_A2_000_003", "hash": "40087F3C973210D7", "target": "Żadnego! Gram według własnych zasad." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_RECIPE00688_000_020", "hash": "573F4471927E3354", "target": "Podstawą wszystkich napojów podawanych w Luca's Locket jest etanol. Choć pierwotnie opracowano go jako paliwo do czołgów, równie dobrze sprawdza się jako paliwo dla krasnoludów." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_RECIPE00688_000_021", "hash": "D33C154D5402B798", "target": "Można by sądzić, że picie nierozcieńczonego etanolu to całkiem rozsądny sposób jego spożycia, lecz poparzone gardło autora świadczy o czymś przeciwnym. Wymieszanie go z dowolną z poniższych substancji ułatwia jednak przełknięcie napoju oraz utrzymanie go w żołądku." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_RECIPE00688_000_022", "hash": "04B65C264E411C34", "target": "Główne składniki to:<br>Skalna goryczka<br>Aromatyczny kwas<br>Słodka słodka woda<br>" },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_RECIPE00688_000_023", "hash": "804ACEDCED8E3634", "target": "Wybierz dwa z tych składników (NIE próbuj użyć wszystkich trzech─patrz tytuł), dodaj je do etanolu i porządnie wstrząśnij mieszaniną przed podaniem." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_RECIPE00688_000_030", "hash": "CC068B0222378C3B", "target": "Krasnoludzka klepka:<br>W odróżnieniu od prawdziwej skład tego napoju nie jest tajemnicą. Tak jak prawdziwa zwali cię na tyłek. Powstaje ze skalnej goryczki i aromatycznego kwasu." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_RECIPE00688_000_031", "hash": "DE37CF3CF9296A82", "target": "Przeklęta Biel:<br>Jeśli po wypiciu tej mieszanki stracisz wzrok, nie obawiaj się─to część zabawy. Powstaje ze skalnej goryczki i słodkiej słodkiej wody." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_RECIPE00688_000_032", "hash": "AF8F3B2954CE7095", "target": "Bóbrowy trunek:<br>Inspirowany opowieściami o tajemniczych bestiach przemierzających Il Mheg, których siekacze podobno są z czystego cukru. Czy coś takiego. Powstaje z aromatycznego kwasu i słodkiej słodkiej wody." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_GIRUTT_000_040", "hash": "4DA1BE4DFE92399E", "target": "No dobra, pokaż, co potrafisz." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_GIRUTT_000_041", "hash": "381C580A2DD6CD5E", "target": "A oto i klient, jak na zawołanie." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_Q3_000_000", "hash": "0EFE8A02433B7212", "target": "Jaki klient się zbliża?" },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_A3_000_001", "hash": "B981A3DD4DA03368", "target": "Krasnoludka nadciągająca z wielką prędkością." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_A3_000_002", "hash": "D8C1C8BC38ADD02E", "target": "Zasadnicza Viis." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_A3_000_003", "hash": "F1A85B0DA16905EF", "target": "Żwawe pixie." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_GIOTT_000_050", "hash": "A1DDD4F7F7145440", "target": "Lali-ho! Czy nos mnie myli, czy czuję tu gorzałę?" },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_GIOTT_000_051", "hash": "5C6F4072A7257DF9", "target": "Ha! Co ja gadam? Gdzie krasnoludy, tam i gorzała! No już, nie każ mi czekać." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_Q4_000_000", "hash": "D99E9264C3BBB095", "target": "Wybierz pierwszy dodatek smakowy." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_A4_000_001", "hash": "0BD521B27A1797BC", "target": "Skalna goryczka." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_A4_000_002", "hash": "B205090D57558D70", "target": "Aromatyczny kwas." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_A4_000_003", "hash": "EE2783D5FAA8EB94", "target": "Słodka słodka woda." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_Q5_000_000", "hash": "E875D000042962EE", "target": "Wybierz drugi dodatek smakowy." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_A5_000_001", "hash": "80895B7055565722", "target": "Aromatyczny kwas." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_A5_000_002", "hash": "8FDC9D2D85E895BE", "target": "Słodka słodka woda." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_Q6_000_000", "hash": "9716535C91892420", "target": "Wybierz drugi dodatek smakowy." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_A6_000_001", "hash": "2D06C46B92349431", "target": "Skalna goryczka." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_A6_000_002", "hash": "BCF2D991D68306E4", "target": "Słodka słodka woda." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_Q7_000_000", "hash": "9F71EBD0990F41F3", "target": "Wybierz drugi dodatek smakowy." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_A7_000_001", "hash": "8D2BCF1F78888080", "target": "Skalna goryczka." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_A7_000_002", "hash": "E9DCA69971163A5B", "target": "Aromatyczny kwas." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_GIOTT_000_055", "hash": "53A5512DBBFDA29B", "target": "„Krasnoludzka klepka”? Sama nie wymyśliłabym lepszej nazwy! Wiedz, że oczekuję cholernie dobrego pierwszego łyka. I drugiego. I trzeciego!" },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_GIOTT_000_056", "hash": "8FCAE45E5A6E508D", "target": "\\<gulp> \\<gulp> \\<gulp> Aaaa... To jest to! Miły, gorzki posmak, jak w ulubionej gorzale mojej matki." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_GIOTT_000_057", "hash": "0D981E4198DB7C32", "target": "Ta kobieta <italic(1)>naprawdę<italic(0)> umie machać toporem─musisz ją zobaczyć po jakiejś beczułce! Pamiętam, jak byłam dzieckiem i cała nasza dzieciarnia biegła na dwór patrzeć, jak kładzie bestię za bestią, groźniejsza od zdziczałego hoba..." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_GIOTT_000_058", "hash": "7C9B7E958B5B9BC4", "target": "Co nie znaczy, że nazywam własną matkę hobem! Moja matka nie jest hobem! Nazywasz moją matkę hobem!? ...Ha! Żartuję. Świetna z ciebie osoba─i gorzała też świetna! Wrócę, gdy znów zabraknie mi paliwa." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_GIOTT_000_060", "hash": "AC6DBF2B1299D832", "target": "„Przeklęta Biel”... Trochę złowroga nazwa, nie sądzisz? Ale nie będę narzekać, jeśli smak będzie w porządku." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_GIOTT_000_061", "hash": "3C92227EEF214E89", "target": "\\<gulp> \\<gulp> \\<gulp> Aaaa..." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_GIOTT_000_062", "hash": "4BA1EA91335C378C", "target": "Niezłe... Całkiem niezłe! Z początku było tak słodkie, że myślałam, że próbujesz otruć mnie jakimś <italic(1)>napojem bezalkoholowym<italic(0)>, ale potem gorycz o mało nie urwała mi łba!" },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_GIOTT_000_063", "hash": "68C8F336CAFD559B", "target": "Dobrze wchodzi, powiedziałabym. Może nawet za dobrze... Nie próbujesz mnie upić, co? Ha! Potrzeba dużo więcej, żeby powalić starą Giott, ale doceniam starania. Dzięki za drinka!" },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_GIOTT_000_065", "hash": "F49BD70F08BEF9A7", "target": "„Bóbrowy trunek”? O bobrach nie wiem wiele, ale część o trunku całkiem mi odpowiada!" },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_GIOTT_000_066", "hash": "9058D470E132E2F8", "target": "\\<gulp> \\<gulp> Uuuurgh..." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_GIOTT_000_067", "hash": "D4A8CF0D6DD796FE", "target": "Słodsze od miodownika w cukrowej polewie! Nie piłam czegoś takiego, odkąd sięgałam do kolan... no, czemuś niezbyt wysokiemu." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_GIOTT_000_068", "hash": "C7E3EB9E2A99ECCA", "target": "Ha! Wtedy ciągle pakowałam się w tarapaty─zresztą nadal to robię! A skoro o tym mowa, paru tutejszym bestyjkom przydałoby się porządne lanie moim młotem. Życz mi szczęścia!" },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_LYNA_000_070", "hash": "1CA45532D8C11EED", "target": "A więc to ten krasnoludzki browar, o którym tyle słyszałam. Stacjonujący w pobliżu żołnierze bardzo go sobie chwalą." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_LYNA_000_071", "hash": "00F87FF3CB23E4BA", "target": "Muszę jednak przyznać, że nie spodziewałam się tu <if(gnum4,pani,pana)> zobaczyć, <split(<string(gstr1)>, ,1)>. I to za barem. Skoro jestem poza służbą, czy mogę prosić o drinka?" },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_Q8_000_000", "hash": "8B7E87A40AF153CE", "target": "Wybierz pierwszy dodatek smakowy." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_A8_000_001", "hash": "010611C26675D4D7", "target": "Skalna goryczka." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_A8_000_002", "hash": "99BBFA30C25211C3", "target": "Aromatyczny kwas." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_A8_000_003", "hash": "A42753756595CD12", "target": "Słodka słodka woda." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_Q9_000_000", "hash": "15F3D8BDB4E40F73", "target": "Wybierz drugi dodatek smakowy." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_A9_000_001", "hash": "F1EB34C3F84518DD", "target": "Aromatyczny kwas." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_A9_000_002", "hash": "D1300F3DC6AC9FB9", "target": "Słodka słodka woda." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_Q10_000_000", "hash": "98E016B7B36C4EDD", "target": "Wybierz drugi dodatek smakowy." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_A10_000_001", "hash": "4871DF3D02AAD562", "target": "Skalna goryczka." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_A10_000_002", "hash": "A0C81C0155CE81ED", "target": "Słodka słodka woda." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_Q11_000_000", "hash": "F911F6D65A8DE89D", "target": "Wybierz drugi dodatek smakowy." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_A11_000_001", "hash": "197A4197A7B5EB1C", "target": "Skalna goryczka." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_A11_000_002", "hash": "4F8DE487CDD8C52E", "target": "Aromatyczny kwas." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_LYNA_000_075", "hash": "A96F47FBE36CC511", "target": "„Krasnoludzka klepka”? Gdybym nie wiedziała lepiej, uznałabym, że to jakiś rodzaj drewnianej podłogi. Oby tylko smak nie był podobny." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_LYNA_000_076", "hash": "3372A3D34DE377AD", "target": "Hmm... Muszę przyznać, że nie jestem przyzwyczajona do takiej goryczy. Może trzeba z czasem się do niej przekonać?" },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_LYNA_000_077", "hash": "3DC57ECED5F93F52", "target": "Choć po kilku takich napojach pewnie w ogóle przestałabym czuć jakikolwiek smak." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_LYNA_000_078", "hash": "AA2FCBD29CE93AC1", "target": "Niemniej bardzo dziękuję. Do następnego razu." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_LYNA_000_080", "hash": "F3A83E77CE255DA7", "target": "„Przeklęta Biel”? Widzę, że nazwa nie pochodzi od koloru. Oby sam napój nie był równie niesmaczny." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_LYNA_000_081", "hash": "1EF8109499B99463", "target": "Hmm... To popularne wśród krasnoludów, tak?" },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_LYNA_000_082", "hash": "5A181E4294930A73", "target": "Choć mieszkańcy Crystarium nie we wszystkim podzielają ich upodobania, zależy nam na rozwoju handlu między naszymi ludami. Dlatego musimy jak najlepiej poznać krasnoludzką kulturę." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_LYNA_000_083", "hash": "765542137E80100C", "target": "Choć przywyknięcie do podanej przez <if(gnum4,panią,pana)> „Przeklętej Bieli” może zająć trochę czasu, sądzę, że część naszych mieszkańców uzna ją za... nie taką złą. Po powrocie na pewno wspomnę o niej Glynardowi." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_LYNA_000_084", "hash": "D636A63899217C0F", "target": "„Bóbrowy trunek”? Jeśli przypomina stworzenie, od którego wziął nazwę, powinien być zachwycający." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_LYNA_000_085", "hash": "6ABE1C5D10B4FA39", "target": "Wyśmienite. Wyobrażam sobie, że Egzarcha polubiłby coś takiego, gdyby tylko zdołał się przełamać i pić przy innych." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_LYNA_000_086", "hash": "1C47488B770B6D95", "target": "Zawsze świadomy obowiązków, nigdy nie chciał pokazać osobom, które na nim polegają, innego oblicza niż oblicze przywódcy... Ale może to tylko moje przypuszczenia i naprawdę nie lubi takich rzeczy." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_LYNA_000_087", "hash": "C21DF97CF99013A0", "target": "Tak czy inaczej, dziękuję za drinka. Do zobaczenia." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_TYRBEQ_000_090", "hash": "C9611D4C38883F47", "target": "Kogo ja tu widzę, <split(<string(gstr1)>, ,1)>! Pewnie tak samo dziwi cię mój widok tak daleko od domu. Dzieci, które przyszły do Lyhe Mheg, opowiedziały mi o zabawach swoich rodziców." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_TYRBEQ_000_091", "hash": "9BC19CB832E8624C", "target": "Nie, nie o takich zabawach! Mówię o alkoholu! To prawda, że macie go tutaj? Bardzo chcę spróbować!" },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_Q12_000_000", "hash": "E605DD0243998EF0", "target": "Wybierz pierwszy dodatek smakowy." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_A12_000_001", "hash": "BC8E7AD0652C2DCD", "target": "Skalna goryczka." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_A12_000_002", "hash": "EB34BEB7D3010012", "target": "Aromatyczny kwas." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_A12_000_003", "hash": "8506E4675737FD9D", "target": "Słodka słodka woda." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_Q13_000_000", "hash": "29A99D2DC592451E", "target": "Wybierz drugi dodatek smakowy." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_A13_000_001", "hash": "C07966985E5AA648", "target": "Aromatyczny kwas." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_A13_000_002", "hash": "3BF60D5CFE6F18ED", "target": "Słodka słodka woda." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_Q14_000_000", "hash": "B56567523BF94B66", "target": "Wybierz drugi dodatek smakowy." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_A14_000_001", "hash": "72D0BEFA1F2C3B29", "target": "Skalna goryczka." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_A14_000_002", "hash": "3890B336B1F46702", "target": "Słodka słodka woda." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_Q15_000_000", "hash": "41212056E60AFCB4", "target": "Wybierz drugi dodatek smakowy." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_A15_000_001", "hash": "A99DC3458C2CC4C9", "target": "Skalna goryczka." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_A15_000_002", "hash": "1557847FB1F3308C", "target": "Aromatyczny kwas." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_TYRBEQ_000_095", "hash": "6844A3A25042A1E3", "target": "„Krasnoludzka klepka”? Czyli takie klepnięcie? Tego nauczyły mnie dzieci, wiesz!" },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_TYRBEQ_000_096", "hash": "40F0A8A615B42E20", "target": "Spróbujmy łyczka..." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_TYRBEQ_100_096", "hash": "61BD708161BC8CE3", "target": "Ojej!" },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_TYRBEQ_000_097", "hash": "C4A3B024C2A825C6", "target": "Ble! Nie wiem, jak wy, śmiertelnicy, możecie pić to paskudztwo! Ale może Ezel je polubi. W końcu żywi się koszmarami, a to koszmar w płynie." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_TYRBEQ_000_098", "hash": "2E896CF4125EC152", "target": "Mam nadzieję, dla waszego dobra, że nie każdy alkohol smakuje tak podle jak ta paskudna mikstura. Jeśli kiedyś zbiorę się na odwagę i wrócę, liczę, że następnym razem przygotujecie mi coś znośniejszego!" },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_TYRBEQ_000_100", "hash": "24BF476F2C37AEAA", "target": "„Przeklęta Biel”? Tak mówicie, śmiertelnicy, gdy uderzycie się w palec u nogi, prawda? My, pixie, oczywiście nie mamy tego problemu. No dobrze, spróbujmy..." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_TYRBEQ_000_101", "hash": "EB95D2738AEB29A5", "target": "Zobaczmy..." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_TYRBEQ_100_101", "hash": "EC98D45C146D06BC", "target": "Powiadam, wspaniałe!" },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_TYRBEQ_000_102", "hash": "57818C4391C52B90", "target": "Ależ słodkie jak ogon stworzenia echevore!" },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_TYRBEQ_000_103", "hash": "73E0619B31FB724A", "target": "Można to pić cały dzień! Właściwie może ja─och, chwileczkę. Dziwnie się czuję. Mam wrażenie, że unoszę się w powietrzu... Zaraz, przecież się unoszę, prawda? Już nic nie rozumiem." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_TYRBEQ_000_105", "hash": "3FABEBCD03EEFAF8", "target": "„Bóbrowy trunek”!? Nie, wszystko, tylko nie bobry! Och, to tylko nazwa?" },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_TYRBEQ_000_106", "hash": "5A57A591C9355BF2", "target": "To może spróbuję łyczka." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_TYRBEQ_000_107", "hash": "83095294571EB465", "target": "\\<squeal> \\<squeal>" },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_TYRBEQ_000_108", "hash": "245259E37A289246", "target": "Ha, ha, ha! Musisz żałować, że nie widzisz swojej miny!" },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_TYRBEQ_000_109", "hash": "46D131AC8E0A1EC8", "target": "Przepraszam, to nie miało cię przestraszyć. To tylko pokazuje, że nie ma nic straszniejszego od bobra, nawet jeśli to tylko ja używam swoich mocy, żeby cię nabrać!" },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_TYRBEQ_000_110", "hash": "70C927598EB7E0B5", "target": "No, to było zabawne. Przynajmniej dla mnie. Dzięki za drinka, <split(<string(gstr1)>, ,1)>!" },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_GIRUTT_000_115", "hash": "E7C10FEDB3258EDB", "target": "Wygląda na to, że mieszanie masz opanowane, ale to dopiero początek. Teraz musisz popracować nad rozmową. Nie możesz tylko się uśmiechać i kiwać głową, zostawiając klientowi całą rozmowę!" },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_GIRUTT_000_116", "hash": "0B4170A8D6619423", "target": "Za tak dobrą pracę nie policzę ci nic za dzisiejszą lekcję bycia idealnym barmanem. Tak trzymaj, a może któregoś dnia nawet ci zapłacę! Żartuję, nadal dopiero zaczynasz." },
    { "gameKey": "custom/006/RegNor4Girutt_00688#TEXT_REGNOR4GIRUTT_00688_GIRUTT_000_120", "hash": "10C55E6AE7610B7E", "target": "Jeśli nie chcesz pracować ani kupić drinka, możesz spadać. Ale jeśli postanowisz przestać marnować mój czas, moje drzwi zawsze stoją otworem. To znaczy te przysłowiowe." }
  ]
}
