    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_A3_000_002", "hash": "B5B9B1845F8E0D3A", "target": "Zakończyć." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_Q4_000_001", "hash": "91DA188941734E47", "target": "Klasa manekina zostanie zmieniona na <sheet(ClassJob,lnum1,0)>. Kontynuować?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_Q32_000_001", "hash": "0FD4DDBB0956D4F6", "target": "Wybierz rasę." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_A32_000_001", "hash": "98CBFE1D1DBA6805", "target": "<sheet(Race,lnum1,0)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_A32_000_002", "hash": "A1CCCA205E6662AC", "target": "Zakończyć." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_Q33_001_001", "hash": "7B9BFD8832D239E5", "target": "Wybierz płeć." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_A33_001_001", "hash": "68B6AD8499FAADA6", "target": "Męska." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_A33_001_002", "hash": "B9C98BB974B926AE", "target": "Żeńska." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_A33_001_003", "hash": "48EA63FB8CCD6C7A", "target": "Zakończyć." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_Q34_002_001", "hash": "87A2AEAD340B085A", "target": "Rasa manekina zostanie zmieniona na <sheet(Race,lnum1,0)>, a płeć na <if([lnum2==0],męską,żeńską)>. Kontynuować?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_Q5_000_001", "hash": "CBB45D30834F3BE6", "target": "Wybierz rasę i płeć." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_A5_000_001", "hash": "87F8D7067CB49392", "target": "Miqo'te, mężczyzna." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_A5_000_002", "hash": "DE8BBB36DE3BEA24", "target": "Miqo'te, kobieta." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_A5_000_003", "hash": "003618B47DB22BDC", "target": "Zakończyć." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_Q6_000_001", "hash": "FF135B66C4489896", "target": "Manekin zostanie zmieniony w <if([lnum1>1],kobietę Miqo'te,mężczyznę Miqo'te)>. Kontynuować?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_Q7_000_001", "hash": "81E2F8535100AAD2", "target": "Wybierz pozę." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_A7_000_000", "hash": "77D62A9957BAC6AD", "target": "<sheet(HousingMerchantPose,lnum1,1)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_A7_000_001", "hash": "BF269EBE021AFA4C", "target": "Zakończyć." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_Q8_000_001", "hash": "20E5DBAD916994B1", "target": "Poza manekina zostanie zmieniona na <sheet(HousingMerchantPose,lnum1,1)>. Kontynuować?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HYURAN_MALE_TYPE1", "hash": "7DD3CEDEA0BA0800", "target": "Jestem, <if(gnum4,pani,panie)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HYURAN_MALE_TYPE2", "hash": "5A62FE8EAF415E5D", "target": "Nie ma się czym przejmować." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HYURAN_MALE_TYPE3", "hash": "CE00F65C00EBC5BE", "target": "Było wezwanie?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HYURAN_MALE_TYPE4", "hash": "859B08A2503A5AAE", "target": "Tak? \\<westchnienie> Mam nadzieję, że to nie potrwa długo..." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HYURAN_MALE_TYPE5", "hash": "F638B81C23CDA6FF", "target": "Chcesz zobaczyć, jak mistrz radzi sobie na bazarze?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HYURAN_MALE_TYPE6", "hash": "5AE55FA7CC9C0621", "target": "Witam, witam! Było wezwanie?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HYURAN_FEMALE_TYPE1", "hash": "F5C949592DDFEC3B", "target": "Do usług, <if(gnum4,moja pani,mój panie)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HYURAN_FEMALE_TYPE2", "hash": "012F7F46513EB2D9", "target": "Co tym razem, kochanie?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HYURAN_FEMALE_TYPE3", "hash": "7C7B9158EC1A110C", "target": "Czego sobie życzysz?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HYURAN_FEMALE_TYPE4", "hash": "52F62D6DA83D4308", "target": "Bardzo przepraszam za tę zwłokę, <if(gnum4,proszę pani,proszę pana)>. Bardzo, bardzo przepraszam." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HYURAN_FEMALE_TYPE5", "hash": "1E8A617D04953C1B", "target": "Tylko szybko, mam jeszcze inne sprawy." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HYURAN_FEMALE_TYPE6", "hash": "B9571B5551F411DE", "target": "No proszę, <if(gnum4,moja ulubiona klientka,mój ulubiony klient)>! Jak zawsze miło <if(gnum4,panią,pana)> widzieć!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ELEZEN_MALE_TYPE1", "hash": "2AB8C1FBE249A401", "target": "Tak, <if(gnum4,proszę pani,proszę pana)>? Jakie są rozkazy?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ELEZEN_MALE_TYPE2", "hash": "D58014FF6C45B694", "target": "Co w planach, <if(gnum4,szefowo,szefie)>? Pozbawianie frajerów ciężko zarobionych gili?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ELEZEN_MALE_TYPE3", "hash": "82FD2BB233D9BE05", "target": "Jestem. Można zaczynać." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ELEZEN_MALE_TYPE4", "hash": "17AB77EC51236518", "target": "Och, witam. Czemu zawdzięczam tę przyjemność?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ELEZEN_MALE_TYPE5", "hash": "BDF39A6397039511", "target": "Jestem tu dla interesów i tylko dla interesów." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ELEZEN_MALE_TYPE6", "hash": "3C7C0EACC41411D0", "target": "Wygląda <if(gnum4,pani,pan)> zdrowo. W czym mogę pomóc w ten piękny <if([gnum11<12],<if([gnum11<4],wieczór,poranek)>,<if([gnum11<17],dzień,wieczór)>)>?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ELEZEN_FEMALE_TYPE1", "hash": "9E1295E7AC4B9C21", "target": "Czym mam się zająć, <if(gnum4,moja pani,mój panie)>?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ELEZEN_FEMALE_TYPE2", "hash": "7D3FC139E86984E1", "target": "Zwykle to ja wzywam, a inni czekają." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ELEZEN_FEMALE_TYPE3", "hash": "ED24FF5DA930F1A4", "target": "Czy mogę w czymś pomóc?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ELEZEN_FEMALE_TYPE4", "hash": "902F16D65FE73B8C", "target": "Och, dlaczego wzywa mnie <if(gnum4,pani,pan)> w takiej chwili...?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ELEZEN_FEMALE_TYPE5", "hash": "C06BBA87E06578C8", "target": "Z pewnością to wezwanie ma doskonałe uzasadnienie." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ELEZEN_FEMALE_TYPE6", "hash": "B1C5B59644878380", "target": "Wie <if(gnum4,pani,pan)> co, coś mi mówiło, że niedługo mnie <if(gnum4,pani,pan)> wezwie. Zapewniam, że z zapałem czekam na polecenia." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_LALAFELL_MALE_TYPE1", "hash": "D1D730C68C6DEC11", "target": "Pozdrowienia, <if(gnum4,proszę pani,proszę pana)>. Pokornie odpowiadam na wezwanie." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_LALAFELL_MALE_TYPE2", "hash": "F84C47511BA25E9A", "target": "Kłaniam się i pozdrawiam, <if(gnum4,moja pani,mój panie)>. Proszę wyrazić życzenia, a ja zrobię, co w mojej mocy, żeby je spełnić." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_LALAFELL_MALE_TYPE3", "hash": "796B673E9A13C265", "target": "Już zaczynało mnie zastanawiać, kiedy wreszcie mnie wezwiesz." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_LALAFELL_MALE_TYPE4", "hash": "8CF9411B6556587D", "target": "Może załatwimy to szybko? Czeka na mnie taka ślicznotka." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_LALAFELL_MALE_TYPE5", "hash": "00FF44E6FC84A0C2", "target": "Co?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_LALAFELL_MALE_TYPE6", "hash": "4BF98D696634555A", "target": "Jestem, jestem!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_LALAFELL_FEMALE_TYPE1", "hash": "C274C397AD53CB55", "target": "Oto jestem, <if(gnum4,pani,panie)>, zgodnie z życzeniem." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_LALAFELL_FEMALE_TYPE2", "hash": "612E4AD32C521C44", "target": "Witaj, kochanie. Co dziś w planach?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_LALAFELL_FEMALE_TYPE3", "hash": "B8B60A6D01456F11", "target": "Nie przepuszczam żadnej okazji, żeby napchać te kieszenie." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_LALAFELL_FEMALE_TYPE4", "hash": "8D1865E0370A49A5", "target": "Cóż, to niespodziewane! O co chodzi?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_LALAFELL_FEMALE_TYPE5", "hash": "2F5E335CA2862111", "target": "Czego znowu?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_LALAFELL_FEMALE_TYPE6", "hash": "970A04EB398CB378", "target": "Oto jaaaaa!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_MIQOTE_MALE_TYPE1", "hash": "5E1F967DF05D820C", "target": "Czym mogę służyć, <if(gnum4,prrroszę pani,prrroszę pana)>?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_MIQOTE_MALE_TYPE2", "hash": "B14A234DB7837713", "target": "Tam trwa wojna, <if(gnum4,proszę pani,proszę pana)>. Nawet sobie <if(gnum4,pani,pan)> nie wyobraża." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_MIQOTE_MALE_TYPE3", "hash": "5905787E93C032F7", "target": "..." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_MIQOTE_MALE_TYPE4", "hash": "3F43AD9F909D6289", "target": "Służbowo czy dla przyjemności?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_MIQOTE_MALE_TYPE5", "hash": "B3674C9612925B93", "target": "Zakładam, że to wezwanie nie służy wyłącznie przyjemności mojego towarzystwa." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_MIQOTE_MALE_TYPE6", "hash": "F547E9C270766A63", "target": "O, <if(gnum4,piękna panno,przystojny młodzieńcze)>! Właśnie ciebie wypatruję! Powiedz, czego pragnie twoje serce." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_MIQOTE_FEMALE_TYPE1", "hash": "CD2FB037367201E6", "target": "Mam nadzieję, że ten gwizd nie wyraża dezaprobaty." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_MIQOTE_FEMALE_TYPE2", "hash": "0F20EAB84B905EEE", "target": "Było wezwanie, <if(gnum4,moja pani,mój panie)>?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_MIQOTE_FEMALE_TYPE3", "hash": "9BF08255180A7428", "target": "Kocim uszom niewiele umyka―a już na pewno nie wezwanie." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_MIQOTE_FEMALE_TYPE4", "hash": "BCFBAF5F1F836346", "target": "Ciekawość przywołała kota. Co dziś dla mnie masz?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_MIQOTE_FEMALE_TYPE5", "hash": "20D400D64318A1E8", "target": "Możemy zaczynać, kiedy tylko chcesz." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_MIQOTE_FEMALE_TYPE6", "hash": "AB7245A1A5361A50", "target": "Właśnie myślę o tobie!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ROEGADYN_MALE_TYPE1", "hash": "DC7509EFD4EE906B", "target": "W czym mogę dziś pomóc, <if(gnum4,proszę pani,proszę pana)>?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ROEGADYN_MALE_TYPE2", "hash": "0F74038BDDC1274B", "target": "Buahahaha! Jest robota do zrobienia? Wskaż tylko właściwy, cholerny kierunek." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ROEGADYN_MALE_TYPE3", "hash": "EA201EF608AEFADC", "target": "Jestem. O co chodzi?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ROEGADYN_MALE_TYPE4", "hash": "2CA66C9D8A3A5E8B", "target": "Hej─hik─<if(gnum4,panienko,kumplu)>! Może kufelek razem?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ROEGADYN_MALE_TYPE5", "hash": "86D3758D6307C489", "target": "Nie dało się szybciej przybyć. Gdzie ta robota?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ROEGADYN_MALE_TYPE6", "hash": "6B02C3F1AF4A2B25", "target": "Na dźwięk dzwonka od razu pędem ruszam! Czegoś trzeba, <if(gnum4,szefowo,szefie)>?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ROEGADYN_FEMALE_TYPE1", "hash": "4CC428F6640E9C71", "target": "Do <if(gnum4,pani,pana)> dyspozycji." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ROEGADYN_FEMALE_TYPE2", "hash": "3A635206D530D151", "target": "Masz coś dla mnie, <if(gnum4,pani kapitan,panie kapitanie)>?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ROEGADYN_FEMALE_TYPE3", "hash": "514CB62E02D15C66", "target": "Proszę mówić, <if(gnum4,proszę pani,proszę pana)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ROEGADYN_FEMALE_TYPE4", "hash": "750F501436084153", "target": "Załatwmy to krótko i zwięźle, dobrze?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ROEGADYN_FEMALE_TYPE5", "hash": "9EEC19972F7A1AB8", "target": "Nie byłoby to konieczne, gdyby twoje sprawy finansowe spoczywały w moich rękach." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ROEGADYN_FEMALE_TYPE6", "hash": "0923F1B49CF66C2E", "target": "Więc─sprzedajemy, kupujemy, pijemy, łajdaczymy się? Co dziś wybierasz?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_AURA_MALE_TYPE1", "hash": "69E2C419843E145B", "target": "Pozdrowienia, <if(gnum4,proszę pani,proszę pana)>. Czym mogę służyć?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_AURA_MALE_TYPE2", "hash": "AFC46CAC3F1B77CF", "target": "Co to będzie, <if(gnum4,panienko,kumplu)>?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_AURA_MALE_TYPE3", "hash": "BEF93F1846E7D792", "target": "Podaj cel wizyty." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_AURA_MALE_TYPE4", "hash": "6F6244639104247D", "target": "Jak ci mija ten cudowny <if([gnum11<12],<if([gnum11<4],wieczór,dzień)>,<if([gnum11<17],dzień,wieczór)>)>?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_AURA_MALE_TYPE5", "hash": "CE3347D641BAB9FD", "target": "No... Jestem... <if(gnum4,pani,panie)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_AURA_MALE_TYPE6", "hash": "8BC9D106BD0609B5", "target": "Obsługujemy stragany,♪<br>A mundury piękne mamy;♪<br>Trzeźwi z nas, uczciwi ludzie,♪<br>Każdy pilny w swoim trudzie!♪" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_AURA_FEMALE_TYPE1", "hash": "1A4D886EA936445D", "target": "<if(gnum4,Moja pani,Mój panie)>. Czego sobie <if(gnum4,pani,pan)> życzy?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_AURA_FEMALE_TYPE2", "hash": "415B5CF8E4F87007", "target": "No to co, zaczynamy?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_AURA_FEMALE_TYPE3", "hash": "EC8C44309097A931", "target": "Tak?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_AURA_FEMALE_TYPE4", "hash": "60E22049088269DE", "target": "Hej, to... to ty! Znowu witaj, ty!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_AURA_FEMALE_TYPE5", "hash": "8498C894B22C4603", "target": "T-to wcale nie tak, że chcę sprzedawać twoje przedmioty czy coś." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_AURA_FEMALE_TYPE6", "hash": "44E20E73EDEB780E", "target": "Co <if(gnum4,pani,pan)> dla mnie ma? Proszę, proszę! Bez nieśmiałości!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HROTHGAR_MALE_TYPE1", "hash": "8A083E1A6FD76849", "target": "Było wezwanie, <if(gnum4,moja pani,mój panie)>?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HROTHGAR_MALE_TYPE2", "hash": "2E65686EF7AC1A78", "target": "Mam nadzieję, że to będzie warte mojego czasu." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HROTHGAR_MALE_TYPE3", "hash": "59E897BE3EA9B59A", "target": "<italic(1)>Co<italic(0)>?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HROTHGAR_MALE_TYPE4", "hash": "2487E7ACF5239240", "target": "Czegokolwiek potrzebujesz, zostaw to mnie! Mam swoje metody." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HROTHGAR_MALE_TYPE5", "hash": "938D05EC6A512509", "target": "Gahaha! Czyż to nie <if(gnum4,moja ulubiona pani,mój ulubiony pan)>!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HROTHGAR_MALE_TYPE6", "hash": "7C84CB32D00AEABD", "target": "To ja, najwierniejsza i najzdolniejsza osoba wśród twoich retainerów!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_VIERA_FEMALE_TYPE1", "hash": "7425F30367D9CFDF", "target": "Co to będzie, kochanie?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_VIERA_FEMALE_TYPE2", "hash": "3695A28EF246A58C", "target": "Rozkazy! Chcę je usłyszeć natychmiast!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_VIERA_FEMALE_TYPE3", "hash": "190B34BAEFE15AC7", "target": "Jeśli masz do mnie jakąś prośbę, to ją wyraź." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_VIERA_FEMALE_TYPE4", "hash": "20CC450A51D26342", "target": "Tak...? Czy czegoś─\\<ziewnięcie>─potrzebujesz?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_VIERA_FEMALE_TYPE5", "hash": "FA8EE46ECAD554D5", "target": "Zadanie dla mnie? Oby było zabawne!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_VIERA_FEMALE_TYPE6", "hash": "D4537748FEA28406", "target": "Jestem, by spełniać każde <if(gnum4,pani,pana)> polecenie! Proszę tylko zażądać czegokolwiek!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_VIERA_MALE_TYPE1", "hash": "3B4F2478F64B414D", "target": "Czekam na to wezwanie, <if(gnum4,proszę pani,proszę pana)>. Czego sobie <if(gnum4,pani,pan)> życzy w ten piękny <if([gnum11<12],<if([gnum11<4],wieczór,poranek)>,<if([gnum11<17],dzień,wieczór)>)>?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_VIERA_MALE_TYPE2", "hash": "5F56E6E9F8174AE6", "target": "Co mogę zrobić dla <if(gnum4,jaśnie pani,jaśnie pana)>?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_VIERA_MALE_TYPE3", "hash": "AE1FBFC5AE9B7F14", "target": "Czy wzywa mnie <if(gnum4,pani,pan)>...?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_VIERA_MALE_TYPE4", "hash": "C6300B9819E9144C", "target": "To twoje─hik─wezwanie?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_VIERA_MALE_TYPE5", "hash": "88BD26F9FFF475AF", "target": "Potrzebujesz mojej pomocy, tak? Załatwmy to szybko." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_VIERA_MALE_TYPE6", "hash": "81A814A7B1D7A52D", "target": "Zamieniam się w słuch, <if(gnum4,moja pani,mój panie)>. W oba uszy, ściślej mówiąc!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HROTHGAR_FEMALE_TYPE1", "hash": "BEABDBFBE0D456A5", "target": "Czy wzywa mnie <if(gnum4,pani,pan)>?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HROTHGAR_FEMALE_TYPE2", "hash": "497DF99CF329948B", "target": "Na każde twoje skinienie!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HROTHGAR_FEMALE_TYPE3", "hash": "F5AB8C10D40B23CA", "target": "Wzywasz, więc jestem." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HROTHGAR_FEMALE_TYPE4", "hash": "EDAB70F474EDE4DC", "target": "Nareszcie─już myślałam, że <italic(1)>nigdy<italic(0)> mnie nie wezwiesz. Czego potrzebuje <if(gnum4,moja pani,mój pan)>?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HROTHGAR_FEMALE_TYPE5", "hash": "B8811F3FDA5013F0", "target": "Czyżby...? Słynna postać, <split(<string(gstr1)>, ,1)>, wzywa właśnie <italic(1)>mnie<italic(0)>? \\<chichot>" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HROTHGAR_FEMALE_TYPE6", "hash": "0FEF2A4C857E019F", "target": "Tak, tak, jestem! Na każde zawołanie!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HYURAN_MALE_TYPE1", "hash": "88D463EC8F658FA7", "target": "Jeśli to wszystko, już się oddalę, <if(gnum4,pani,panie)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HYURAN_MALE_TYPE2", "hash": "849D81FC7DAD90B3", "target": "Trzymaj się, słyszysz?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HYURAN_MALE_TYPE3", "hash": "E1099B5E7A356733", "target": "Do następnego spotkania." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HYURAN_MALE_TYPE4", "hash": "3FB6CD3E06EC78BE", "target": "No, najwyższy czas. Do widzenia." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HYURAN_MALE_TYPE5", "hash": "F24FB14000CF01A7", "target": "Chyba należą się podziękowania." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HYURAN_MALE_TYPE6", "hash": "4A02FE143E4553C2", "target": "To lecę!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HYURAN_FEMALE_TYPE1", "hash": "A1D16E93FE280EE5", "target": "Za pozwoleniem, <if(gnum4,moja pani,mój panie)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HYURAN_FEMALE_TYPE2", "hash": "EA2E1ABB7A29A1F0", "target": "O nic się nie martw. Zajmę się tym." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HYURAN_FEMALE_TYPE3", "hash": "893A335E51F1497D", "target": "Zatem żegnaj." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HYURAN_FEMALE_TYPE4", "hash": "0C503B4EBE46A5BC", "target": "Jeśli nie ma nic więcej, <if(gnum4,proszę pani,proszę pana)>, to już pójdę." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HYURAN_FEMALE_TYPE5", "hash": "0372772E633E82A8", "target": "To wszystko? Dobrze, do następnego razu." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HYURAN_FEMALE_TYPE6", "hash": "C4E9F6F39D7CAC42", "target": "Och, to wszystko na dziś? Dobrze, ale proszę obiecać, że niedługo <if(gnum4,pani,pan)> wróci!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ELEZEN_MALE_TYPE1", "hash": "6ECC28A5A20CFF53", "target": "Jak zawsze, <if(gnum4,proszę pani,proszę pana)>, to był zaszczyt i przywilej." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ELEZEN_MALE_TYPE2", "hash": "334707F26ED0F881", "target": "Możesz na mnie liczyć, <if(gnum4,szefowo,szefie)>─wiem, jak załatwiać sprawy." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ELEZEN_MALE_TYPE3", "hash": "3A5B427C8D71EADF", "target": "Proszę się czasem odezwać." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ELEZEN_MALE_TYPE4", "hash": "AB2D78180890554D", "target": "Przysięgam, że będzie zrobione. Kiedyś." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ELEZEN_MALE_TYPE5", "hash": "6E233E5428D80033", "target": "Zgodnie z życzeniem." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ELEZEN_MALE_TYPE6", "hash": "6FFEB5415F61E4EF", "target": "Znakomicie! Niezwłocznie wykonam te rozkazy." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ELEZEN_FEMALE_TYPE1", "hash": "60FFCA2960EDF641", "target": "Pokornie czekam na kolejne wezwanie, <if(gnum4,moja pani,mój panie)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ELEZEN_FEMALE_TYPE2", "hash": "EE70BF1D65137631", "target": "Nie zostawiaj mnie zbyt długo w samotności, słyszysz?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ELEZEN_FEMALE_TYPE3", "hash": "AFF49D7A5FFE694F", "target": "Zawsze z przyjemnością." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ELEZEN_FEMALE_TYPE4", "hash": "E9A09D8DFF23EC4A", "target": "To już wszystko, tak? Zatem za pozwoleniem..." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ELEZEN_FEMALE_TYPE5", "hash": "F255DE42810E1852", "target": "Myślę, że na razie to koniec naszych interesów." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ELEZEN_FEMALE_TYPE6", "hash": "6D8EE315750B9273", "target": "Na pewno nie ma <if(gnum4,pani,pan)> innych życzeń? Żadnych? Dobrze, oddalę się zatem." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_LALAFELL_MALE_TYPE1", "hash": "01A81DD41FBC9E36", "target": "Każda zachcianka zostanie spełniona szybko i z należytą starannością." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_LALAFELL_MALE_TYPE2", "hash": "5BF7B95AC3847613", "target": "To nie powinno potrwać dłużej niż chwilę, <if(gnum4,moja pani,mój panie)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_LALAFELL_MALE_TYPE3", "hash": "E09DE56E4D72C33C", "target": "To już pójdę." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_LALAFELL_MALE_TYPE4", "hash": "B208AF9A6ADB7064", "target": "Dzięki bogom, że skończone. Mam zamiar wsadzić ręce tam, gdzie wzrok jeszcze nie sięgnął... jeśli wiesz, co mam na myśli." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_LALAFELL_MALE_TYPE5", "hash": "6A30C711FF4F87AC", "target": "Trzymaj się dobrze." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_LALAFELL_MALE_TYPE6", "hash": "0092D04A83F9E6C9", "target": "Już idę, już idę!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_LALAFELL_FEMALE_TYPE1", "hash": "DF69E40794DFE5FF", "target": "Do następnego spotkania!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_LALAFELL_FEMALE_TYPE2", "hash": "99CFC19E40715296", "target": "Niech Dwunastu ci błogosławi." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_LALAFELL_FEMALE_TYPE3", "hash": "9CD78DADB67CBFFF", "target": "Niech Nald'thal raczy napełnić nasze kieszenie!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_LALAFELL_FEMALE_TYPE4", "hash": "9EAB87FFF6DE0A5C", "target": "Bardzo dobrze, <if(gnum4,proszę pani,proszę pana)>! Każde życzenie jest dla mnie rozkazem i tak dalej." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_LALAFELL_FEMALE_TYPE5", "hash": "7018FB750ECE9AC9", "target": "Wiesz, jak się ze mną skontaktować." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_LALAFELL_FEMALE_TYPE6", "hash": "6C57F9571D77D01A", "target": "Już pora się żegnać? Będzie mi ciebie brakowało..." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_MIQOTE_MALE_TYPE1", "hash": "69A1455EE27222E0", "target": "Niech się stanie <if(gnum4,pani,pana)> wola." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_MIQOTE_MALE_TYPE2", "hash": "667F50DAFC05A4DB", "target": "Targowiska może i są cholernym polem bitwy, ale ja umiem wojować, do diabła. Może <if(gnum4,pani,pan)> na mnie liczyć." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_MIQOTE_MALE_TYPE3", "hash": "38CCA131983915D1", "target": "..." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_MIQOTE_MALE_TYPE4", "hash": "804330C723245237", "target": "Czemu tak serrrio? \\<westchnienie> Tak to już bywa." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_MIQOTE_MALE_TYPE5", "hash": "B59127539CDD2BFD", "target": "Nie sądzę, żeby to wymagało mojej osobistej obecności, ale co się stało, to się nie odstanie." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_MIQOTE_MALE_TYPE6", "hash": "D32B63CEF4C6D9BB", "target": "Zatem wszystkie twoje potrzeby zostały zaspokojone? Świetnie! Naprawdę lubię obsługiwać klientów." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_MIQOTE_FEMALE_TYPE1", "hash": "22414922F1935BF1", "target": "Na razie do widzenia, <if(gnum4,proszę pani,prrroszę pana)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_MIQOTE_FEMALE_TYPE2", "hash": "108B6F2259B60130", "target": "No dobrze, bierzmy się do tego!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_MIQOTE_FEMALE_TYPE3", "hash": "52DE8CE9A6D8E20F", "target": "Nie ma powodów do trrroski." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_MIQOTE_FEMALE_TYPE4", "hash": "290EF929E78637B8", "target": "Gdy <if(gnum4,pani,pan)> wyjeżdża, kot harcuje." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_MIQOTE_FEMALE_TYPE5", "hash": "FA8C7C6065ED53D2", "target": "Bogowie, ale to męczy..." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_MIQOTE_FEMALE_TYPE6", "hash": "DE8DA50F9F8D2F27", "target": "Już nie chcesz być ze mną? \\<pociągnięcie nosem>" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ROEGADYN_MALE_TYPE1", "hash": "418E2CED424D412C", "target": "Wykonam te życzenia zgodnie z poleceniem, <if(gnum4,proszę pani,proszę pana)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ROEGADYN_MALE_TYPE2", "hash": "A7F32FBEAEAE1CD7", "target": "Buahahaha! Na twoim bazarze sprzedaję twoje towary!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ROEGADYN_MALE_TYPE3", "hash": "596A086169C8620D", "target": "Teraz już pójdę." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ROEGADYN_MALE_TYPE4", "hash": "1FE03AB6FA4EF373", "target": "Ach, do licha. Chyba lepiej zabrać się do roboty..." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ROEGADYN_MALE_TYPE5", "hash": "5CA5DCD20541D622", "target": "Nie lubię pożegnań." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ROEGADYN_MALE_TYPE6", "hash": "18485E817E9798B3", "target": "Idź się zdrzemnąć, <if(gnum4,szefowo,szefie)>. Fatalnie wyglądasz!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ROEGADYN_FEMALE_TYPE1", "hash": "D50869DEEA72EAFE", "target": "To wszystko na dziś, <if(gnum4,moja pani,mój panie)>? Rozumiem." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ROEGADYN_FEMALE_TYPE2", "hash": "2726DC3430FFBA96", "target": "Tak jest, <if(gnum4,pani kapitan,panie kapitanie)>!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ROEGADYN_FEMALE_TYPE3", "hash": "6EBDC0D3C0F81F8E", "target": "Przyjęto do wiadomości." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ROEGADYN_FEMALE_TYPE4", "hash": "54DBADDD740606F3", "target": "Nie tak miał wyglądać mój dzień, ale chyba nic nie poradzę." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ROEGADYN_FEMALE_TYPE5", "hash": "7240C430DA6E781B", "target": "Nie nam pytać dlaczego. Nam czynić i umierać." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ROEGADYN_FEMALE_TYPE6", "hash": "6684A74D00421F25", "target": "Jak widzę, pełen profesjonalizm jak zawsze. Zatem do następnego razu." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_AURA_MALE_TYPE1", "hash": "C90E7BD661A1A30E", "target": "Jeśli to wszystko, już się oddalę." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_AURA_MALE_TYPE2", "hash": "4339ABC23A6F44A2", "target": "To wszystko? Chyba już pójdę." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_AURA_MALE_TYPE3", "hash": "1D1B916C6F3A51FB", "target": "Jakieś ostatnie życzenia? Dobrze. He he he... Ekhm." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_AURA_MALE_TYPE4", "hash": "743EEE2C92662B7E", "target": "Ach, tak, oczywiście. Obowiązki wzywają!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_AURA_MALE_TYPE5", "hash": "BBAE10CEC574F875", "target": "To już koniec naszych spraw?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_AURA_MALE_TYPE6", "hash": "8D85563251905149", "target": "Dziś tu, jutro nie ma mnie;♪<br>Tak, ja wiem─♪<br>Tak już jest!♪" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_AURA_FEMALE_TYPE1", "hash": "242AEA23EBED69FE", "target": "Gdy znów przyda się moja pomoc, wystarczy zadzwonić." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_AURA_FEMALE_TYPE2", "hash": "B561EBF9455B518A", "target": "Jak zawsze z przyjemnością, <if(gnum4,pani,panie)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_AURA_FEMALE_TYPE3", "hash": "20204685B662AD42", "target": "No dobrze." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_AURA_FEMALE_TYPE4", "hash": "74CDBCCD81DB5BCD", "target": "Już koniec? No to chyba tyle." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_AURA_FEMALE_TYPE5", "hash": "B2F10572DA703959", "target": "Już odchodzisz? To dobrze! W-wcale mi nie zależy na twojej obecności czy coś." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_AURA_FEMALE_TYPE6", "hash": "190A5792CC613B94", "target": "Bardzo dobrze, <if(gnum4,proszę pani,proszę pana)>! Doprawdy bardzo dobrze!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HROTHGAR_MALE_TYPE1", "hash": "0CDF98D15F0140D2", "target": "Służyć to zawsze przyjemność, <if(gnum4,moja pani,mój panie)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HROTHGAR_MALE_TYPE2", "hash": "6CF858424E547F48", "target": "Hmpf. Mam nadzieję, że następnym razem dostanę od ciebie sensowniejsze zadanie." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HROTHGAR_MALE_TYPE3", "hash": "1B098026D0C1AF7C", "target": "<italic(1)>Do widzenia<italic(0)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HROTHGAR_MALE_TYPE4", "hash": "8CA330509327D281", "target": "To już lecę. Miejsca czekają, ludzie też." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HROTHGAR_MALE_TYPE5", "hash": "BFA406B47E85CE14", "target": "Bahahaha! Do następnego razu, <if(gnum4,przyjaciółko,przyjacielu)>!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HROTHGAR_MALE_TYPE6", "hash": "7CFECEDB1D62B750", "target": "Dzwoń, kiedy tylko chcesz! Wiesz, że nigdy cię nie zawiodę!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_VIERA_FEMALE_TYPE1", "hash": "AEEE2C0A3BEA4681", "target": "Czy musimy tak szybko się rozstawać?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_VIERA_FEMALE_TYPE2", "hash": "7D84B777BCB5A896", "target": "To lecę!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_VIERA_FEMALE_TYPE3", "hash": "4580EE2773C12030", "target": "Wzywaj mnie, kiedy zechcesz. Jeśli będę mieć ochotę, odpowiem." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_VIERA_FEMALE_TYPE4", "hash": "52EC9A9CA2925BA2", "target": "To chyba wszystko...? \\<ziewnięcie> No dobrze..." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_VIERA_FEMALE_TYPE5", "hash": "CF979F188FA5FD94", "target": "To wszystko? Och, liczę na coś więcej..." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_VIERA_FEMALE_TYPE6", "hash": "9DFB282B9E8A396B", "target": "To wszystko, czego <if(gnum4,pani,pan)> ode mnie potrzebuje? Ale mogę się przydać jeszcze na tyle sposobów!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_VIERA_MALE_TYPE1", "hash": "8D41CD2616D593CA", "target": "Proszę śmiało wzywać mnie ponownie. Powodzenia w <if(gnum4,pani,pana)> przedsięwzięciach." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_VIERA_MALE_TYPE2", "hash": "8EE855ACB28966EB", "target": "Wystarczy słowo, <if(gnum4,jaśnie pani,jaśnie panie)>, a od razu się zjawię, w pełnej gotowości." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_VIERA_MALE_TYPE3", "hash": "323C3622A19961A8", "target": "Jeśli nie ma dalszej potrzeby moich usług..." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_VIERA_MALE_TYPE4", "hash": "4296B8FB1223B597", "target": "To idę na kolejny kieliszek. Wiesz, gdzie mnie znaleźć!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_VIERA_MALE_TYPE5", "hash": "59D5A545495AEFA2", "target": "Co─to wszystko? Czy <italic(1)>na pewno<italic(0)> potrzebujesz retainera?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_VIERA_MALE_TYPE6", "hash": "E2EC97966E1A318B", "target": "Nic więcej? No dobrze... To odskaczę sobie dalej." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HROTHGAR_FEMALE_TYPE1", "hash": "F8740AD6E1165066", "target": "Cieszę się, że moja pomoc się przydała. Tylko proszę się nie przemęczać." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HROTHGAR_FEMALE_TYPE2", "hash": "421BFCBABFED884B", "target": "Masz mnie już dość, co? Niech będzie! Daj znać, gdyby trzeba było czegoś jeszcze!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HROTHGAR_FEMALE_TYPE3", "hash": "39312F369BCC7E1C", "target": "Koniec? To już się oddalę." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HROTHGAR_FEMALE_TYPE4", "hash": "1089923CA3E0BAAA", "target": "<if(gnum4,Moja pani,Mój pan)> niczego już nie potrzebuje? To będę ostrzyć pazury w oczekiwaniu na kolejne wezwanie." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HROTHGAR_FEMALE_TYPE5", "hash": "DE833458A602DCB5", "target": "Nic więcej? Dobrze... To już pójdę!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HROTHGAR_FEMALE_TYPE6", "hash": "2A697BAEF75219E1", "target": "Masz wszystko, czego potrzebujesz? To się trochę zdrzemnę." }
  ]
}
