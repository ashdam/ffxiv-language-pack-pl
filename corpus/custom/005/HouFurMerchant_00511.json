  "entries": [
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_CALL_RETAINER_FAILED", "hash": "7C458AA95A9C473D", "target": "Twój retainer nie odpowiada." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_CALL_FAILED_NO_CHARGE", "hash": "305D020EE3225631", "target": "Retainer zarządzający tym manekinem został zwolniony ze służby. Aby uzyskać dostęp do manekina, ustaw go ponownie i przypisz nowego retainera." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_CHANGE_STATUS_DISABLE", "hash": "29B9C76EC70D05B1", "target": "Musisz zdjąć z manekina całe wyposażenie, zanim zmienisz jego ustawienia." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_SELL_DISABLE", "hash": "6BBEF5716C93B2CE", "target": "Musisz zdjąć z manekina całe wyposażenie, zanim wystawisz przedmioty na sprzedaż." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_DISPLAY_DISABLE", "hash": "5ED66C336C92C14C", "target": "Musisz zdjąć z manekina całe wyposażenie, zanim wystawisz przedmioty na pokaz." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_Q1_000_001", "hash": "87A86463B2FF8F9C", "target": "Wybierz opcję." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_A1_000_001", "hash": "5657118D5B3730F8", "target": "Wybrać wyposażenie do sprzedaży." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_A1_000_008", "hash": "E07A3044DB37C074", "target": "Wybrać wyposażenie do wystawienia na pokaz." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_A1_000_002", "hash": "5D24349684329F1B", "target": "Zobaczyć historię sprzedaży." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_A1_000_004", "hash": "9875AE364059507C", "target": "Ustawić klasę manekina. (Obecne ustawienie: <headall(<sheet(ClassJob,lnum1,0)>)>)" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_A1_000_005", "hash": "DC896E49B4FA254C", "target": "Wybrać rasę i płeć. (Obecne ustawienie: <sheet(Race,lnum1,0)>, płeć <if([lnum2==0],męska,żeńska)>)" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_A1_000_006", "hash": "674F3738AFC5E5C6", "target": "Wybrać pozę. (Obecne ustawienie: <sheet(HousingMerchantPose,lnum1,1)>)" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_A1_000_007", "hash": "709BCFF845E5FFF3", "target": "Zakończyć." },
