    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_A2_000_001", "hash": "5430BFFA1D169F86", "target": "Obrońca." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_A2_000_002", "hash": "30033B99EBF572BC", "target": "Uzdrowiciel." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_A2_000_003", "hash": "2C01C5F097525E60", "target": "DPS." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_A2_000_004", "hash": "1E7D8C8557C3CCFB", "target": "Uczeń Rzemiosła." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_A2_000_005", "hash": "E6F760DEE73A062A", "target": "Uczeń Ziemi." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_A2_000_006", "hash": "33AFE555886201C7", "target": "Zakończyć." },
