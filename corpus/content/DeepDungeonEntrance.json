    { "gameKey": "content/DeepDungeonEntrance#TEXT_DEEPDUNGEONENTRANCE_WOODWAILERCAPTAIN01556_000_000", "hash": "D014ACE05AE92DA2", "target": "Ujawniło się wielkie zagrożenie dla spokoju Czarnego Całunu. Wysłano mnie, by pomóc je przepędzić. Poszukiwacz przygód czy nie, nie pozwolę nikomu przeszkadzać w mojej pracy. A teraz proszę odejść." },
    { "gameKey": "content/DeepDungeonEntrance#TEXT_DEEPDUNGEONENTRANCE_WOODWAILERCAPTAIN01556_000_020", "hash": "94081C319CE22A63", "target": "Mieliśmy szczęście, że kustosz tego przeklętego miejsca był na tyle niedbały, by zostawić zapiski tam, gdzie mogliśmy je znaleźć. Może teraz odkryjemy jego prawdziwe motywy." },
    { "gameKey": "content/DeepDungeonEntrance#TEXT_DEEPDUNGEONENTRANCE_TEST_START_MENU_ENTER", "hash": "0E9F6E2B592A8D03", "target": "Wejdź do Palace of the Dead" },
