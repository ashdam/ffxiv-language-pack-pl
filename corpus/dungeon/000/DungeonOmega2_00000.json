    { "gameKey": "dungeon/000/DungeonOmega2_00000#TEXT_DUNGEONOMEGA2_00000_OMEGA_000_003", "hash": "6659F672BF19E0B9", "target": "\\<bip> Przyjąłem. Akceptuję twoją propozycję." },
    { "gameKey": "dungeon/000/DungeonOmega2_00000#TEXT_DUNGEONOMEGA2_00000_OMEGA_000_004", "hash": "B1685F17AB7A45EF", "target": "Doceniam wasz wkład w mój eksperyment. Bez waszej nieugiętej siły nigdy nie odkryłbym tego nowego potencjału." },
