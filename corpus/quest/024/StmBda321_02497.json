{
  "conversation": "quest/024/StmBda321_02497",
  "gameVersion": "2026.11.03.0000.0000",
  "entries": [
    { "gameKey": "quest/024/StmBda321_02497#TEXT_STMBDA321_02497_SEQ_00", "hash": "BD55058653C076B5", "target": "Yugiri zamilkła, pogrążona w myślach." },
    { "gameKey": "quest/024/StmBda321_02497#TEXT_STMBDA321_02497_TODO_00", "hash": "354C872C10D75291", "target": "Podnieść dekuriona Imperium" },
    { "gameKey": "quest/024/StmBda321_02497#TEXT_STMBDA321_02497_TODO_01", "hash": "382D43F3544BE07A", "target": "Zanieść dekuriona Imperium na miejsce docelowe" },
    { "gameKey": "quest/024/StmBda321_02497#TEXT_STMBDA321_02497_TODO_02", "hash": "5BCEFA1BDD4C0514", "target": "Podać dekurionowi Imperium lekarstwo Yugiri" },
    { "gameKey": "quest/024/StmBda321_02497#TEXT_STMBDA321_02497_TODO_03", "hash": "787DB1D2FF2B9E33", "target": "Podnieść żołnierza Imperium" },
    { "gameKey": "quest/024/StmBda321_02497#TEXT_STMBDA321_02497_TODO_04", "hash": "A70EA76F115F4017", "target": "Zanieść żołnierza Imperium na miejsce docelowe" },
    { "gameKey": "quest/024/StmBda321_02497#TEXT_STMBDA321_02497_TODO_05", "hash": "3D2BA964B8B05DC1", "target": "Podać żołnierzowi Imperium lekarstwo Yugiri" },
    { "gameKey": "quest/024/StmBda321_02497#TEXT_STMBDA321_02497_TODO_06", "hash": "034334E5A82FDF9A", "target": "Odnaleźć Yugiri" },
    { "gameKey": "quest/024/StmBda321_02497#TEXT_STMBDA321_02497_TODO_07", "hash": "E3A5117690BC08CA", "target": "Wrócić z Yugiri do House of the Fierce" },
    { "gameKey": "quest/024/StmBda321_02497#TEXT_STMBDA321_02497_SOLDIERC02495_000_000", "hash": "6C81DE0CDFAD7B95", "target": "..." },
    { "gameKey": "quest/024/StmBda321_02497#TEXT_STMBDA321_02497_SOLDIERD02496_000_005", "hash": "8CB3B21355879502", "target": "Jeszcze... jeszcze kilka lat... \\<chrapie>" },
    { "gameKey": "quest/024/StmBda321_02497#TEXT_STMBDA321_02497_YUGIRI_000_010", "hash": "0585C23C598F1190", "target": "..." },
    { "gameKey": "quest/024/StmBda321_02497#TEXT_STMBDA321_02497_YUGIRI_000_011", "hash": "C1D9C565CCC02AAC", "target": "Proszę wybaczyć, <split(<string(gstr1)>, ,1)>. Pogrążyłam się... w myślach." },
    { "gameKey": "quest/024/StmBda321_02497#TEXT_STMBDA321_02497_YUGIRI_000_012", "hash": "04DAAEC69A5B5A05", "target": "Może mają rację. Może źle robimy, namawiając ich, żeby znów chwycili za broń. A jednak wierzę─<italic(1)>muszę<italic(0)> wierzyć─że gdzieś w głębi serca wciąż... wciąż..." },
    { "gameKey": "quest/024/StmBda321_02497#TEXT_STMBDA321_02497_YUGIRI_000_013", "hash": "FEAA2F527923383C", "target": "...Nie czas na to. Musimy dokończyć to, co zaczęliśmy." },
    { "gameKey": "quest/024/StmBda321_02497#TEXT_STMBDA321_02497_YUGIRI_000_014", "hash": "82061C235F0ECEF4", "target": "Mam silny środek, który mąci myśli i zaciera wspomnienia. Trzeba go podać żołnierzom, zanim się obudzą." },
    { "gameKey": "quest/024/StmBda321_02497#TEXT_STMBDA321_02497_YUGIRI_000_015", "hash": "4F6110F5F1C6335D", "target": "Po przebudzeniu będą zdezorientowani i nie przypomną sobie dobrze ostatnich wydarzeń. Uznają, że przysnęli na warcie, a do tego nie będą się chcieli nikomu przyznać." },
    { "gameKey": "quest/024/StmBda321_02497#TEXT_STMBDA321_02497_YUGIRI_000_016", "hash": "9D067FE2611F8112", "target": "To da nam trochę czasu. Nie możemy ich zabić, bo ucierpieliby mieszkańcy. Proszę zająć się tymi dwoma, których przed chwilą uśpiłam─ja zajmę się resztą." },
    { "gameKey": "quest/024/StmBda321_02497#TEXT_STMBDA321_02497_SOLDIERC02495_000_020", "hash": "C897CC5AF618E348", "target": "\\<chrapie> ...<if(gnum4,Mamo,Tato)>? To ty...?" },
    { "gameKey": "quest/024/StmBda321_02497#TEXT_STMBDA321_02497_SOLDIERD02496_000_030", "hash": "3B6D251E40178DBB", "target": "Chcę... chcę do domu... \\<chrapie>" },
    { "gameKey": "quest/024/StmBda321_02497#TEXT_STMBDA321_02497_YUGIRI_000_040", "hash": "7A03CA8D509B2DF5", "target": "Szybko, do środka! Trzeba powiedzieć reszcie o tym statku powietrznym. Może już coś o nim wiedzą!" }
  ]
}
