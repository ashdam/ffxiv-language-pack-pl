    { "gameKey": "quest/024/StmBda321_02497#TEXT_STMBDA321_02497_TODO_06", "hash": "034334E5A82FDF9A", "target": "Odnaleźć Yugiri" },
    { "gameKey": "quest/024/StmBda321_02497#TEXT_STMBDA321_02497_TODO_07", "hash": "E3A5117690BC08CA", "target": "Wrócić z Yugiri do House of the Fierce" },
    { "gameKey": "quest/024/StmBda321_02497#TEXT_STMBDA321_02497_SOLDIERC02495_000_000", "hash": "6C81DE0CDFAD7B95", "target": "..." },
    { "gameKey": "quest/024/StmBda321_02497#TEXT_STMBDA321_02497_SOLDIERD02496_000_005", "hash": "8CB3B21355879502", "target": "Jeszcze... jeszcze kilka lat... \\<chrapie>" },
    { "gameKey": "quest/024/StmBda321_02497#TEXT_STMBDA321_02497_YUGIRI_000_010", "hash": "0585C23C598F1190", "target": "..." },
    { "gameKey": "quest/024/StmBda321_02497#TEXT_STMBDA321_02497_YUGIRI_000_011", "hash": "C1D9C565CCC02AAC", "target": "Proszę wybaczyć, <split(<string(gstr1)>, ,1)>. Zamyśliłam się..." },
    { "gameKey": "quest/024/StmBda321_02497#TEXT_STMBDA321_02497_YUGIRI_000_012", "hash": "04DAAEC69A5B5A05", "target": "Może mają rację. Może niemądrze namawiać ich do kolejnego zrywu. A jednak wierzę, <italic(1)>muszę<italic(0)> wierzyć, że w głębi serca oni... oni wciąż..." },
    { "gameKey": "quest/024/StmBda321_02497#TEXT_STMBDA321_02497_YUGIRI_000_013", "hash": "FEAA2F527923383C", "target": "...Nie pora o tym myśleć. Musimy dokończyć rozpoczętą pracę." },
    { "gameKey": "quest/024/StmBda321_02497#TEXT_STMBDA321_02497_YUGIRI_000_014", "hash": "82061C235F0ECEF4", "target": "Mam przy sobie silny środek, który mąci myśli i wspomnienia. Musimy podać go żołnierzom, zanim się obudzą." },
    { "gameKey": "quest/024/StmBda321_02497#TEXT_STMBDA321_02497_YUGIRI_000_015", "hash": "4F6110F5F1C6335D", "target": "Lekarstwo zdezorientuje żołnierzy i zatrze im ostatnie wydarzenia w pamięci. Pomyślą, że zasnęli na służbie, i nie będą chcieli o tym rozmawiać." },
    { "gameKey": "quest/024/StmBda321_02497#TEXT_STMBDA321_02497_YUGIRI_000_016", "hash": "9D067FE2611F8112", "target": "To tylko środek tymczasowy, ale ze względu na mieszkańców nie możemy ich zabić. Proszę zająć się ostatnimi dwoma, których uśpiłam. Ja zajmę się resztą." },
    { "gameKey": "quest/024/StmBda321_02497#TEXT_STMBDA321_02497_SOLDIERC02495_000_020", "hash": "C897CC5AF618E348", "target": "\\<chrapie> ...<if(gnum4,Mamo,Tato)>, to ty...?" },
    { "gameKey": "quest/024/StmBda321_02497#TEXT_STMBDA321_02497_SOLDIERD02496_000_030", "hash": "3B6D251E40178DBB", "target": "Ja... chcę do domu... \\<chrapie>" },
    { "gameKey": "quest/024/StmBda321_02497#TEXT_STMBDA321_02497_YUGIRI_000_040", "hash": "7A03CA8D509B2DF5", "target": "Chodźmy szybko! Musimy opowiedzieć innym o sterowcu albo dowiedzieć się, co oni o nim wiedzą!" }
  ]
}
