{
  "conversation": "quest/034/LucKzf203_03484",
  "gameVersion": "2026.10.16.0000.0000",
  "entries": [
    { "gameKey": "quest/034/LucKzf203_03484#TEXT_LUCKZF203_03484_SEQ_00", "hash": "B15E403C967235C3", "target": "<colortype(508)><edgecolortype(509)>\uE0BE Synchronizacja zadania<edgecolortype(0)><colortype(0)><br>Taina przygląda ci się uważnie, coś rozważając." },
    { "gameKey": "quest/034/LucKzf203_03484#TEXT_LUCKZF203_03484_TODO_00", "hash": "29186F97898681C7", "target": "Porozmawiać z bystrooką łowczynią" },
    { "gameKey": "quest/034/LucKzf203_03484#TEXT_LUCKZF203_03484_TODO_01", "hash": "97778C5E6D1FC427", "target": "Pokonać wojowniczki Viis i zdobyć odznaki Fanowu" },
    { "gameKey": "quest/034/LucKzf203_03484#TEXT_LUCKZF203_03484_TODO_02", "hash": "8D65FA8D8CBB4A0E", "target": "Porozmawiać z Tainą" },
    { "gameKey": "quest/034/LucKzf203_03484#TEXT_LUCKZF203_03484_TAINA_000_000", "hash": "91E31DD6BA369C64", "target": "Znów zaszczycasz mnie swoją obecnością, i to w doskonałej chwili. Wioska aż brzęczy jak rój owadów od opowieści o twoich czynach." },
    { "gameKey": "quest/034/LucKzf203_03484#TEXT_LUCKZF203_03484_TAINA_000_001", "hash": "BB1352CB68103A0D", "target": "Kilka moich sióstr chciałoby osobiście sprawdzić twoją siłę. Przyjmiesz ich wyzwanie?" },
    { "gameKey": "quest/034/LucKzf203_03484#TEXT_LUCKZF203_03484_TAINA_000_002", "hash": "03321A4DCB40F63C", "target": "Doskonale. Czekają na ciebie w Spoczynku Łuku." },
    { "gameKey": "quest/034/LucKzf203_03484#TEXT_LUCKZF203_03484_TAINA_000_003", "hash": "FE0A69D540A0DFF3", "target": "Powodzenia w próbie." },
    { "gameKey": "quest/034/LucKzf203_03484#TEXT_LUCKZF203_03484_KEENEYEVIIS03484_000_010", "hash": "A21BDAEA7B5F0442", "target": "Wreszcie jesteś! Witaj, <if(gnum4,sojuszniczko,sojuszniku)> Ronki." },
    { "gameKey": "quest/034/LucKzf203_03484#TEXT_LUCKZF203_03484_KEENEYEVIIS03484_000_011", "hash": "51AF3CF973BA771E", "target": "W koronach drzew w pobliżu Fanowu ukryłyśmy trzy odznaki, które musisz znaleźć." },
    { "gameKey": "quest/034/LucKzf203_03484#TEXT_LUCKZF203_03484_KEENEYEVIIS03484_000_012", "hash": "5C0CED58A68F0273", "target": "Ostrzegam jednak, że strzegą ich nasze najzacieklejsze wojowniczki." },
    { "gameKey": "quest/034/LucKzf203_03484#TEXT_LUCKZF203_03484_KEENEYEVIIS03484_000_013", "hash": "CC2CF7CE111FC7D4", "target": "Jeśli je pokonasz i zdobędziesz odznaki, możesz odebrać nagrodę od Tainy. Powodzenia, <if(gnum4,sojuszniczko,sojuszniku)> Ronki. Niech towarzyszą ci błogosławieństwa lasu." },
    { "gameKey": "quest/034/LucKzf203_03484#TEXT_LUCKZF203_03484_KEENEYEVIIS03484_000_014", "hash": "49A49AF7D1DA6C37", "target": "Uważaj. Nasze łowczynie nie będą cię oszczędzać." },
    { "gameKey": "quest/034/LucKzf203_03484#TEXT_LUCKZF203_03484_BALLOON_000_000", "hash": "2A6298DBBD4A1566", "target": "Broń się!" },
    { "gameKey": "quest/034/LucKzf203_03484#TEXT_LUCKZF203_03484_BALLOON_000_010", "hash": "A2DE53A2CAAD15CD", "target": "Naprawdę masz wielką siłę." },
    { "gameKey": "quest/034/LucKzf203_03484#TEXT_LUCKZF203_03484_BALLOON_000_020", "hash": "F1E836932A288ACF", "target": "Masz!" },
    { "gameKey": "quest/034/LucKzf203_03484#TEXT_LUCKZF203_03484_BALLOON_000_030", "hash": "6CD2801CADAE46DF", "target": "Co za siła..." },
    { "gameKey": "quest/034/LucKzf203_03484#TEXT_LUCKZF203_03484_BALLOON_000_040", "hash": "E36747B034280515", "target": "Mam cię!" },
    { "gameKey": "quest/034/LucKzf203_03484#TEXT_LUCKZF203_03484_BALLOON_000_050", "hash": "187CC7CB60AEDCDF", "target": "Dobra walka..." },
    { "gameKey": "quest/034/LucKzf203_03484#TEXT_LUCKZF203_03484_BALLOON_000_060", "hash": "E886C1105E1AE15B", "target": "Jeszcze nie koniec!" },
    { "gameKey": "quest/034/LucKzf203_03484#TEXT_LUCKZF203_03484_BALLOON_000_070", "hash": "E301BC44BE0EBB4C", "target": "Chwalebna porażka." },
    { "gameKey": "quest/034/LucKzf203_03484#TEXT_LUCKZF203_03484_TAINA_000_020", "hash": "FC9E54CF4254085D", "target": "Nasze łowczynie wróciły porządnie poobijane, a jednak wydawały się całkiem zadowolone. Nie udało ci się ich pokonać?" },
    { "gameKey": "quest/034/LucKzf203_03484#TEXT_LUCKZF203_03484_TAINA_000_021", "hash": "69A3B3D4F46326B2", "target": "Ach, oczywiście! Bez wątpienia cieszy je porażka z rąk kogoś tak szanowanego." },
    { "gameKey": "quest/034/LucKzf203_03484#TEXT_LUCKZF203_03484_TAINA_000_022", "hash": "170B5D8F82ED5367", "target": "To dla nich wielki dar. Zapewne będą go cenić do końca swoich dni. Zgodnie z obietnicą, oto twoja nagroda." }
  ]
}
