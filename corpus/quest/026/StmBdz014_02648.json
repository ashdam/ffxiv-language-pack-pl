{
  "conversation": "quest/026/StmBdz014_02648",
  "gameVersion": "2026.11.03.0000.0000",
  "entries": [
    { "gameKey": "quest/026/StmBdz014_02648#TEXT_STMBDZ014_02648_SEQ_00", "hash": "348063527F7E4E9E", "target": "Ten sympatyczny mężczyzna najwyraźniej wpadł w panikę." },
    { "gameKey": "quest/026/StmBdz014_02648#TEXT_STMBDZ014_02648_TODO_00", "hash": "2178DFCC742EAF57", "target": "Zabić niedźwiedzia (giant grizzly), który zaatakował lekkomyślnego mężczyznę" },
    { "gameKey": "quest/026/StmBdz014_02648#TEXT_STMBDZ014_02648_TODO_01", "hash": "E1760B07F2D6690D", "target": "Uratować lekkomyślnego mężczyznę" },
    { "gameKey": "quest/026/StmBdz014_02648#TEXT_STMBDZ014_02648_TODO_02", "hash": "0823748C3E8DCE09", "target": "Wrócić do spanikowanego mężczyzny" },
    { "gameKey": "quest/026/StmBdz014_02648#TEXT_STMBDZ014_02648_PANICMAN02648_000_000", "hash": "89CF80EF149A5397", "target": "Hej, ty! Pomóż mojemu przyjacielowi, błagam! Rzucił się na niego niedźwiedź!" },
    { "gameKey": "quest/026/StmBdz014_02648#TEXT_STMBDZ014_02648_PANICMAN02648_000_001", "hash": "2DC913FCDDD2D054", "target": "Pobiegł na zachód. Tam go znajdziesz!" },
    { "gameKey": "quest/026/StmBdz014_02648#TEXT_STMBDZ014_02648_PANICMAN02648_000_003", "hash": "A4C5DC1047A3A758", "target": "Mój przyjaciel pobiegł na zachód. Błagam, pospiesz się!" },
    { "gameKey": "quest/026/StmBdz014_02648#TEXT_STMBDZ014_02648_PANICMAN02648_000_010", "hash": "283D5ED42F6AFFD0", "target": "Nic mu nie jest?" },
    { "gameKey": "quest/026/StmBdz014_02648#TEXT_STMBDZ014_02648_PINCHMAN02648_000_010", "hash": "3436158DC060F90B", "target": "O włos, a byłoby po mnie. Dzięki za ratunek." },
    { "gameKey": "quest/026/StmBdz014_02648#TEXT_STMBDZ014_02648_PINCHMAN02648_000_011", "hash": "B36865BECE5A2A9D", "target": "To on cię po mnie posłał? Wróć do niego, proszę, i powiedz, że nic mi nie jest. Muszę złapać oddech, zanim się stąd ruszę." },
    { "gameKey": "quest/026/StmBdz014_02648#TEXT_STMBDZ014_02648_PINCHMAN02648_000_020", "hash": "B75E03DB3A8B1044", "target": "Wracaj, proszę, do mojego przyjaciela i powiedz, że nic mi nie jest." },
    { "gameKey": "quest/026/StmBdz014_02648#TEXT_STMBDZ014_02648_PANICMAN02648_000_030", "hash": "13FD4FDCB723B07D", "target": "Cały i zdrowy? Uff, kamień z serca. Często musimy wychodzić za wieś szukać dzikich roślin, bo nie ma innego wyjścia." },
    { "gameKey": "quest/026/StmBdz014_02648#TEXT_STMBDZ014_02648_PANICMAN02648_000_031", "hash": "224E03134AD99F1E", "target": "Gdyby na tej cholernej ziemi dało się cokolwiek wyhodować, nie musielibyśmy tak ryzykować." },
    { "gameKey": "quest/026/StmBdz014_02648#TEXT_STMBDZ014_02648_PANICMAN02648_000_032", "hash": "B6F61745A9FE88E3", "target": "Teraz najważniejsze, że nic mu nie jest. Dziękuję." }
  ]
}
