{
  "conversation": "quest/026/StmBdz014_02648",
  "gameVersion": "2026.10.16.0000.0000",
  "entries": [
    { "gameKey": "quest/026/StmBdz014_02648#TEXT_STMBDZ014_02648_SEQ_00", "hash": "348063527F7E4E9E", "target": "Ten uroczy mężczyzna jest bardzo spanikowany." },
    { "gameKey": "quest/026/StmBdz014_02648#TEXT_STMBDZ014_02648_TODO_00", "hash": "2178DFCC742EAF57", "target": "Zabić niedźwiedzia atakującego lekkomyślnego mężczyznę" },
    { "gameKey": "quest/026/StmBdz014_02648#TEXT_STMBDZ014_02648_TODO_01", "hash": "E1760B07F2D6690D", "target": "Uratować lekkomyślnego mężczyznę" },
    { "gameKey": "quest/026/StmBdz014_02648#TEXT_STMBDZ014_02648_TODO_02", "hash": "0823748C3E8DCE09", "target": "Zdać sprawę spanikowanemu mężczyźnie" },
    { "gameKey": "quest/026/StmBdz014_02648#TEXT_STMBDZ014_02648_PANICMAN02648_000_000", "hash": "89CF80EF149A5397", "target": "Hej, ty! Proszę, pomóż mojemu przyjacielowi. Napadł go niedźwiedź!" },
    { "gameKey": "quest/026/StmBdz014_02648#TEXT_STMBDZ014_02648_PANICMAN02648_000_001", "hash": "2DC913FCDDD2D054", "target": "Znajdziesz go na zachód stąd." },
    { "gameKey": "quest/026/StmBdz014_02648#TEXT_STMBDZ014_02648_PANICMAN02648_000_003", "hash": "A4C5DC1047A3A758", "target": "Znajdziesz mojego przyjaciela na zachód stąd." },
    { "gameKey": "quest/026/StmBdz014_02648#TEXT_STMBDZ014_02648_PANICMAN02648_000_010", "hash": "283D5ED42F6AFFD0", "target": "Czy mój przyjaciel jest bezpieczny?" },
    { "gameKey": "quest/026/StmBdz014_02648#TEXT_STMBDZ014_02648_PINCHMAN02648_000_010", "hash": "3436158DC060F90B", "target": "Było trochę zbyt blisko śmierci jak na mój gust. Dzięki za ratunek." },
    { "gameKey": "quest/026/StmBdz014_02648#TEXT_STMBDZ014_02648_PINCHMAN02648_000_011", "hash": "B36865BECE5A2A9D", "target": "Mój przyjaciel poprosił cię o pomoc? Wrócisz do niego i powiesz, że jestem bezpieczny? Muszę najpierw złapać oddech, zanim gdziekolwiek ruszę." },
    { "gameKey": "quest/026/StmBdz014_02648#TEXT_STMBDZ014_02648_PINCHMAN02648_000_020", "hash": "B75E03DB3A8B1044", "target": "Proszę, wróć i powiedz mojemu przyjacielowi, że jestem bezpieczny." },
    { "gameKey": "quest/026/StmBdz014_02648#TEXT_STMBDZ014_02648_PANICMAN02648_000_030", "hash": "13FD4FDCB723B07D", "target": "Jest bezpieczny? Uff, kamień z serca. Często nie mamy wyboru i musimy wychodzić poza wioskę w poszukiwaniu dzikich roślin." },
    { "gameKey": "quest/026/StmBdz014_02648#TEXT_STMBDZ014_02648_PANICMAN02648_000_031", "hash": "224E03134AD99F1E", "target": "Gdyby tylko ta przeklęta ziemia, na której stoimy, była bardziej gościnna. Nigdy nie musielibyśmy tak ryzykować." },
    { "gameKey": "quest/026/StmBdz014_02648#TEXT_STMBDZ014_02648_PANICMAN02648_000_032", "hash": "B6F61745A9FE88E3", "target": "Tak czy inaczej, liczy się tylko to, że mój przyjaciel jest bezpieczny. Dziękuję." }
  ]
}
