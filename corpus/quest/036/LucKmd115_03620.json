{
  "conversation": "quest/036/LucKmd115_03620",
  "gameVersion": "2026.09.15.0000.0000",
  "entries": [
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_SEQ_00", "hash": "39666F40D926930C", "target": "W oczach Minfilii widać zarówno lęk, jak i determinację." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_TODO_00", "hash": "B5308555418FFFF8", "target": "Zbadać wskazane miejsce" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_TODO_01", "hash": "A5C84C567FE62429", "target": "Odszukać Minfilię" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_TODO_02", "hash": "838274F23593FE96", "target": "Odszukać Thancreda" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_000", "hash": "98FAB62BF47CF33F", "target": "Wyczuwam jej obecność, choć bardzo słabo." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_001", "hash": "14BB5ED3DC446C07", "target": "Chodź, poszukajmy przy kryształowej ścianie." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_010", "hash": "B043A9C82585C2F3", "target": "Była tutaj. Na szczycie tego budynku..." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_020", "hash": "01F8AFBF7774509E", "target": "\\<jęczy>" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_021", "hash": "1F98560B1F8E0DE8", "target": "Co się stało? Pamiętam, jak rozmawiałam z Minfilią... a potem..." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_022", "hash": "C4CB2D099EA55F50", "target": "Coś nie tak?" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_Q1_000_000", "hash": "A29250F2F5F49059", "target": "Co odpowiesz?" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_A1_000_001", "hash": "C1ED64E72EA447DA", "target": "Twoje włosy się zmieniły." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_A1_000_002", "hash": "8D0C20CBF9CB5461", "target": "Twoje oczy się zmieniły." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_023", "hash": "1EF3A43F9F893B03", "target": "Myślę, że to dar pożegnalny." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_024", "hash": "85C24CD3785579BD", "target": "Dotąd szłam drogą, którą mi wyznaczyła. Drogą wyznaczoną wszystkim Minfiliom." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_025", "hash": "E316E0C81CC89833", "target": "Ale dała mi nową drogę─nowe życie─które należy tylko do mnie." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_026", "hash": "B8900FEA1214D900", "target": "Choć odeszła, wciąż ją czuję... ciepłą, spokojną i łagodną." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_027", "hash": "290EA0F2689BE40F", "target": "Czuję bijące serce świata i Światło, które w nim narasta." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_028", "hash": "119683F8E011AC88", "target": "Wyczuwam też Strażników Światła. Jeden jest tutaj, w Amh Araeng." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_029", "hash": "B664EE7BF1B57A83", "target": "Wracajmy szybko. Pozostali muszą się dowiedzieć." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_030", "hash": "E0DFBC485C27CBC5", "target": "Myślisz, że Thancred będzie na mnie zły?" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_Q2_000_000", "hash": "00AF7D3842898CBA", "target": "Co odpowiesz?" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_A2_000_001", "hash": "31211EC39D6F8800", "target": "Tego chciała Minfilia. Na pewno zrozumie." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_A2_000_002", "hash": "B8D1C6957F02170B", "target": "Można się o tym przekonać tylko w jeden sposób." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_031", "hash": "142401DF331E0FC1", "target": "Też chciałabym w to wierzyć, ale... \\<wzdycha>" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_032", "hash": "88D4673C52E9C2B9", "target": "\\<wzdycha> Wiem, że muszę się z nim spotkać, ale..." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_033", "hash": "94BD0BE3B3AB640A", "target": "Możesz pójść przodem? Zaraz dołączę. Obiecuję." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_035", "hash": "6B05FE4D20CC5770", "target": "Po prostu... potrzebuję chwili, żeby pomyśleć." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_ALPHINAUD_000_040", "hash": "E7F7061234CE8853", "target": "Wracasz! Zaczynaliśmy się już martwić." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_ALISAIE_000_045", "hash": "24D669121428A4AE", "target": "<split(<string(gstr1)>, ,1)>! Dzięki bogom nic ci nie jest." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_URIANGER_000_050", "hash": "9E218EED8FA0C288", "target": "Powracasz. Gdzież jednak Minfilia?" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_YSHTOLA_000_055", "hash": "7170DDC2E2315F22", "target": "Dobrze, że wracasz. Widzę, że powiodło ci się lepiej niż Thancredowi." }
  ]
}
