{
  "conversation": "quest/036/LucKmd115_03620",
  "gameVersion": "2026.11.03.0000.0000",
  "entries": [
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_SEQ_00", "hash": "39666F40D926930C", "target": "W oczach Minfilii widać zarówno lęk, jak i determinację." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_TODO_00", "hash": "B5308555418FFFF8", "target": "Zbadać wskazane miejsce" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_TODO_01", "hash": "A5C84C567FE62429", "target": "Odszukać Minfilię" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_TODO_02", "hash": "838274F23593FE96", "target": "Odszukać Thancreda" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_000", "hash": "9FCFFC54086025C6", "target": "(-Minfilia-)Wyczuwam jej obecność, choć bardzo słabo." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_001", "hash": "EE42188CC55076A8", "target": "(-Minfilia-)Chodź, poszukajmy przy kryształowej ścianie." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_010", "hash": "0E4C897F3026E735", "target": "(-Minfilia-)Była tutaj. Na szczycie tego budynku..." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_020", "hash": "76150CA2E279BE7C", "target": "(-Minfilia-)\\<jęczy>" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_021", "hash": "8FC0DBCA9B4FE2A5", "target": "(-Minfilia-)Co się stało? Pamiętam, jak rozmawiałam z Minfilią... a potem..." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_022", "hash": "01F50067E3850B30", "target": "(-Minfilia-)Coś nie tak?" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_Q1_000_000", "hash": "A29250F2F5F49059", "target": "Co powiesz?" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_A1_000_001", "hash": "C1ED64E72EA447DA", "target": "Twoje włosy się zmieniły." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_A1_000_002", "hash": "8D0C20CBF9CB5461", "target": "Twoje oczy się zmieniły." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_023", "hash": "B4F6FA558DC4DDCF", "target": "(-Minfilia-)Myślę, że to dar pożegnalny." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_024", "hash": "043AD5AB6C7A875E", "target": "(-Minfilia-)Dotąd szłam drogą, którą mi wyznaczyła. Drogą wyznaczoną wszystkim Minfiliom." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_025", "hash": "0B4C6292AC9CA40A", "target": "(-Minfilia-)Ale dała mi nową drogę─nowe życie─które należy tylko do mnie." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_026", "hash": "B58F0DF82A0A40C3", "target": "(-Minfilia-)Choć odeszła, wciąż ją czuję... ciepłą, spokojną i łagodną." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_027", "hash": "85EE556D50812892", "target": "(-Minfilia-)Czuję bijące serce świata i Światło, które w nim narasta." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_028", "hash": "C7014C709D3D7006", "target": "(-Minfilia-)Wyczuwam też Strażników Światła. Jeden jest tutaj, w Amh Araeng." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_029", "hash": "90F6953FA44289D9", "target": "(-Minfilia-)Wracajmy szybko. Pozostali muszą się dowiedzieć." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_030", "hash": "B0D535A6E5FDEE8B", "target": "(-Minfilia-)Myślisz, że Thancred będzie na mnie zły?" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_Q2_000_000", "hash": "00AF7D3842898CBA", "target": "Co powiesz?" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_A2_000_001", "hash": "31211EC39D6F8800", "target": "Tego chciała Minfilia. Na pewno zrozumie." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_A2_000_002", "hash": "B8D1C6957F02170B", "target": "Można się o tym przekonać tylko w jeden sposób." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_031", "hash": "01EAF4FF1E79E788", "target": "(-Minfilia-)Też chciałabym w to wierzyć, ale... \\<wzdycha>" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_032", "hash": "D2D1EDFF12C6C31C", "target": "(-Minfilia-)\\<wzdycha> Wiem, że muszę się z nim spotkać, ale..." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_033", "hash": "ABB7F49F2651F470", "target": "(-Minfilia-)Możesz pójść przodem? Zaraz dołączę. Obiecuję." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_035", "hash": "E858807928D8C629", "target": "(-Minfilia-)Po prostu... potrzebuję chwili, żeby pomyśleć." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_ALPHINAUD_000_040", "hash": "E7F7061234CE8853", "target": "Wracasz! Zaczynaliśmy się już martwić." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_ALISAIE_000_045", "hash": "24D669121428A4AE", "target": "<split(<string(gstr1)>, ,1)>! Dzięki bogom nic ci nie jest." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_URIANGER_000_050", "hash": "9E218EED8FA0C288", "target": "Powracasz. Gdzież jednak Minfilia?" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_YSHTOLA_000_055", "hash": "7170DDC2E2315F22", "target": "Dobrze, że wracasz. Widzę, że powiodło ci się lepiej niż Thancredowi." }
  ]
}
