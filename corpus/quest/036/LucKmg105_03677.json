  "entries": [
    { "gameKey": "quest/036/LucKmg105_03677#TEXT_LUCKMG105_03677_SEQ_00", "hash": "9FE4086308F7C9E7", "target": "Kai-Shirr chce jak najprędzej wrócić z tobą i Alphinaudem do Eulmore." },
    { "gameKey": "quest/036/LucKmg105_03677#TEXT_LUCKMG105_03677_TODO_00", "hash": "AF7E0CE1E474C00B", "target": "Porozmawiać z Alphinaudem w Eulmore" },
    { "gameKey": "quest/036/LucKmg105_03677#TEXT_LUCKMG105_03677_TODO_01", "hash": "8C1350DECEB233B7", "target": "Poszukać Dulii-Chai" },
    { "gameKey": "quest/036/LucKmg105_03677#TEXT_LUCKMG105_03677_ALPHINAUD_000_000", "hash": "688041C67A09EFA1", "target": "Co tak pilnego mogło się stać, że pani Chai po nas posłała?" },
    { "gameKey": "quest/036/LucKmg105_03677#TEXT_LUCKMG105_03677_HALRIC_000_005", "hash": "0727762745B31788", "target": "M... Mam... Al..." },
    { "gameKey": "quest/036/LucKmg105_03677#TEXT_LUCKMG105_03677_KAISHIRR_000_020", "hash": "2BE1016CE19E1260", "target": "Pani Chai jest na górze, w salonie. Lepiej nie dawać jej dłużej czekać, prawda?" },
    { "gameKey": "quest/036/LucKmg105_03677#TEXT_LUCKMG105_03677_KAISHIRR_000_040", "hash": "AE80C9090F407804", "target": "Dopiero w Crystarium powiedzieli mi, że można was znaleźć w gospodzie Inn at Journey's Head. Całe szczęście, że udało mi się was jeszcze zastać. Nabiegałem się już dość." },
    { "gameKey": "quest/036/LucKmg105_03677#TEXT_LUCKMG105_03677_ALPHINAUD_000_060", "hash": "8513828C05CC0C30", "target": "Z pozoru wszystko w porządku. Tylko pani Chai nigdzie nie widzę." },
    { "gameKey": "quest/036/LucKmg105_03677#TEXT_LUCKMG105_03677_KAISHIRR_000_061", "hash": "8644477B185590AC", "target": "Pewnie znów wyszła na zewnątrz. Chodzi tam i z powrotem, patrzy w dal, wzdycha..." },
    { "gameKey": "quest/036/LucKmg105_03677#TEXT_LUCKMG105_03677_ALPHINAUD_000_062", "hash": "2FC97E9C406C26FF", "target": "Dziwne. Znajdźmy ją i zapytajmy, co ją trapi." }
  ]
