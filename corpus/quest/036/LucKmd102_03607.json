{
  "conversation": "quest/036/LucKmd102_03607",
  "gameVersion": "2026.09.15.0000.0000",
  "entries": [
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_SEQ_00", "hash": "DDDCD3D40B33B28A", "target": "Alisaie rozmyśla o tym, ile pracy pozostało po bitwie." },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_TODO_00", "hash": "FF17744E08146D63", "target": "Pomóc rannym" },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_TODO_01", "hash": "B9D37C7317C9792B", "target": "Porozmawiać z dowódczynią Lyna" },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_ALPHINAUD_000_000", "hash": "60F182438EB6A1C7", "target": "Wytrzymaj jeszcze chwilę..." },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_URIANGER_000_005", "hash": "367B1AEA09249DE9", "target": "Musisz pozostać bez ruchu." },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_YSHTOLA_000_010", "hash": "CB523C49CE442E18", "target": "Weź głęboki oddech. Właśnie tak..." },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_ALISAIE_000_020", "hash": "1337C1198EEC75A2", "target": "Pozostali pomagają opatrywać rannych. Ja zamierzam pomóc ich przewieźć, ale i tak brakuje nam rąk do pracy." },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_ALISAIE_000_021", "hash": "F26B8C5788EF2D42", "target": "Pewnie padasz z nóg po tym wszystkim─ja na pewno─ale ogromnie nam pomożesz, jeśli zajmiesz się kilkoma pacjentami." },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_ALISAIE_000_022", "hash": "4983B767A78D6DFD", "target": "Kapitan Lyna też gdzieś tu jest. Możesz spytać ją, czy trzeba jeszcze w czymś pomóc. Porozmawiamy później." },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_ALISAIE_000_025", "hash": "1C468D0DE6630F19", "target": "Wytrzymaj. Obiecuję, że wrócisz do Crystarium następnym wozem..." },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_INJUREDA03607_000_030", "hash": "EB6F2FCF9022210E", "target": "Ja... ja... \\<charczy>" },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_SYSTEM_000_031", "hash": "09142A9F9078E5B2", "target": "Leżący mężczyzna patrzy na ciebie oczami pełnymi łez. Jego palce drgają, jakby chciał wyciągnąć rękę, lecz brak mu sił." },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_INJUREDA03607_000_032", "hash": "026A21514A7A64BA", "target": "..." },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_INJUREDB03607_000_033", "hash": "A430C1BBAC1DE870", "target": "D-dziękuję, ale... jest już za późno." },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_INJUREDB03607_000_034", "hash": "764BD42B13DA9DF9", "target": "Jeden z nich... dopadł mnie. \\<kaszle>" },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_INJUREDB03607_000_035", "hash": "079E3225D8C46368", "target": "Jeśli się przemienię, proszę... Proszę, zabij mnie." },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_INJUREDB03607_000_036", "hash": "DC5F40A8FD07D383", "target": "Tak mi... tak mi przykro." },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_INJUREDC03607_000_037", "hash": "2E5A4AB19938951D", "target": "Nie dotykaj mnie! Ja... ja..." },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_INJUREDC03607_000_038", "hash": "1627F30323FC3176", "target": "Zabiłem ją... Zabiłem! Była jednym z nich, wiem, ale... \\<szlocha>" },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_INJUREDC03607_000_039", "hash": "34C4519D9106702C", "target": "Może na to zasłużyłem... Ale <italic(1)>ona<italic(0)>..." }
  ]
}
