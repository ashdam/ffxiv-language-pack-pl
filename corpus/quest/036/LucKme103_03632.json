{
  "conversation": "quest/036/LucKme103_03632",
  "gameVersion": "2026.09.15.0000.0000",
  "entries": [
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_SEQ_00", "hash": "9B70445F02670201", "target": "Thancred ma dla ciebie zadanie." },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_TODO_00", "hash": "D6DAEDDA6CC657E4", "target": "Poszukać zniewolonych cywilów w Derelicts" },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_TODO_01", "hash": "B363C39BF2960A69", "target": "Podać Thoarichowi proszek nasenny" },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_TODO_02", "hash": "407BE3845300622F", "target": "Poszukać zniewolonych cywilów w Understory" },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_TODO_03", "hash": "39CC28C79AE2538C", "target": "Podać uprzejmej pannie proszek nasenny" },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_TODO_04", "hash": "125133850B54D1C1", "target": "Poszukać zniewolonych cywilów w Canopy" },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_TODO_05", "hash": "50DC2E0C18C33DF8", "target": "Podać wolnemu obywatelowi proszek nasenny" },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_TODO_06", "hash": "F4166207A1C36242", "target": "Porozmawiać z Ryne" },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_ALPHINAUD_000_000", "hash": "A37D0212131CBF6B", "target": "Raz jeszcze dziękuję, <split(<string(gstr1)>, ,1)>. Znajdziemy rannych i pomożemy im, jak zdołamy." },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_ALISAIE_000_005", "hash": "BB3A42C58E4DEB2E", "target": "Niektórym udało się wyrwać spod kontroli umysłu, ale ucierpieli w zamieszaniu. Dopilnujemy, by i oni otrzymali pomoc." },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_RYNE_000_010", "hash": "AF4899B06409F4B3", "target": "Już dobrze. Teraz nic ci nie grozi." },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_PATIENT03631_000_015", "hash": "DBB2994E752C7B01", "target": "\\<jęczy> Co... co się stało?" },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_URIANGER_000_020", "hash": "8DA779093644A9F9", "target": "Bez dowództwa żołnierze stracili wolę walki. Nie stanowią dla nas zagrożenia." },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_YSHTOLA_000_025", "hash": "003BC37C236A1622", "target": "A więc tak wyglądało życie obywateli─eulmorski sen. Czeka ich przykre przebudzenie." },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_THANCRED_000_030", "hash": "B6913CC2A2CD8DCA", "target": "A więc, oto proszek nasenny." },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_THANCRED_000_031", "hash": "525B123275DAFDC0", "target": "Podajemy go zniewolonym, by zachowali spokój, zanim otrzymają odpowiednią pomoc. Będę wdzięczny za wsparcie." },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_THANCRED_000_032", "hash": "9F2468293B2DA0DA", "target": "Dotknięci są rozsiani po całym mieście. Radzę zacząć poszukiwania w Derelicts i piąć się w górę." },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_THANCRED_000_033", "hash": "CF5B8F0F556E5C46", "target": "Kiedy skończysz, koniecznie powiadom Ryne." },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_THOARICH_000_040", "hash": "BA5C2ADAC1AE946F", "target": "O, lordzie Vauthry... Jesteś... moim codziennym meolem..." },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_THOARICH_000_050", "hash": "A97BCC7A4B1BFFD5", "target": "\\<chrapie> \\<chrapie>" },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_THOARICH_000_060", "hash": "13AB24445EA80561", "target": "Mmmmmm... meol... \\<mlaszcze>" },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_EMPLOYEE03287_000_065", "hash": "67A6311C3CAAB3D3", "target": "\\<wzdycha gwałtownie> Znam cię!" },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_LADY03287_000_070", "hash": "DB6E0A61E5F8D5E3", "target": "Aaach... boli... Proszę, lordzie Vauthry... zabierz ten ból..." },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_EMPLOYEE03287_000_071", "hash": "BCD105BB6293E65D", "target": "To ty <if(gnum4,uratowałaś,uratowałeś)> mnie przed śmiertelnym upadkiem!" },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_EMPLOYEE03287_000_072", "hash": "1C0CC6E2819F9C8C", "target": "M-moja pani jest ranna! Proszę, pomóż jej, błagam!" },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_EMPLOYEE03287_000_075", "hash": "8DF30FB50C50CC6E", "target": "Proszę, czy nic nie da się dla niej zrobić?" },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_EMPLOYEE03287_000_080", "hash": "95204AF6BFD569E8", "target": "C-co to jest?" },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_EMPLOYEE03287_000_081", "hash": "D4E21E47868B569A", "target": "Ona... śpi. To lekarstwo pomoże jej odpocząć, póki nie otrzyma pomocy, tak?" },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_EMPLOYEE03287_000_082", "hash": "7143DD1B292C77AC", "target": "Och, dziękuję ci z całego serca! Kiedy zaczęła się dziwnie zachowywać, trudno było wiedzieć, co robić..." },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_LADY03287_000_090", "hash": "C2039929498604EB", "target": "Chrrrr..." },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_EMPLOYEE03287_000_095", "hash": "F7B374A00818A578", "target": "Nie odstąpię mojej pani ani na krok." },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_GENTLEMAN03289_000_100", "hash": "FA14E22227A1D665", "target": "Muszę powstrzymać... intruzów... Bezczeszczą... nasz raj..." },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_GENTLEMAN03289_000_110", "hash": "07442D5EBAD4439C", "target": "\\<parska> Dokąd odleciałaś... moja słodka kanarko...?" },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_GENTLEMAN03289_000_120", "hash": "346D90BC5D160DC7", "target": "Proszę, nie zostawiaj mnie... Chrrrr..." },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_RYNE_000_130", "hash": "BC462AB698AE58C0", "target": "Och, jesteś, <split(<string(gstr1)>, ,1)>." },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_RYNE_000_131", "hash": "F3E6A72CE0564401", "target": "Właśnie pomogłam temu mężczyźnie. Teraz kolejny..." },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_RYNE_000_132", "hash": "012226205AFE6630", "target": "Mówisz, że w Derelicts i niżej jest ich jeszcze więcej? Tak wielu..." },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_RYNE_000_133", "hash": "745D6916F82DB913", "target": "Ale Minfilia powierzyła mi tę moc. Nie spocznę, póki nie pomogę wszystkim." },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_Q1_000_000", "hash": "2AB99389C8DFB4A2", "target": "Co odpowiesz?" },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_A1_000_001", "hash": "C807D127E8BF80F2", "target": "Mogę przyprowadzać do ciebie zniewolonych." },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_A1_000_002", "hash": "2A2591130B7B1A1E", "target": "Zajmę się rannymi." },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_RYNE_000_134", "hash": "12883BBC2D6832DB", "target": "Och, to bardzo ułatwi mi pracę." },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_RYNE_000_135", "hash": "B0CD951EDDFA8C5A", "target": "Dziękuję, <split(<string(gstr1)>, ,1)>. Postaram się dotrzymać ci kroku." },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_RYNE_000_136", "hash": "37F4BD92E658FCC9", "target": "Alphinaud i Alisaie z pewnością docenią pomoc." },
    { "gameKey": "quest/036/LucKme103_03632#TEXT_LUCKME103_03632_RYNE_000_137", "hash": "B0C577E360F6C81E", "target": "Jeśli znajdziesz kolejnych zniewolonych cywilów, proszę, przyprowadź ich do mnie." }
  ]
}
