{
  "conversation": "quest/025/StmBda610_02536",
  "gameVersion": "2026.09.15.0000.0000",
  "entries": [
    { "gameKey": "quest/025/StmBda610_02536#TEXT_STMBDA610_02536_SEQ_00", "hash": "0FE358E431BDA3DB", "target": "Alisaie jest gotowa opuścić Ala Ghiri, gdy tylko zechcesz." },
    { "gameKey": "quest/025/StmBda610_02536#TEXT_STMBDA610_02536_TODO_00", "hash": "21AC4C03C90C8ACA", "target": "Patrolować Wightrock w poszukiwaniu wojsk Imperium" },
    { "gameKey": "quest/025/StmBda610_02536#TEXT_STMBDA610_02536_TODO_01", "hash": "2F23A23CD9F37831", "target": "Spotkać się z Alisaie" },
    { "gameKey": "quest/025/StmBda610_02536#TEXT_STMBDA610_02536_ALISAIE_000_001", "hash": "CF7EA01691BA6612", "target": "Mamy spory teren do sprawdzenia, więc lepiej się rozdzielić. Jeśli trafisz na imperialnych żołnierzy, wiesz, co robić." },
    { "gameKey": "quest/025/StmBda610_02536#TEXT_STMBDA610_02536_ALISAIE_000_002", "hash": "8C968B641F5B3D71", "target": "Ach, i jeszcze jedno─powiadomiłam oddział Arenvalda. Przeszukują już pobliskie obszary, więc jeśli natrafimy na coś ponad nasze siły, mamy wsparcie." },
    { "gameKey": "quest/025/StmBda610_02536#TEXT_STMBDA610_02536_BALLOON_000_010", "hash": "6B43B53B4733E8B1", "target": "Zauważono siły wroga!" },
    { "gameKey": "quest/025/StmBda610_02536#TEXT_STMBDA610_02536_BALLOON_000_015", "hash": "98555A158F391AC8", "target": "Atakować! Atakować!" },
    { "gameKey": "quest/025/StmBda610_02536#TEXT_STMBDA610_02536_ALISAIE_000_020", "hash": "6B0E4DC19C0A5BE3", "target": "Ach, chwileczkę, <split(<string(gstr1)>, ,1)>." },
    { "gameKey": "quest/025/StmBda610_02536#TEXT_STMBDA610_02536_ALISAIE_200_020", "hash": "DA3B107160666710", "target": "Powtórz, proszę.<br>...Hm. Nie, na razie trzymajcie się z daleka." },
    { "gameKey": "quest/025/StmBda610_02536#TEXT_STMBDA610_02536_ALISAIE_100_020", "hash": "94F7C227E9939270", "target": "...Rozumiem. Informuj mnie o wszelkich zmianach." },
    { "gameKey": "quest/025/StmBda610_02536#TEXT_STMBDA610_02536_ALISAIE_000_021", "hash": "4EB345257AEA5824", "target": "To był Arenvald. Dwójka, która szpiegowała nas w The Fringes, podążyła za nami aż tutaj..." },
    { "gameKey": "quest/025/StmBda610_02536#TEXT_STMBDA610_02536_ALISAIE_000_022", "hash": "EA2EBCF4E93D3714", "target": "A u ciebie, <split(<string(gstr1)>, ,1)>? Były kłopoty?" },
    { "gameKey": "quest/025/StmBda610_02536#TEXT_STMBDA610_02536_ALISAIE_000_023", "hash": "8F64A4763FFFFCA4", "target": "...A ja już myślałam, że doczekamy się trochę spokoju. Dobrze, że udało ci się z nimi rozprawić." },
    { "gameKey": "quest/025/StmBda610_02536#TEXT_STMBDA610_02536_ALISAIE_000_024", "hash": "956DE7AF29B35555", "target": "Mam nadzieję, że szturm na Specula Imperatoris przebiega pomyślnie..." },
    { "gameKey": "quest/025/StmBda610_02536#TEXT_STMBDA610_02536_ALISAIE_000_025", "hash": "7C539CE7E491E78B", "target": "Na Dwunastu, widzisz to!? Główna wieża właśnie się zawaliła!" },
    { "gameKey": "quest/025/StmBda610_02536#TEXT_STMBDA610_02536_ALISAIE_000_026", "hash": "910CC5B0C09E5B1E", "target": "Też to słyszysz, prawda? To musiało być działo z Castrum Abania. Ale to była imperialna placówka, a ich żołnierze wciąż─" },
    { "gameKey": "quest/025/StmBda610_02536#TEXT_STMBDA610_02536_ALISAIE_000_027", "hash": "FD44AC87437BDC08", "target": "Cholera, nikt nie odpowiada! Nie wiem, czy linkpearl jest zakłócany, czy..." },
    { "gameKey": "quest/025/StmBda610_02536#TEXT_STMBDA610_02536_ALISAIE_000_028", "hash": "F34095D19F3BBB23", "target": "Musimy ruszać! Potrzebują naszej pomocy!" }
  ]
}
