{
  "conversation": "quest/049/KinGmf111_04956",
  "gameVersion": "2026.11.03.0000.0000",
  "entries": [
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_SEQ_00", "hash": "2B7EDB5B53C7C640", "target": "Cahciua jest gotowa ruszyć do czwartej, ostatniej części miasta." },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_TODO_00", "hash": "CC4EBC2C6F486B38", "target": "Porozmawiać z Cahciuą" },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_TODO_01", "hash": "AF820A5337C39282", "target": "Porozmawiać ze strażniczką Ogrodów Windspath" },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_TODO_02", "hash": "F56F0226CB2BE7EC", "target": "Porozmawiać z Cahciuą" },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_TODO_03", "hash": "233EF108B074E5AA", "target": "Ponownie porozmawiać z Cahciuą" },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_WUKLAMAT_000_001", "hash": "4C5664E681805AA5", "target": "A teraz trzeba się pożegnać z..." },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_GRAHATIA_000_005", "hash": "F65ED5622A59AA5B", "target": "Jeszcze tylko jedna część miasta..." },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_KRILE_000_010", "hash": "BD17F0A423572E4C", "target": "Ich wspomnienia zniknęły. Ale ich miłość zostanie ze mną na zawsze..." },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_ERENVILLE_000_015", "hash": "D84AA1CEC5ECC8E2", "target": "..." },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_CAHCIUA_000_020", "hash": "9E19EDE339F45A44", "target": "Im bliżej końca, tym szybciej leci czas, co?" },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_CAHCIUA_000_021", "hash": "BDB60F019487BCDE", "target": "Chodźcie, została nam czwarta i ostatnia część miasta. Wiecie już, jak się tam dostać, prawda?" },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_WUKLAMAT_000_022", "hash": "21A4DF58C8CE692C", "target": "...Tak, wiemy." },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_CAHCIUA_000_023", "hash": "B529F150F7F49070", "target": "Świetnie. Zajrzę jeszcze do Meso Terminalu i spotkamy się przy bramie Gate of Remembrance." },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_WUKLAMAT_000_024", "hash": "9BAA35407AAC8C20", "target": "Chodźmy, wszyscy razem..." },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_WUKLAMAT_000_025", "hash": "50FA34D918A7542F", "target": "Erenville..." },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_GRAHATIA_000_030", "hash": "5DC78916AA23A131", "target": "A więc to już..." },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_KRILE_000_035", "hash": "C80EC3E53364191F", "target": "Znów będzie ciężko, ale Cahciua tego chce. Musimy to uszanować." },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_ERENVILLE_000_040", "hash": "65D65D008607E196", "target": "..." },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_CAHCIUA_000_050", "hash": "2A4B27894AE7C9A8", "target": "Wygląda na to, że mamy jeszcze trochę czasu, nim Meso Terminal skończy obliczenia." },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_CAHCIUA_000_051", "hash": "B95C63C139A31F8E", "target": "Możecie więc spokojnie poznawać Wiecznych w ostatniej części miasta." },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_CAHCIUA_000_052", "hash": "DAC65FBF19318E9C", "target": "To Ogrody Windspath. Aż dech zapierają!" },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_ERENVILLE_000_053", "hash": "6C4E17F3CB4B9709", "target": "To tam są twoje wspomnienia, prawda?" },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_CAHCIUA_000_054", "hash": "2DD57BBBF7375CAA", "target": "Tak. Zostawiłam ogrody na koniec, żeby jak najdłużej wam towarzyszyć. Ładnie z mojej strony, prawda?" },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_CAHCIUA_000_055", "hash": "F5BC05059B22D174", "target": "O! Mam świetny pomysł!" },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_WUKLAMAT_000_056", "hash": "CAB344B15567AF6E", "target": "Co wymyśliłaś?" },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_CAHCIUA_000_057", "hash": "B4F12E5220138DB2", "target": "\\<chichocze> Opowiem wam, jak już dotrzecie na drugą stronę. Do zobaczenia!" },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_ERENVILLE_000_058", "hash": "90E6569D7F3DCBE8", "target": "Z jej „świetnych pomysłów” zwykle nic dobrego nie wynika." },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_WUKLAMAT_000_059", "hash": "145E1C54D98C7923", "target": "Słuchaj, Erenville..." },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_WUKLAMAT_000_060", "hash": "9EE933D9ECD926D6", "target": "Chcę spełnić życzenie twojej mamy, ale liczę się też z tym, czego ty chcesz." },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_WUKLAMAT_000_061", "hash": "014BF3A1B44747EC", "target": "Chciałabym, żebyś po wszystkim potrafił się uśmiechnąć. Mam nadzieję, że to wiesz." },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_ERENVILLE_000_062", "hash": "5F4242CA2AA22D22", "target": "Wiem." },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_ERENVILLE_000_063", "hash": "DB8AEAF9F6BEA1D2", "target": "Wiem..." },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_WUKLAMAT_000_064", "hash": "A74834BA67D3997E", "target": "Cahciua to dla niego nie tylko mama─to też mentorka, którą zawsze podziwiał. Tym trudniej mu się z nią pożegnać." },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_WUKLAMAT_000_065", "hash": "81A224AD8F9D39D8", "target": "Chodźmy. Nadal mamy to samo zadanie: poznać Wiecznych i dowiedzieć się, na czym im zależało." },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_WUKLAMAT_000_070", "hash": "CA33B31264452D02", "target": "Nie każmy Cahciui czekać." },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_GRAHATIA_000_075", "hash": "37B9F37D2C8CDA9F", "target": "Erenville ma w sobie dużo siły. Wierzę w niego." },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_KRILE_000_080", "hash": "AEFEF9752F8F0292", "target": "Ciekawe, na jaki to świetny pomysł wpadła Cahciua." },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_ERENVILLE_000_085", "hash": "AF6BC0F9BFD3C3DE", "target": "Nie, to nie... \\<wzdycha>" },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_WINDSPATHGARDENSGUARD_000_090", "hash": "A87EFE5D90484555", "target": "\\<bip> \\<bup> Błąd. Błąd. Uruchamiam system weryfikacji... Rejestracja użytkowników... potwierdzona." },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_WINDSPATHGARDENSGUARD_000_091", "hash": "46DCBB160F634FA3", "target": "Witam w Ogrodach Windspath, raju dla ciekawych świata! Czekają na was cuda przyrody!" },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_WUKLAMAT_000_095", "hash": "651F999A9B8845C1", "target": "Pomóżmy Cahciui przeżyć coś, co będzie miło wspominać!" },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_GRAHATIA_000_100", "hash": "AED9BDE825461099", "target": "Raj dla ciekawych świata... Nic dziwnego, że to tu są wspomnienia Cahciui." },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_KRILE_000_105", "hash": "444AAC6C9E2A60DC", "target": "Do samego końca gonić za marzeniami... Cała Cahciua." },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_ERENVILLE_000_110", "hash": "765D9BD68840B239", "target": "..." },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_CAHCIUA_000_120", "hash": "916142B3750F0D04", "target": "Skoro się zgadzacie, ruszajmy na przygodę!" },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_CAHCIUA_000_121", "hash": "41B49CA71A655370", "target": "Po drodze śmiało zagadujcie do Wiecznych. I nacieszcie się widokami!" },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_WUKLAMAT_000_125", "hash": "33A2B70838425794", "target": "Myślałam, że to jakieś olbrzymie drzewa, a to rzeźby!" },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_GRAHATIA_000_130", "hash": "91ADF59A8D305C74", "target": "Co za widok. Pomyśleć, że mimo niedoboru eteru Sphene udało się zachować to miejsce dla Wiecznych..." },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_KRILE_000_135", "hash": "99118298E6DCC696", "target": "Ale tu pięknie!" },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_ERENVILLE_000_140", "hash": "313F31539EB49712", "target": "...Tak coś czułem." },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_CAHCIUA_000_150", "hash": "8073DBDD677CB08F", "target": "To Kwiaty Odkryć. Pięknie tu, co?" },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_GRAHATIA_000_151", "hash": "05AA2D690F9E7E96", "target": "Wspaniale! I wszystkie rośliny są tu prawdziwe?" },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_CAHCIUA_000_152", "hash": "92498BEFEF4ADCB3", "target": "Tak! Sprowadzono je tu przed wiekami, żeby je ocalić. Po tamtej katastrofie groziło im wyginięcie." },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_KRILE_000_153", "hash": "3A57BC77BE75C98D", "target": "Czyli całe to miejsce jest jednym wielkim ogrodem botanicznym." },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_CAHCIUA_000_154", "hash": "984DF0B1C5DCAB2A", "target": "Dobrze powiedziane, Krile! Są tu rośliny i zwierzęta, których już nigdzie indziej nie spotkasz." },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_CAHCIUA_000_155", "hash": "B292C965F546AA0F", "target": "I co, Elene'shpya, nie odzywa się w tobie żyłka zbieracza?" },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_ERENVILLE_000_156", "hash": "66223603CBC416FA", "target": "Chyba tak." },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_ERENVILLE_000_157", "hash": "CB70D2358C4B6CAE", "target": "Możliwe, że żyją tu gatunki spokrewnione z tymi, które widziałem poza Turalem." },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_ERENVILLE_000_158", "hash": "247959FFF683AE70", "target": "Nie znam się na przyrodzie odbić, ale ciekawie byłoby się przyjrzeć różnicom." },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_CAHCIUA_000_159", "hash": "397058AACF610876", "target": "O, to jest pomysł! Od razu widać, że to mój uczeń." },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_CAHCIUA_000_160", "hash": "DAD7AF124B200D50", "target": "Mamy tu <if(gnum4,poszukiwaczkę przygód przemierzającą,poszukiwacza przygód przemierzającego)> światy, doświadczonego zbieracza i dwoje wybitnych uczonych z Sharlayanu." },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_CAHCIUA_000_161", "hash": "A366B56A5B066AB6", "target": "Sami ludzie ciekawi świata! Aż się cieszę, że jestem w takim towarzystwie!" }
  ]
}
