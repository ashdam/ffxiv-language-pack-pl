{
  "conversation": "quest/049/KinGme105_04936",
  "gameVersion": "2026.11.03.0000.0000",
  "entries": [
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_SEQ_00", "hash": "4DC3BA8430957E22", "target": "Wuk Lamat skończyła zwiedzać dzielnicę. Czas ruszyć na miejsce spotkania." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_TODO_00", "hash": "72979CDA504F7460", "target": "Porozmawiaj z Wuk Lamat." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_TODO_01", "hash": "B00AB75591B48E6E", "target": "Rozejrzyj się we wskazanym miejscu." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_TODO_02", "hash": "AD8C72E52E2846C2", "target": "Porozmawiaj z dzieckiem Hoobigo o niebieskich łuskach, a potem rusz za nim razem z Wuk Lamat." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_TODO_03", "hash": "E7D41C4ECCC7F9C4", "target": "Idź za dzieckiem Hoobigo o niebieskich łuskach w towarzystwie Wuk Lamat." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_TODO_04", "hash": "B43ED6F13F612BED", "target": "Porozmawiaj z Wuk Lamat." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_001", "hash": "D711C988090B6935", "target": "Mamy się dostać do True Vue we wschodniej części dzielnicy. Tym transporterem chyba da się tam dojechać." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_002", "hash": "A9FA79D02201DDE8", "target": "Wiesz co? Jak się człowiek do tego przyzwyczai, to całkiem fajna zabawa. Chodź, <split(<string(gstr1)>, ,1)>!" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_010", "hash": "1F7F405B0C0EBC71", "target": "To tutaj, prawda?" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_011", "hash": "85D269696ABC8AC2", "target": "Tylko reszty nigdzie nie widać..." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_012", "hash": "AAA003FCB7D5E19E", "target": "Nie ma co stać i czekać. Lepiej się jeszcze trochę rozejrzeć." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_013", "hash": "A0A30846D7995928", "target": "Co jest? <split(<string(gstr1)>, ,1)>, patrz tam!" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_014", "hash": "52E04AAF6006B966", "target": "Dziecko Mamool Ja? Co ono tutaj robi...?" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_015", "hash": "84BA33B64848BB50", "target": "Też ci przypomina Zoraal Ja, co?" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_016", "hash": "0FA2D311187B1121", "target": "Łuski ma niebieskie jak Boonewa, ale rysy jak u Hoobigo..." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_017", "hash": "81AF68C16847AA38", "target": "To nie może być przypadek." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_018", "hash": "C58674BB0A83DC7F", "target": "Tak czy inaczej, nie zostawimy takiego malucha samego." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_019", "hash": "3C58AA780476FCD6", "target": "Chodź, dogońmy go!" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_100_019", "hash": "A70D0540CDAD2426", "target": "Maluch chyba pobiegł tędy..." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_020", "hash": "31ACC571C6BBE5EE", "target": "Więc to jest True Vue. Nie wiem, co to wszystko ma znaczyć, ale na nudę chyba tu nie narzekają!" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_021", "hash": "BBF2849FD3A94DB0", "target": "Prawie wszędzie palą się światła, tylko w tamtym budynku ciemno. Myślisz, że mają zamknięte?" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_022", "hash": "8231A914FCF1CC3F", "target": "Aaa!?" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_023", "hash": "9F715B1CC1D7F68A", "target": "N-nie zauważyłam cię..." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_024", "hash": "337FC3CF4F058A4A", "target": "Nie bój się, nic ci nie zrobimy. Chcemy pogadać." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_025", "hash": "43306135F879B303", "target": "Dziwne, co? Ledwie się zbliżymy, już ucieka, a po chwili znów jest obok..." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_026", "hash": "8F0353734599DD2B", "target": "Może chce nas gdzieś zaprowadzić?" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_027", "hash": "BE3440E2014F888F", "target": "O to ci chodzi? Mamy iść za tobą?" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_028", "hash": "E448F9002EC15043", "target": "A jednak! No to prowadź." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_030", "hash": "9EFDD5B841DDBBF9", "target": "Chodźmy za nim. Zobaczymy, gdzie nas zaprowadzi." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_GULOOLJA_000_040", "hash": "4421C94215A55747", "target": "...!" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_SYSTEM_000_044", "hash": "BA70C4EDA64BBCF2", "target": "Ruszyć za dzieckiem Hoobigo o niebieskich łuskach?" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_Q1_000_000", "hash": "EB588CC646DD0F4F", "target": "Co zrobisz?" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_A1_000_001", "hash": "1BC242E3E91C1E1B", "target": "Porozmawiać." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_A1_000_002", "hash": "04FC3A36E379E073", "target": "Rozstać się." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_A1_000_003", "hash": "5E7465CC09960E9E", "target": "Nic." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_100_044", "hash": "73D51D10CE27A8AA", "target": "Tym razem go nie zgubmy!" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_Q2_000_000", "hash": "1EDB80CAFE8E4487", "target": "Czy na pewno chcesz rozstać się z Wuk Lamat?" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_100_045", "hash": "87C514F8313966AC", "target": "Co jest? To jedzenie z Alexandrii ci zaszkodziło? Dobra, powiem małemu, że potrzebujesz chwili. Zaczekamy w miejscu, z którego wyruszyliśmy." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_SYSTEM_110_045", "hash": "0F9849D4E52095B8", "target": "Wuk Lamat jeszcze nie dotarła. Zaczekaj na nią, zanim ruszysz dalej." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_120_045", "hash": "8962B0DC3B12B922", "target": "Cholera, nie ma go! Najlepiej wrócić na miejsce, z którego ruszyliśmy..." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_SYSTEM_130_045", "hash": "E11D89D0D3763EF7", "target": "Wróć do Recreation Zone i porozmawiaj z dzieckiem Hoobigo o niebieskich łuskach, żeby spróbować ponownie." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_GULOOLJA_000_045", "hash": "9F8BFF5E64AA92FF", "target": "...!" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_050", "hash": "62865C83A6DDB1E9", "target": "Tu właśnie chcesz nas zaprowadzić?" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_051", "hash": "45E7BA8F57CB89A9", "target": "Co to za miejsce? Jeśli tu się przychodzi odpocząć, to ja się za nic nie odprężę..." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_052", "hash": "95D67D1BFC2D7202", "target": "Słuchaj... jak ci na imię?" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_053", "hash": "A51E18DF1B71ED9E", "target": "Dalej nie masz ochoty pogadać, co...?" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_MELANCHOLY_000_054", "hash": "8B614746931724F2", "target": "Odezwie się dopiero, jak wam zaufa." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_055", "hash": "5A4E1514E39ABFF1", "target": "Znasz go?" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_MELANCHOLY_000_056", "hash": "84FF9A4782AA01A7", "target": "Można tak powiedzieć. Ale mniejsza o to... Napijecie się czegoś?" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_MELANCHOLY_000_057", "hash": "49EA5B2174C5E2E1", "target": "<if(gnum4,Jesteście tak urocze,Jesteście tak uroczy)>, że was poczęstuję─polecam nasz popisowy drink, „Jej Wysokość”. Dla małego też zrobię, tylko bez alkoholu." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_058", "hash": "EE3469931A36E8DD", "target": "Yyy, dzięki, może innym razem. Mamy się spotkać z Cahciuą, naszą przyjaciółką." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_059", "hash": "FB9ACC2479267D8C", "target": "<if(gnum4,Po drodze natknęłyśmy się na to dziecko,Po drodze natknęliśmy się na to dziecko)> i to ono nas tu przyprowadziło." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_MELANCHOLY_000_060", "hash": "6D5904336642183A", "target": "Aaa, to wy do Cahciui." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_MELANCHOLY_000_061", "hash": "EF39C4E1FA9D3D56", "target": "To pogadajcie z tamtym dryblasem, Tassosem. Zaprowadzi was w ciekawe miejsce." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_062", "hash": "7476EE0F8CF2E073", "target": "A co z nim?" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_MELANCHOLY_000_063", "hash": "400556D1123C7B3E", "target": "Zostanie tu ze mną przy barze. I tak chyba na razie z wami nie pogada." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_064", "hash": "85F8A93086D18F3B", "target": "Coraz dziwniejsza sprawa. To chyba nie pułapka, co?" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_065", "hash": "7E34942071AADC94", "target": "Coś mi tu strasznie śmierdzi..." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_MELANCHOLY_000_070", "hash": "EAF01758269C6B7F", "target": "Jak ci jednak przyjdzie ochota na drinka, daj znać." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_GULOOLJA_000_075", "hash": "B50D8F571265E752", "target": "..." },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_TASSOS_000_080", "hash": "273A4B42A415C42B", "target": "Chcesz przejść dalej? A co z twoją towarzyszką?" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_090", "hash": "B5449B099F1CF6FD", "target": "Ciekawe miejsce? Myślisz, że Cahciua tam będzie?" },
    { "gameKey": "quest/049/KinGme105_04936#TEXT_KINGME105_04936_WUKLAMAT_000_091", "hash": "2D98A6AB4FD96705", "target": "No, inaczej się nie dowiemy. Pogadajmy z Tassosem..." }
  ]
}
