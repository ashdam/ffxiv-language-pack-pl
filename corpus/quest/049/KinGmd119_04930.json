{
  "conversation": "quest/049/KinGmd119_04930",
  "gameVersion": "2026.11.03.0000.0000",
  "entries": [
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_SEQ_00", "hash": "C6DFBBF18B0C7D1B", "target": "Sphene chce wrócić z tobą do The Outskirts." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_TODO_00", "hash": "F47D7A6FB6A61DA2", "target": "Porozmawiać z Wuk Lamat" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_TODO_01", "hash": "C1C77551FAF864CF", "target": "Ponownie porozmawiać z Wuk Lamat" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_TODO_02", "hash": "589DF18F5BA6FA8C", "target": "Porozmawiać z mieszkańcami The Outskirts" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_TODO_03", "hash": "FC91035468A1EFC4", "target": "Zaczekać w miejscu docelowym" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_TODO_04", "hash": "73669EBE32765892", "target": "Zbadać miejsce docelowe" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_TODO_05", "hash": "21B33A26C2575F0A", "target": "Porozmawiać z Erenville" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_TODO_06", "hash": "DD76829BAB93E9AB", "target": "Ponownie porozmawiać z Erenville" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_TODO_07", "hash": "1E89DA1553A4114B", "target": "Ponownie porozmawiać z Erenville" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_TODO_08", "hash": "A875AD082474E08A", "target": "Porozmawiać z postacią Erenville w Kryjówce Ziemnego Nieba" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_WUKLAMAT_000_001", "hash": "60247F35B647A270", "target": "Zoraal Ja, ty draniu..." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_SPHENE_000_010", "hash": "B1AE6A10D4ADFAE7", "target": "Może wrócimy do The Outskirts? Wasi przyjaciele pewnie już tam są." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_MAHUWSA_000_011", "hash": "26C36AE2671C0FBA", "target": "Jeszcze raz dziękuję, że rozprawiliście się z potworami. Wpadajcie, kiedy chcecie." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_WUKLAMAT_000_015", "hash": "0E784544CCD3109F", "target": "...Słyszysz to?" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_SPHENE_000_020", "hash": "6836547F3A623E26", "target": "Chciałabym wam pokazać jeszcze tyle miejsc w Alexandrii!" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_MAHUWSA_000_025", "hash": "466E22E701C32C09", "target": "Podziwiam królową Sphene i mam do niej wielki szacunek, jak wszyscy. Ale trochę mi głupio mówić jej to w oczy..." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_WUKLAMAT_000_030", "hash": "0181ED5EF2D7553F", "target": "Co się stało? Jak Pepoane mógł tak nagle zapomnieć o Namikce?" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_WUKLAMAT_000_031", "hash": "4693B30925982B41", "target": "Zupełnie jakby nigdy jej nie znał..." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ALISAIE_000_032", "hash": "48E62BEE6CA790AD", "target": "Może z innymi też się tak stało?" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_KRILE_000_033", "hash": "2847A2BA87D9DB82", "target": "Najlepiej się przekonać. Popytajmy w okolicy o Namikkę, a potem spotkajmy się przy eterycie." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ALISAIE_000_034", "hash": "1F7F3F4225AA2358", "target": "Strasznie mnie to niepokoi..." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_GRAHATIA_000_035", "hash": "3E4012242764B40D", "target": "Wydaje mi się, że Pepoane naprawdę nie pamięta Namikki." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_KRILE_000_036", "hash": "11C49DE405204489", "target": "Zapytajmy innych. Może pamiętają." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ERENVILLE_000_037", "hash": "0DDE4650547EAC8F", "target": "Pierwszy raz widzę coś takiego. Nawet o czymś takim nie słyszałem." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_OUTSKIRTSRESIDENTA04930_000_040", "hash": "119A8BC6F5C1FAFB", "target": "Starsza pani o imieniu Namikka?" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_OUTSKIRTSRESIDENTA04930_000_041", "hash": "65356C4EE4ECF938", "target": "Niestety nic mi to nie mówi. Przykro mi, że nie mogę pomóc." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_OUTSKIRTSRESIDENTA04930_000_045", "hash": "1C7C6C7FBD1AB388", "target": "Przykro mi. Może ktoś inny będzie wiedział coś o Namikce." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_OUTSKIRTSRESIDENTB04930_000_050", "hash": "D659BD44989C52E2", "target": "Czy znam kogoś o imieniu Namikka?" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_OUTSKIRTSRESIDENTB04930_000_051", "hash": "84189B80272711AD", "target": "Nie znam nikogo o tym imieniu. Od dawna pracuję w The Outskirts. Gdyby tu bywała, na pewno coś by mi świtało." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_OUTSKIRTSRESIDENTB04930_000_055", "hash": "5744D95B776615C7", "target": "Ta Namikka pewnie trafiła już do chmury..." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_OUTSKIRTSRESIDENTC04930_000_060", "hash": "ED4574503F316AA3", "target": "Hm... Pamiętam, że jeszcze niedawno ktoś był pod moją opieką. Mówisz, że ta pani miała na imię Namikka?" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_OUTSKIRTSRESIDENTC04930_000_061", "hash": "D20F6CC217EBBB1F", "target": "Nie potrafię powiedzieć, czy to była ona, ale proszę się nie martwić. Pewnie po prostu trafiła do chmury." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_OUTSKIRTSRESIDENTC04930_000_065", "hash": "88F8EB07D75C8AE0", "target": "Rzadko się to zdarza, ale czasem tak bywa." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_WUKLAMAT_000_070", "hash": "76A618F7B6D34EA6", "target": "Czyli wszyscy mówili to samo." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_WUKLAMAT_000_071", "hash": "EB407F43929A360D", "target": "Nikt nie pamięta Namikki. Jakby ktoś po prostu wymazał ją z ich pamięci." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_KRILE_000_072", "hash": "24F4B3B42DC2FE00", "target": "Dałoby się to zrobić za pomocą magii, ale zmiana wspomnień tylu osób naraz wymagałaby ogromnego wysiłku. W dodatku taki przypływ eteru dałoby się wyczuć. A ja nic nie poczułam." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ALISAIE_000_073", "hash": "93DE1E0CB899C4B8", "target": "Ja też nic. Ale zauważyłam coś innego─lampka na urządzeniu, które Pepoane nosi na głowie, zamigała zaraz przed tym, jak przestał rozpoznawać imię Namikki." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_GRAHATIA_000_074", "hash": "BF8911447E506DD5", "target": "Może to ma ze sobą związek. Ktoś też coś mówił o „zasobnikach dusz”." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_GRAHATIA_000_075", "hash": "286490A7A2CF40F8", "target": "Tylko kto mógłby nam to wyjaśnić? Jeśli będziemy dalej tak wypytywać ludzi, pewnie narobimy tylko zamieszania." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ALISAIE_000_076", "hash": "CA4023D9C89DFDCE", "target": "Racja... Z Namikką chyba na razie niczego już nie ustalimy. Może poszukamy Cahciuy?" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ERENVILLE_000_077", "hash": "CDC6F4C263E3C530", "target": "Sphene mówiła, żeby poszukać na Gromowych Polach." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ERENVILLE_000_078", "hash": "99CD3E096930CB24", "target": "To chyba w tę stronę." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_CAHCIUA_000_079", "hash": "1D3B731A0B5A0821", "target": "(-Niezidentyfikowany obiekt unoszący się w powietrzu-)\\<łapie oddech> Niemożliwe!" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ERENVILLE_000_080", "hash": "F36CCC3F4934D032", "target": "Hm?" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_WUKLAMAT_000_081", "hash": "91F960CBF9EF453A", "target": "Co to, jakiś nowy mechaniczny żołnierz?! Wygląda groźnie! Rozwalmy go!" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_CAHCIUA_000_082", "hash": "FD73A51A3E0542D1", "target": "(-Niezidentyfikowany obiekt unoszący się w powietrzu-)Łaaa!" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_KRILE_000_083", "hash": "2B9C07FBFD76A08B", "target": "Gonimy go?" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ALISAIE_000_084", "hash": "807CB71DF75A7628", "target": "Chyba zrozumiał, co mówimy. Może warto o coś go zapytać." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ALISAIE_000_085", "hash": "29C3793E1DAB276A", "target": "...Erenville? Wszystko w porządku? Wyglądasz, jakbyś zobaczył ducha." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ERENVILLE_000_086", "hash": "9254BFC9B39F7FEB", "target": "N-Nic takiego. Nic mi nie jest." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_WUKLAMAT_000_087", "hash": "F70D12522849D922", "target": "I tak uciekł w tę samą stronę, w którą idziemy. Spróbujmy go wytropić." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_WUKLAMAT_000_090", "hash": "337F441CBA65184F", "target": "Tylko ptaki tu są." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ALISAIE_000_095", "hash": "8E72C156D1350BE7", "target": "Ale szybki ten robot!" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_KRILE_000_100", "hash": "FDCC669D3E2E4AA5", "target": "Tu go nigdzie nie ma." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_GRAHATIA_000_105", "hash": "37134E88B7AA3560", "target": "Nie widzę go..." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ERENVILLE_000_108", "hash": "53365A73CA27F6E4", "target": "Ten głos... Czy to możliwe...?" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_WUKLAMAT_000_110", "hash": "E95002F06602F15E", "target": "Udało ci się go znaleźć?!" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ERENVILLE_000_111", "hash": "78EC4283682595E7", "target": "Na północny wschód? To pewnie leci do kopalni." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_WUKLAMAT_000_112", "hash": "E567824C0329C13B", "target": "No to chodźmy!" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ALISAIE_000_113", "hash": "3D0AEF8B53B2BAC2", "target": "Może nas wciąga w pułapkę. Nie pchajmy się tam na oślep." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_WUKLAMAT_000_115", "hash": "7492E4B160153F58", "target": "Tu się schował?" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ALISAIE_000_120", "hash": "86DBB98F36DBA13D", "target": "Chyba nie ma wątpliwości, że poleciał do kopalni." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_KRILE_000_125", "hash": "DFF9135B2F425999", "target": "Stara kopalnia węgla? Tak jak tyle innych miejsc, wygląda na opuszczoną od lat." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_GRAHATIA_000_130", "hash": "4686892213FFDB2D", "target": "Te kamienie w skrzyniach... To chyba turkus?" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ERENVILLE_000_140", "hash": "99F2669B78550D50", "target": "Ze środka dobiegły mnie głosy. Bardzo ciche." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_WUKLAMAT_000_141", "hash": "F72778215E3A0080", "target": "Czyli nie jest sam. Ale wchodzimy, co?" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_WUKLAMAT_000_142", "hash": "A410B36355B6E105", "target": "Może tam być zasadzka. W razie czego szykujcie się do walki!" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_WUKLAMAT_000_145", "hash": "3B821132C812449A", "target": "Ten tunel ciągnie się i ciągnie..." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ALISAIE_000_150", "hash": "3704AF0C26400FBC", "target": "Nie martwię się. Nie pierwszy raz przyjdzie nam improwizować." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_KRILE_000_155", "hash": "40ACB8CF0759F299", "target": "Urządzenie z electrope. Chyba jedyne w całej kopalni." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_GRAHATIA_000_160", "hash": "011C1B07F4394021", "target": "Wygląda na to, że od bardzo dawna nikt tu niczego nie wydobywał..." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ERENVILLE_000_170", "hash": "8E3E69D9830F6B90", "target": "Słyszę ich. Przed nami jest kilka osób." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ERENVILLE_000_171", "hash": "AD96336CB410EEAB", "target": "Hm. Od tego echa trudno cokolwiek zrozumieć." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_WUKLAMAT_000_172", "hash": "8DA5B2DE08135E68", "target": "Idziemy dalej. Tylko miejcie się na baczności." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_WUKLAMAT_000_180", "hash": "F57FED4BA2FF7A62", "target": "Już się w tym wszystkim gubię. Ale dobrze, że Cahciua jest cała." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ALISAIE_000_185", "hash": "5FA3713415D309FD", "target": "Matka Erenville to latająca maszyna. Jasne─to równie sensowne jak cała reszta." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_KRILE_000_190", "hash": "E7527FFF649B7C11", "target": "Chyba nic mnie już nie zaskoczy." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_GRAHATIA_000_195", "hash": "D2DB65B3447BBBC7", "target": "Allagańczycy mieli maszyny sterowane zdalnie. Czy ona też tak się z nami porozumiewa?" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_GEODE_000_200", "hash": "C2DA09F5AD6029AE", "target": "Z nią zawsze muszą być jakieś przygody... Wybaczcie, że chwyciliśmy za broń." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_NOSTALGIA_000_205", "hash": "72AF1E28F1A52E7B", "target": "Jeśli ma was to pocieszyć, my też nie bardzo wiemy, co tu się dzieje." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_WAYAKKWE_000_210", "hash": "4C4DE322FF01C9AF", "target": "O, eee... Cześć." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_CAHCIUA_000_215", "hash": "910D3B31D56D999C", "target": "No już, rozgośćcie się!" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ERENVILLE_000_220", "hash": "268B46596B7FEAD2", "target": "Wygląda na to, że to naprawdę moja matka. Mało kto ma tyle werwy..." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ERENVILLE_000_221", "hash": "E5B70BE407BFEA5C", "target": "Ale co tu się stało, dowiemy się tylko od niej..." }
  ]
}
