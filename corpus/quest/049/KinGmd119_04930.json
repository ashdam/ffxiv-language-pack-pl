{
  "conversation": "quest/049/KinGmd119_04930",
  "gameVersion": "2026.09.15.0000.0000",
  "entries": [
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_SEQ_00", "hash": "C6DFBBF18B0C7D1B", "target": "Sphene chce zabrać cię z powrotem do osady outskirts." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_TODO_00", "hash": "F47D7A6FB6A61DA2", "target": "Porozmawiać z postacią Wuk Lamat" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_TODO_01", "hash": "C1C77551FAF864CF", "target": "Ponownie porozmawiać z postacią Wuk Lamat" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_TODO_02", "hash": "589DF18F5BA6FA8C", "target": "Porozmawiać z mieszkańcami osady outskirts" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_TODO_03", "hash": "FC91035468A1EFC4", "target": "Zaczekać w wyznaczonym miejscu" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_TODO_04", "hash": "73669EBE32765892", "target": "Zbadać wyznaczone miejsce" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_TODO_05", "hash": "21B33A26C2575F0A", "target": "Porozmawiać z postacią Erenville" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_TODO_06", "hash": "DD76829BAB93E9AB", "target": "Ponownie porozmawiać z postacią Erenville" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_TODO_07", "hash": "1E89DA1553A4114B", "target": "Ponownie porozmawiać z postacią Erenville" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_TODO_08", "hash": "A875AD082474E08A", "target": "Porozmawiać z postacią Erenville w kryjówce Earthen Sky" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_WUKLAMAT_000_001", "hash": "60247F35B647A270", "target": "Zoraal Ja, ty draniu..." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_SPHENE_000_010", "hash": "B1AE6A10D4ADFAE7", "target": "Może wrócimy do osady outskirts? Sądzę, że wasi przyjaciele też już wrócili." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_MAHUWSA_000_011", "hash": "26C36AE2671C0FBA", "target": "Jeszcze raz dziękuję za pozbycie się potworów. Odwiedzajcie nas, kiedy tylko chcecie." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_WUKLAMAT_000_015", "hash": "0E784544CCD3109F", "target": "...Słyszysz to?" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_SPHENE_000_020", "hash": "6836547F3A623E26", "target": "Jest tyle miejsc w Alexandrii, które chciałabym wam pokazać!" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_MAHUWSA_000_025", "hash": "466E22E701C32C09", "target": "Jak wszyscy, bardzo podziwiam i szanuję królową Sphene. Ale trochę niezręcznie mówić jej to prosto w twarz..." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_WUKLAMAT_000_030", "hash": "0181ED5EF2D7553F", "target": "Co się dzieje? Jak Pepoane mógł nagle zapomnieć o Namikce?" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_WUKLAMAT_000_031", "hash": "4693B30925982B41", "target": "Zupełnie jakby nigdy jej nie znał..." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ALISAIE_000_032", "hash": "48E62BEE6CA790AD", "target": "Ciekawe, czy to samo mogło spotkać innych." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_KRILE_000_033", "hash": "2847A2BA87D9DB82", "target": "Możemy to sprawdzić tylko w jeden sposób. Popytajmy w okolicy o Namikkę. Potem spotkajmy się przy eterycie." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ALISAIE_000_034", "hash": "1F7F3F4225AA2358", "target": "To bardzo niepokojące..." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_GRAHATIA_000_035", "hash": "3E4012242764B40D", "target": "Z tego, co zauważyłem, Pepoane naprawdę nie pamiętał Namikki." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_KRILE_000_036", "hash": "11C49DE405204489", "target": "Zobaczymy, jak jest z innymi." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ERENVILLE_000_037", "hash": "0DDE4650547EAC8F", "target": "Nigdy nie widziałem niczego podobnego ani o czymś takim nie słyszałem." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_OUTSKIRTSRESIDENTA04930_000_040", "hash": "119A8BC6F5C1FAFB", "target": "Starsza kobieta o imieniu Namikka?" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_OUTSKIRTSRESIDENTA04930_000_041", "hash": "65356C4EE4ECF938", "target": "Niestety nie znam tej osoby. Przykro mi, że nie mogę pomóc." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_OUTSKIRTSRESIDENTA04930_000_045", "hash": "1C7C6C7FBD1AB388", "target": "Przykro mi. Może ktoś inny zna tę Namikkę." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_OUTSKIRTSRESIDENTB04930_000_050", "hash": "D659BD44989C52E2", "target": "Co takiego? Czy znam jakąś Namikkę?" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_OUTSKIRTSRESIDENTB04930_000_051", "hash": "84189B80272711AD", "target": "Nie znam nikogo o tym imieniu, a od dawna pracuję w osadzie outskirts. Gdyby spędzała tu czas, na pewno zapadłaby mi w pamięć." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_OUTSKIRTSRESIDENTB04930_000_055", "hash": "5744D95B776615C7", "target": "Zapewne ta Namikka jest teraz w chmurze..." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_OUTSKIRTSRESIDENTC04930_000_060", "hash": "ED4574503F316AA3", "target": "Hmm... Pamiętam, że do niedawna ktoś był pod moją opieką. I to była kobieta o imieniu Namikka?" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_OUTSKIRTSRESIDENTC04930_000_061", "hash": "D20F6CC217EBBB1F", "target": "Nie wiem na pewno, czy to była ona, ale proszę się nie martwić. Na pewno została po prostu zabrana do chmury." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_OUTSKIRTSRESIDENTC04930_000_065", "hash": "88F8EB07D75C8AE0", "target": "To rzadkie, ale od czasu do czasu się zdarza." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_WUKLAMAT_000_070", "hash": "76A618F7B6D34EA6", "target": "A więc ze wszystkimi było tak samo." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_WUKLAMAT_000_071", "hash": "EB407F43929A360D", "target": "Nikt nie pamięta Namikki. Jakby wspomnienia o niej zostały usunięte z ich umysłów." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_KRILE_000_072", "hash": "24F4B3B42DC2FE00", "target": "Można to zrobić magią, ale zmiana wspomnień tylu osób naraz byłaby olbrzymim przedsięwzięciem. Poczulibyśmy też odpowiadający mu przypływ eteru, a ja niczego wtedy nie wyczułam." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ALISAIE_000_073", "hash": "93DE1E0CB899C4B8", "target": "Ja też nie. Ale zauważyłam coś innego─tuż przed tym, jak Pepoane najwyraźniej zapomniał, zaczęła migać lampka w urządzeniu na jego głowie." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_GRAHATIA_000_074", "hash": "BF8911447E506DD5", "target": "Czy to może mieć związek? Ktoś wspomniał też o „zasobnikach dusz”." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_GRAHATIA_000_075", "hash": "286490A7A2CF40F8", "target": "Ale kogo możemy o to zapytać? Jeśli będziemy dalej zadawać takie pytania, pewnie wywołamy tylko zamieszanie." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ALISAIE_000_076", "hash": "CA4023D9C89DFDCE", "target": "Racja... Skoro nie potrafimy na razie rozwikłać zagadki Namikki, może poszukamy Cahciuy?" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ERENVILLE_000_077", "hash": "CDC6F4C263E3C530", "target": "Sphene powiedziała, żebyśmy spróbowali w zakładach Thunderyards." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ERENVILLE_000_078", "hash": "99CD3E096930CB24", "target": "To powinno być w tę stronę." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_CAHCIUA_000_079", "hash": "E1E3976D0D83D5C9", "target": "\\<łapie oddech> Niemożliwe!" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ERENVILLE_000_080", "hash": "F36CCC3F4934D032", "target": "Hm?" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_WUKLAMAT_000_081", "hash": "91F960CBF9EF453A", "target": "Kolejny rodzaj mechanicznego żołnierza!? Wygląda groźnie! Lepiej go zniszczyć!" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_CAHCIUA_000_082", "hash": "E430ACF1C40362FC", "target": "Łaaa!" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_KRILE_000_083", "hash": "2B9C07FBFD76A08B", "target": "Ruszyć w pościg?" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ALISAIE_000_084", "hash": "807CB71DF75A7628", "target": "Chyba zrozumiał nasze słowa. Może warto zadać mu kilka pytań." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ALISAIE_000_085", "hash": "29C3793E1DAB276A", "target": "...Erenville? Wszystko dobrze? Wyglądasz, jakbyś zobaczył ducha." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ERENVILLE_000_086", "hash": "9254BFC9B39F7FEB", "target": "T-to nic. Nic mi nie jest." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_WUKLAMAT_000_087", "hash": "F70D12522849D922", "target": "I tak uciekł w kierunku, w którym idziemy, więc spróbujmy go wytropić." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_WUKLAMAT_000_090", "hash": "337F441CBA65184F", "target": "Tutaj są tylko ptaki." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ALISAIE_000_095", "hash": "8E72C156D1350BE7", "target": "Jest szybszy, niż się wydaje." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_KRILE_000_100", "hash": "FDCC669D3E2E4AA5", "target": "Tutaj ani śladu." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_GRAHATIA_000_105", "hash": "37134E88B7AA3560", "target": "Nie widzę go..." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ERENVILLE_000_108", "hash": "53365A73CA27F6E4", "target": "Ten głos... Czy to możliwe...?" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_WUKLAMAT_000_110", "hash": "E95002F06602F15E", "target": "Udało ci się go znaleźć!?" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ERENVILLE_000_111", "hash": "78EC4283682595E7", "target": "Na północny wschód? W takim razie pewnie zmierza do kopalń." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_WUKLAMAT_000_112", "hash": "E567824C0329C13B", "target": "No to chodźmy!" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ALISAIE_000_113", "hash": "3D0AEF8B53B2BAC2", "target": "To może być pułapka, więc nie rzucajmy się tam pochopnie." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_WUKLAMAT_000_115", "hash": "7492E4B160153F58", "target": "Czyli wszedł tutaj?" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ALISAIE_000_120", "hash": "86DBB98F36DBA13D", "target": "Myślę, że możemy założyć, że wszedł do kopalń." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_KRILE_000_125", "hash": "DFF9135B2F425999", "target": "Stara kopalnia węgla? Wygląda na dawno opuszczoną, jak tyle innych miejsc." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_GRAHATIA_000_130", "hash": "4686892213FFDB2D", "target": "Te kamienie w skrzyniach... Czy to turkus?" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ERENVILLE_000_140", "hash": "99F2669B78550D50", "target": "Słyszałem ciche głosy dochodzące ze środka." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_WUKLAMAT_000_141", "hash": "F72778215E3A0080", "target": "Czyli nie jest sam. Ale i tak wchodzimy, oczywiście?" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_WUKLAMAT_000_142", "hash": "A410B36355B6E105", "target": "To może być pułapka. Wszyscy bądźcie gotowi do walki!" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_WUKLAMAT_000_145", "hash": "3B821132C812449A", "target": "Ten tunel chyba nie ma końca..." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ALISAIE_000_150", "hash": "3704AF0C26400FBC", "target": "Nie martwię się. W końcu już nieraz musieliśmy improwizować." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_KRILE_000_155", "hash": "40ACB8CF0759F299", "target": "Urządzenie z materiału electrope. Chyba jedyne tutaj." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_GRAHATIA_000_160", "hash": "011C1B07F4394021", "target": "Wygląda na to, że od dawna nikt nie pracował w tych tunelach..." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ERENVILLE_000_170", "hash": "8E3E69D9830F6B90", "target": "Słyszę ich. Kilka osób przed nami." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ERENVILLE_000_171", "hash": "AD96336CB410EEAB", "target": "Hmm. Przez echo nie mogę zrozumieć, o czym mówią." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_WUKLAMAT_000_172", "hash": "8DA5B2DE08135E68", "target": "Idziemy dalej. Miejcie się na baczności." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_WUKLAMAT_000_180", "hash": "F57FED4BA2FF7A62", "target": "Nie mogę powiedzieć, że rozumiem, co się dzieje, ale przynajmniej Cahciua jest bezpieczna." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ALISAIE_000_185", "hash": "5FA3713415D309FD", "target": "Matka Erenville jest latającą maszyną. Jasne─to ma tyle samo sensu co wszystko inne do tej pory." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_KRILE_000_190", "hash": "E7527FFF649B7C11", "target": "Chyba już nic nie mogłoby mnie zaskoczyć." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_GRAHATIA_000_195", "hash": "D2DB65B3447BBBC7", "target": "Allaganie mieli maszyny sterowane zdalnie. Czy używa czegoś podobnego, żeby się z nami porozumiewać?" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_GEODE_000_200", "hash": "C2DA09F5AD6029AE", "target": "Z nią zawsze za dużo emocji... Wybaczcie, że dobyliśmy broni." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_NOSTALGIA_000_205", "hash": "72AF1E28F1A52E7B", "target": "Jeśli to was pocieszy, my też niewiele z tego rozumiemy." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_WAYAKKWE_000_210", "hash": "4C4DE322FF01C9AF", "target": "Och, eee... cześć." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_CAHCIUA_000_215", "hash": "910D3B31D56D999C", "target": "No, no, rozgośćcie się!" },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ERENVILLE_000_220", "hash": "268B46596B7FEAD2", "target": "Z tego, co widzę, to rzeczywiście moja matka. Mało kto na świecie ma tyle werwy..." },
    { "gameKey": "quest/049/KinGmd119_04930#TEXT_KINGMD119_04930_ERENVILLE_000_221", "hash": "E5B70BE407BFEA5C", "target": "Ale o to, co się stało, musimy zapytać ją samą..." }
  ]
}
