{
  "conversation": "quest/040/LucKmj104_04010",
  "gameVersion": "2026.09.15.0000.0000",
  "entries": [
    { "gameKey": "quest/040/LucKmj104_04010#TEXT_LUCKMJ104_04010_SEQ_00", "hash": "883ED9423E6AE222", "target": "Alisaie myśli tylko o jednym." },
    { "gameKey": "quest/040/LucKmj104_04010#TEXT_LUCKMJ104_04010_TODO_00", "hash": "F13B2B8B0BEAF143", "target": "Porozmawiać z Alisaie w Dowództwie Maelstromu" },
    { "gameKey": "quest/040/LucKmj104_04010#TEXT_LUCKMJ104_04010_TODO_01", "hash": "866335DC27985793", "target": "Porozmawiać z uczonym Alphinaud" },
    { "gameKey": "quest/040/LucKmj104_04010#TEXT_LUCKMJ104_04010_GRAHATIA_100_000", "hash": "6227A20A77DD5F3C", "target": "Niestety załoga Kuźni nie mogła zostać dłużej─mają zbyt wiele do zrobienia. Choć spędziliśmy razem niewiele czasu, <italic(1)>cholernie<italic(0)> dobrze było ich zobaczyć!" },
    { "gameKey": "quest/040/LucKmj104_04010#TEXT_LUCKMJ104_04010_ALISAIE_000_000", "hash": "374BC9E0946FC7C8", "target": "Nareszcie mamy lekarstwo..." },
    { "gameKey": "quest/040/LucKmj104_04010#TEXT_LUCKMJ104_04010_GRAHATIA_100_001", "hash": "EBDEFCDE92D5EDB8", "target": "Przynajmniej w teorii. Nie będziemy pewni, póki go nie wypróbujemy, ale mam cichą nadzieję, że zadziała." },
    { "gameKey": "quest/040/LucKmj104_04010#TEXT_LUCKMJ104_04010_ALISAIE_100_002", "hash": "BFA353A6629C5FAB", "target": "Jeśli mamy je na kimś wypróbować, proponuję Ga Bu. Jego objawy są stosunkowo łagodne." },
    { "gameKey": "quest/040/LucKmj104_04010#TEXT_LUCKMJ104_04010_Q1_000_000", "hash": "4C8A026138C40536", "target": "Co powiesz?" },
    { "gameKey": "quest/040/LucKmj104_04010#TEXT_LUCKMJ104_04010_A1_000_001", "hash": "CDAA413180DBB072", "target": "Na pewno wszystko będzie dobrze." },
    { "gameKey": "quest/040/LucKmj104_04010#TEXT_LUCKMJ104_04010_A1_000_002", "hash": "5F0DA27D82B0FCB4", "target": "Pod warunkiem, że zachowasz ostrożność..." },
    { "gameKey": "quest/040/LucKmj104_04010#TEXT_LUCKMJ104_04010_ALISAIE_100_003", "hash": "B5A188F4E885C6BA", "target": "Tak. Jeśli zachowamy ostrożność, wszystko będzie dobrze." },
    { "gameKey": "quest/040/LucKmj104_04010#TEXT_LUCKMJ104_04010_ALISAIE_100_004", "hash": "0D8580A00BEF8142", "target": "Nie zwlekajmy więc i ruszajmy do Limsy. Ga Bu czekał już wystarczająco długo!" },
    { "gameKey": "quest/040/LucKmj104_04010#TEXT_LUCKMJ104_04010_KRILE_000_010", "hash": "12E6F5BACF8631BA", "target": "Wątpię, bym mogła pomóc w następnym etapie, więc będę wam kibicować z daleka. Powodzenia przy leczeniu." },
    { "gameKey": "quest/040/LucKmj104_04010#TEXT_LUCKMJ104_04010_TATARU_000_011", "hash": "4B46320B38E3E380", "target": "Wszyscy będziemy modlić się o powodzenie!" },
    { "gameKey": "quest/040/LucKmj104_04010#TEXT_LUCKMJ104_04010_GRAHATIA_000_012", "hash": "376E752FBDAA6B93", "target": "Widać, że Ga Bu jest Alisaie bardzo drogi. Zrobię wszystko, co w mojej mocy, by pomóc mu wrócić do siebie." },
    { "gameKey": "quest/040/LucKmj104_04010#TEXT_LUCKMJ104_04010_ALISAIE_000_013", "hash": "44AEEFB5EDC24FB9", "target": "Nadeszła chwila próby. Poproszę naszych gospodarzy, żeby przyprowadzili Ga Bu." },
    { "gameKey": "quest/040/LucKmj104_04010#TEXT_LUCKMJ104_04010_YSHTOLA_000_014", "hash": "21A50529D31F8AC1", "target": "Alisaie się uda. Jestem tego pewna. Musimy tylko jej zaufać." },
    { "gameKey": "quest/040/LucKmj104_04010#TEXT_LUCKMJ104_04010_ALPHINAUD_000_015", "hash": "80B2CA6C2C628785", "target": "Cóż, to miejsce wydaje się równie dobre jak każde inne, żeby odpocząć." }
  ]
}
