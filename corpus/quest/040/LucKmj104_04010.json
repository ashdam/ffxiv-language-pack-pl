{
  "conversation": "quest/040/LucKmj104_04010",
  "gameVersion": "2026.11.03.0000.0000",
  "entries": [
    { "gameKey": "quest/040/LucKmj104_04010#TEXT_LUCKMJ104_04010_SEQ_00", "hash": "883ED9423E6AE222", "target": "Alisaie ma teraz w głowie tylko jedną rzecz." },
    { "gameKey": "quest/040/LucKmj104_04010#TEXT_LUCKMJ104_04010_TODO_00", "hash": "F13B2B8B0BEAF143", "target": "Porozmawiać z Alisaie w Dowództwie Maelstromu" },
    { "gameKey": "quest/040/LucKmj104_04010#TEXT_LUCKMJ104_04010_TODO_01", "hash": "866335DC27985793", "target": "Porozmawiać z Alphinaudem" },
    { "gameKey": "quest/040/LucKmj104_04010#TEXT_LUCKMJ104_04010_GRAHATIA_100_000", "hash": "6227A20A77DD5F3C", "target": "Ludzie z Kuźni nie mogli dłużej zostać, mają za dużo roboty. Krótko się widzieliśmy, ale <italic(1)>cholernie<italic(0)> dobrze było ich zobaczyć!" },
    { "gameKey": "quest/040/LucKmj104_04010#TEXT_LUCKMJ104_04010_ALISAIE_000_000", "hash": "374BC9E0946FC7C8", "target": "Nareszcie mamy lekarstwo..." },
    { "gameKey": "quest/040/LucKmj104_04010#TEXT_LUCKMJ104_04010_GRAHATIA_100_001", "hash": "EBDEFCDE92D5EDB8", "target": "Na razie na papierze. Pewność będziemy mieli dopiero po próbie, ale myślę, że się uda." },
    { "gameKey": "quest/040/LucKmj104_04010#TEXT_LUCKMJ104_04010_ALISAIE_100_002", "hash": "BFA353A6629C5FAB", "target": "To może najpierw spróbujmy pomóc Ga Bu. Objawy nie są u niego tak silne jak u innych zniewolonych." },
    { "gameKey": "quest/040/LucKmj104_04010#TEXT_LUCKMJ104_04010_Q1_000_000", "hash": "4C8A026138C40536", "target": "Co powiesz?" },
    { "gameKey": "quest/040/LucKmj104_04010#TEXT_LUCKMJ104_04010_A1_000_001", "hash": "CDAA413180DBB072", "target": "Na pewno wszystko będzie dobrze." },
    { "gameKey": "quest/040/LucKmj104_04010#TEXT_LUCKMJ104_04010_A1_000_002", "hash": "5F0DA27D82B0FCB4", "target": "Tylko bądź ostrożna..." },
    { "gameKey": "quest/040/LucKmj104_04010#TEXT_LUCKMJ104_04010_ALISAIE_100_003", "hash": "B5A188F4E885C6BA", "target": "Tak. Jeśli zachowamy ostrożność, wszystko będzie dobrze." },
    { "gameKey": "quest/040/LucKmj104_04010#TEXT_LUCKMJ104_04010_ALISAIE_100_004", "hash": "0D8580A00BEF8142", "target": "To w drogę do Limsy. Ga Bu i tak już za długo czekał!" },
    { "gameKey": "quest/040/LucKmj104_04010#TEXT_LUCKMJ104_04010_KRILE_000_010", "hash": "12E6F5BACF8631BA", "target": "Przy leczeniu chyba już na niewiele się przydam, ale będę trzymała za was kciuki. Powodzenia!" },
    { "gameKey": "quest/040/LucKmj104_04010#TEXT_LUCKMJ104_04010_TATARU_000_011", "hash": "4B46320B38E3E380", "target": "Wszyscy będziemy modlić się o powodzenie!" },
    { "gameKey": "quest/040/LucKmj104_04010#TEXT_LUCKMJ104_04010_GRAHATIA_000_012", "hash": "376E752FBDAA6B93", "target": "Widać, jak bardzo Alisaie zależy na Ga Bu. Zrobię, co w mojej mocy, żeby pomóc mu wrócić do zdrowia." },
    { "gameKey": "quest/040/LucKmj104_04010#TEXT_LUCKMJ104_04010_ALISAIE_000_013", "hash": "44AEEFB5EDC24FB9", "target": "No, teraz się okaże. Poproszę, by od razu przyprowadzili Ga Bu." },
    { "gameKey": "quest/040/LucKmj104_04010#TEXT_LUCKMJ104_04010_YSHTOLA_000_014", "hash": "21A50529D31F8AC1", "target": "Jestem pewna, że Alisaie sobie poradzi. Pozostaje nam jej zaufać." },
    { "gameKey": "quest/040/LucKmj104_04010#TEXT_LUCKMJ104_04010_ALPHINAUD_000_015", "hash": "80B2CA6C2C628785", "target": "Cóż, możemy odpocząć i tutaj." }
  ]
}
