  "conversation": "quest/042/AktKzh003_04298",
  "gameVersion": "2026.11.03.0000.0000",
  "entries": [
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_SEQ_00", "hash": "496E6C6F841F82CC", "target": "<colortype(508)><edgecolortype(509)> Synchronizacja zadania<edgecolortype(0)><colortype(0)><br>Spokojny obserwator od dłuższej chwili czeka na kolegę." },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_TODO_00", "hash": "69339135B9F7B01F", "target": "Porozmawiać z obserwatorem Thalassai" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_TODO_01", "hash": "6DF6B5CDB3A64E3E", "target": "Nakarmić stworzenia Zephyros 72" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_TODO_02", "hash": "D224459EEB652FB6", "target": "Zanieść osobniki Zephyros 72 obserwatorowi Thalassai" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_TODO_03", "hash": "D7760AB601EFB269", "target": "Porozmawiać z obserwatorem Thalassai" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERA04298_000_000", "hash": "3DEBAC09B7C261E2", "target": "Mogę cię prosić o przysługę? Mój kolega z Metabaseos Thalassai miał tu wrócić zdać raport. Przyda się ktoś, kto mu o tym przypomni." },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERA04298_000_001", "hash": "4A21DACAE9F47D96", "target": "Obserwuje na Ścieżce Rozmyślań młode, które właśnie wykluły się z jaj. Gdybym tam poszedł, mógłbym je wystraszyć i zakłócić obserwacje." },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERA04298_000_002", "hash": "86392E3DDEC8E887", "target": "Chowaniec taki jak ty pewnie nie narobi tyle zamieszania. Pomożesz mi?" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERA04298_000_003", "hash": "41EAA6896D07D9DE", "target": "Mojego kolegę znajdziesz na Ścieżce Rozmyślań." },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_JUVENILEA04298_100_001", "hash": "F9EB9CAC8698E448", "target": "\\<szeleści>" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_JUVENILEB04298_100_002", "hash": "88056B9D7CAED8AD", "target": "\\<szeleści> ...?" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_JUVENILEC04298_100_003", "hash": "94A5200B91E37971", "target": "\\<szeleści> \\<szeleści>" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_JUVENILED04298_100_004", "hash": "C725F749203CEBFB", "target": "\\<szeleści>" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERB04298_000_004", "hash": "2A9F571C8688B8C8", "target": "O, chowaniec. W czym mogę ci pomóc?" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERB04298_000_005", "hash": "3EA79F3B49CCE862", "target": "Ach, już pora wracać? Tak się zapatrzyłem na te harcujące maluchy, że zupełnie zapomniałem o czasie." },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERB04298_000_006", "hash": "5432E9271E361FAB", "target": "No, chodźcie do mnie, maluchy! Naprawdę musimy już wracać!" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERB04298_000_007", "hash": "CD43FD10446E25CE", "target": "(-Zephyros 72-)\\<szeleści>" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERB04298_000_008", "hash": "B1C8FC143772BF55", "target": "Jeszcze się nie wybawiłyście? No to może przekonam was czymś do jedzenia!" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERB04298_000_009", "hash": "E23D52B11BCA3032", "target": "Chcesz spróbować je nakarmić?" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERB04298_000_010", "hash": "4E91437CDF273E3D", "target": "Jak zjedzą trochę tego przysmaku, łatwiej cię posłuchają. A jak one ślicznie chrupią!" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERB04298_000_011", "hash": "66DC8AE699863255", "target": "Śmiało, daj im trochę przysmaków." },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_JUVENILEA04298_000_013", "hash": "CCE92DA2253EFD15", "target": "\\<szeleści>" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_JUVENILEA04298_000_014", "hash": "2526E3C552FBC6D1", "target": "\\<szeleści> \\<szeleści>" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_JUVENILEB04298_000_015", "hash": "B0A406E62A0AA480", "target": "\\<szeleści> ...?" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_JUVENILEB04298_000_016", "hash": "933FE6FF9EB8E90F", "target": "\\<szeleści> \\<szeleści>" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_JUVENILEC04298_000_017", "hash": "89A9CAE82C770FA3", "target": "\\<szeleści> ..." },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_JUVENILEC04298_000_018", "hash": "906DB950652B7D8F", "target": "\\<szeleści> \\<szeleści>" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_JUVENILED04298_000_019", "hash": "165A00AEB4C47038", "target": "\\<szeleści>" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_JUVENILED04298_000_020", "hash": "CAFD7EAD20738C76", "target": "\\<szeleści> \\<szeleści>" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERB04298_000_021", "hash": "2511DF47594EFDFD", "target": "Można na nie patrzeć godzinami, prawda?" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERB04298_000_022", "hash": "1261CDC68AC48140", "target": "Chyba naprawdę cię polubiły! Masz już wprawę w opiekowaniu się takimi maluchami?" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERB04298_000_023", "hash": "F2CDC643184740DF", "target": "Z natury żyją w wodzie, ale próbujemy je tak zmienić, żeby poradziły sobie również na lądzie." },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERB04298_000_024", "hash": "215F5F63CDA810F0", "target": "Żywią się głównie owadami wodnymi i skorupiakami. Same zaś padają łupem większych drapieżników." },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERB04298_000_025", "hash": "1EDE0182F8693F90", "target": "A jaja noszą na grzbiecie, aż wyklują się młode. Fascynujące, prawda?" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERB04298_000_026", "hash": "9E0DA2B04C0487E2", "target": "Ach, ale przecież nie po to tu jesteś! Naprawdę muszę wracać!" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERA04298_000_027", "hash": "F48B8CECB8F532CC", "target": "O, już jesteście. Dziękuję za sprowadzenie kolegi." },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERB04298_000_028", "hash": "EF95E8EFA741D64A", "target": "Gdyby nie ty, pewnie siedziałbym tam jeszcze przez parę dni." },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERB04298_000_029", "hash": "57C5380D6DDDFA14", "target": "Myślę, że to tylko kwestia czasu, aż dostaniemy zgodę na wypuszczenie ich na wolność. Ciekawe, jak je nazwą..." },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERA04298_000_030", "hash": "398BD7435BCEA504", "target": "Bardzo dziękuję za dzisiejszą pomoc. Weź, proszę, ten drobiazg." }
  ]
}
