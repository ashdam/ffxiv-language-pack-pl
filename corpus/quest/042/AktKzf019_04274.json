{
  "conversation": "quest/042/AktKzf019_04274",
  "gameVersion": "2026.11.03.0000.0000",
  "entries": [
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_SEQ_00", "hash": "EE8FF798C3115549", "target": "<colortype(508)><edgecolortype(509)> Synchronizacja zadania<edgecolortype(0)><colortype(0)><br>Vishrahd spogląda na ciebie niecierpliwie." },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_TODO_00", "hash": "925590608A0CF6E8", "target": "Daj każdej hamsie odpowiednią paszę." },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_TODO_01", "hash": "88D9BF27861E8916", "target": "Porozmawiaj z Vishrahdem." },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_VISHRAHD_000_001", "hash": "246F753995A156D5", "target": "A, to ty na zastępstwo do hams? Czemu tak późno?! Już parę dzwonów temu miały dostać paszę! Głodna hamsa to głośna hamsa, słyszysz przecież." },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_VISHRAHD_000_002", "hash": "69CBB4B041F84419", "target": "Co tak stoisz? Chcesz, żeby te biedactwa padły z głodu? Do roboty! Raz, dwa!" },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_VISHRAHD_000_003", "hash": "25ECE9300F18AF51", "target": "Masz dwa worki na paszę, mały i duży. Hamsy jedzą co innego, zależnie od wielkości. Do tego są wybredne." },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_VISHRAHD_000_004", "hash": "ADE109A56A8382BC", "target": "Małym wystarczy zielenina i zboże. Dużym dorzuć jeszcze poczwarki jedwabników, żeby miały więcej białka. Worki ze składnikami leżą obok drewnianej skrzyni. No, ruszaj!" },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_VISHRAHD_000_005", "hash": "3F7AA3CB24123A95", "target": "Ile razy mam powtarzać? Małym dajesz tylko zieleninę i zboże, dużym jeszcze jedwabniki. Wszystko leży przy skrzyni. No już, raz, dwa!" },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_Q1_000_000", "hash": "14709A74327A74E7", "target": "Do którego worka wsypiesz zboże?" },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_A1_000_001", "hash": "539BEED12DEE7D44", "target": "Do małego worka na paszę." },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_A1_000_002", "hash": "23A979C9B275B892", "target": "Do dużego worka na paszę." },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_A1_000_003", "hash": "7EB1B7C41F462108", "target": "Do żadnego." },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_Q2_000_000", "hash": "4626E444874DA7D5", "target": "Do którego worka wsypiesz jedwabniki?" },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_A2_000_001", "hash": "8EFF1833D8A3BB24", "target": "Do małego worka na paszę." },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_A2_000_002", "hash": "8834114CE8BDD60A", "target": "Do dużego worka na paszę." },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_A2_000_003", "hash": "32F0175BE1B08422", "target": "Do żadnego." },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_Q3_000_000", "hash": "41ABCF0A8588A39D", "target": "Do którego worka włożysz zieleninę?" },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_A3_000_001", "hash": "DE8EBC16A09039F5", "target": "Do małego worka na paszę." },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_A3_000_002", "hash": "7D4AB7825326D213", "target": "Do dużego worka na paszę." },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_A3_000_003", "hash": "3A531EA8EFC17C4A", "target": "Do żadnego." },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_Q4_000_000", "hash": "292785243B886763", "target": "Wyrzucić zawartość worka na paszę?" },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_A4_000_001", "hash": "0686397A6AD21CED", "target": "Opróżnić mały worek na paszę." },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_A4_000_002", "hash": "1B68394940218EB6", "target": "Opróżnić duży worek na paszę." },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_A4_000_003", "hash": "E61A75A0FF5DC8FC", "target": "Zostawić zawartość worków." },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_04214_Q5_000_000", "hash": "BFBF34A0F77EE82E", "target": "Na pewno chcesz wyrzucić zawartość tego worka?" },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_SYSTEM_100_006", "hash": "59815E2DE089B815", "target": "W tym worku jest już ten składnik." },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_SYSTEM_200_006", "hash": "1D18A595F61A7C60", "target": "Wrzucasz paszę do worka." },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_SYSMES_000_006", "hash": "2ACFC9F13E16C7E4", "target": "Hamsa trzepocze skrzydłami. Na widok jedzenia aż jej się oczy świecą!" },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_SYSMES_000_007", "hash": "B5FDAE61EE704450", "target": "Hamsa odwraca się od worka i patrzy w niebo, jakby opuścili ją bogowie. Chyba coś nie gra z tą mieszanką." },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_SYSTEM_100_007", "hash": "B5EEB9372CB66FAB", "target": "Najedzona hamsa patrzy przed siebie z błogim spokojem." },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_SYSTEM_200_007", "hash": "E14E6669D68CFD40", "target": "Hamsa patrzy na ciebie wyczekująco..." },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_VISHRAHD_000_008", "hash": "A0574CBFF696F902", "target": "Już po wszystkim? Może jednak coś z ciebie będzie. Na następne karmienie się nie spóźnij. Eee, jak ci na imię?" },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_VISHRAHD_000_009", "hash": "BC4F7EA20DFE6280", "target": "<split(<string(gstr1)>, ,1)>? Chwila, chyba nie... <italic(1)><if(gnum4,Ta,Ten)><italic(0)> <split(<string(gstr1)>, ,1)>?! To ty <if(gnum4,uratowałaś,uratowałeś)> Matsyę przed bestiami?!" },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_VISHRAHD_000_010", "hash": "09B47AE868D46C48", "target": "Najmocniej przepraszam! Nawet mi do głowy nie przyszło, że spotkam <if(gnum4,taką bohaterkę,takiego bohatera)> i każę karmić hamsy! Na bogów, pewnie spiekłem buraka..." },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_VISHRAHD_000_011", "hash": "4E1827F79A425605", "target": "Eee... W każdym razie dobra robota. To twoja zapłata za dzisiaj. A ja chyba jednak pójdę poszukać <italic(1)>prawdziwego<italic(0)> zastępcy." }
  ]
}
