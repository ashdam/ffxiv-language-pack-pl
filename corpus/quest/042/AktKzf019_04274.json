{
  "conversation": "quest/042/AktKzf019_04274",
  "gameVersion": "2026.10.16.0000.0000",
  "entries": [
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_SEQ_00", "hash": "EE8FF798C3115549", "target": "<colortype(508)><edgecolortype(509)>\uE0BE Synchronizacja zadania<edgecolortype(0)><colortype(0)><br>Vishrahd patrzy na ciebie niecierpliwie." },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_TODO_00", "hash": "925590608A0CF6E8", "target": "Dać hamsom odpowiednią karmę" },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_TODO_01", "hash": "88D9BF27861E8916", "target": "Porozmawiać z Vishrahdem" },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_VISHRAHD_000_001", "hash": "246F753995A156D5", "target": "To zapewne ty masz zastępować opiekuna hams. No to jesteś za późno! Karmienie miało się zacząć dzwony temu! A głodna hamsa to hałaśliwa hamsa, jak zresztą słyszysz." },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_VISHRAHD_000_002", "hash": "69CBB4B041F84419", "target": "Co tak stoisz? Pozwolisz tym biednym stworzeniom zagłodzić się na śmierć? Do roboty! Żwawo!" },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_VISHRAHD_000_003", "hash": "25ECE9300F18AF51", "target": "Masz─jeden duży worek na karmę i jeden mały. Widzisz, hamsy różnej wielkości mają różną dietę. Do tego są wybredne." },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_VISHRAHD_000_004", "hash": "ADE109A56A8382BC", "target": "Mniejszym wystarcza prosta mieszanka warzyw i ziarna. Ale nasze duże okazy potrzebują też porcji poczwarek jedwabników, żeby dostać więcej białka. Składniki leżą obok tamtej drewnianej skrzyni. No, ruszaj!" },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_VISHRAHD_000_005", "hash": "3F7AA3CB24123A95", "target": "Ile razy mam tłumaczyć? Mniejsze hamsy dostają tylko warzywa i ziarno. Większe dostają też jedwabniki. Składniki leżą przy skrzyni. No już, żwawo!" },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_Q1_000_000", "hash": "14709A74327A74E7", "target": "Do którego worka nasypiesz ziarno?" },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_A1_000_001", "hash": "539BEED12DEE7D44", "target": "Do małego worka na karmę." },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_A1_000_002", "hash": "23A979C9B275B892", "target": "Do dużego worka na karmę." },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_A1_000_003", "hash": "7EB1B7C41F462108", "target": "Do żadnego." },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_Q2_000_000", "hash": "4626E444874DA7D5", "target": "Do którego worka wsypiesz jedwabniki?" },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_A2_000_001", "hash": "8EFF1833D8A3BB24", "target": "Do małego worka na karmę." },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_A2_000_002", "hash": "8834114CE8BDD60A", "target": "Do dużego worka na karmę." },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_A2_000_003", "hash": "32F0175BE1B08422", "target": "Do żadnego." },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_Q3_000_000", "hash": "41ABCF0A8588A39D", "target": "Do którego worka wrzucisz resztki warzyw?" },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_A3_000_001", "hash": "DE8EBC16A09039F5", "target": "Do małego worka na karmę." },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_A3_000_002", "hash": "7D4AB7825326D213", "target": "Do dużego worka na karmę." },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_A3_000_003", "hash": "3A531EA8EFC17C4A", "target": "Do żadnego." },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_Q4_000_000", "hash": "292785243B886763", "target": "Wyrzucić zawartość worka na karmę?" },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_A4_000_001", "hash": "0686397A6AD21CED", "target": "Opróżnić mały worek na karmę." },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_A4_000_002", "hash": "1B68394940218EB6", "target": "Opróżnić duży worek na karmę." },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_A4_000_003", "hash": "E61A75A0FF5DC8FC", "target": "Zostawić zawartość worków." },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_04214_Q5_000_000", "hash": "BFBF34A0F77EE82E", "target": "Na pewno wyrzucić zawartość worka na karmę?" },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_SYSTEM_100_006", "hash": "59815E2DE089B815", "target": "Ten składnik jest już w worku na karmę." },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_SYSTEM_200_006", "hash": "1D18A595F61A7C60", "target": "Bezceremonialnie wrzucasz karmę do worka." },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_SYSMES_000_006", "hash": "2ACFC9F13E16C7E4", "target": "Hamsa trzepocze skrzydłami, a jej oczy rozbłyskują zachwytem nad posiłkiem!" },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_SYSMES_000_007", "hash": "B5FDAE61EE704450", "target": "Hamsa odsuwa się od worka i patrzy tępo w niebo, jakby opuścili ją bogowie. Może mieszanka karmy jest niewłaściwa?" },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_SYSTEM_100_007", "hash": "B5EEB9372CB66FAB", "target": "Hamsa z pełnym brzuchem wpatruje się z zadowoleniem w przestrzeń." },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_SYSTEM_200_007", "hash": "E14E6669D68CFD40", "target": "Hamsa patrzy na ciebie wyczekująco..." },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_VISHRAHD_000_008", "hash": "A0574CBFF696F902", "target": "Już koniec? Może nie jest z tobą tak beznadziejnie, jak się wydaje. Ale na następne karmienie lepiej się nie spóźniaj. Eee, jak ci było na imię?" },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_VISHRAHD_000_009", "hash": "BC4F7EA20DFE6280", "target": "<split(<string(gstr1)>, ,1)>? Chwileczkę, chyba nie... <italic(1)><if(gnum4,Ta,Ten)><italic(0)> <split(<string(gstr1)>, ,1)>!? To dzięki tobie udało się uratować Matsyę przed bestiami!?" },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_VISHRAHD_000_010", "hash": "09B47AE868D46C48", "target": "Najmocniej przepraszam! Nie sądziłem, że ktoś tak bohaterski będzie sobie zwyczajnie chodzić wśród nas... i jeszcze sypać karmę hamsom! Bogowie, muszę być teraz czerwony jak burak..." },
    { "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_VISHRAHD_000_011", "hash": "4E1827F79A425605", "target": "Tak czy inaczej, eee... Dziękuję za dobrze wykonaną pracę. Oto zapłata za dzisiejszy trud. A teraz lepiej poszukam <italic(1)>prawdziwego<italic(0)> zastępcy opiekuna hams." }
  ]
}
