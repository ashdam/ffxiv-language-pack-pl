{
  "conversation": "quest/018/HeaVnz522_01857",
  "gameVersion": "2026.11.03.0000.0000",
  "entries": [
    { "gameKey": "quest/018/HeaVnz522_01857#TEXT_HEAVNZ522_01857_SEQ_00", "hash": "EAEB46CA865829E9", "target": "Wyprawa moogli natrafiła na niespodziewany problem." },
    { "gameKey": "quest/018/HeaVnz522_01857#TEXT_HEAVNZ522_01857_SEQ_01", "hash": "5E2463F43D91ADBE", "target": "Z jaj porozrzucanych po ruinach Tharl Oom Khash wykluły się olbrzymie larwy (burrowing wamouracampa). Pozbądź się trzech, żeby wyprawa moogli mogła ruszyć dalej." },
    { "gameKey": "quest/018/HeaVnz522_01857#TEXT_HEAVNZ522_01857_SEQ_02", "hash": "BDD548B81AD10A9B", "target": "Larwy już nie zagrożą badaczom. Wróć do zaglądającego ukradkiem moogle'a i daj mu znać." },
    { "gameKey": "quest/018/HeaVnz522_01857#TEXT_HEAVNZ522_01857_SEQ_03", "hash": "F988A1771EC69606", "target": "Moogle dziękuje za odwagę i cieszy się, że wyprawa może ruszyć dalej." },
    { "gameKey": "quest/018/HeaVnz522_01857#TEXT_HEAVNZ522_01857_TODO_00", "hash": "9516F63D7C136D1A", "target": "Pokonaj larwy (burrowing wamouracampa)." },
    { "gameKey": "quest/018/HeaVnz522_01857#TEXT_HEAVNZ522_01857_TODO_01", "hash": "4A90F57AA47B4B6D", "target": "Zdaj sprawę zaglądającemu ukradkiem moogle'owi." },
    { "gameKey": "quest/018/HeaVnz522_01857#TEXT_HEAVNZ522_01857_GUIDEMOG01855_000_000", "hash": "0ADA8154B1C36A17", "target": "Przylecieliśmy tu obejrzeć ruiny, kupo!" },
    { "gameKey": "quest/018/HeaVnz522_01857#TEXT_HEAVNZ522_01857_FIELDTRIPMOGA01856_000_001", "hash": "90550399D4B2BBED", "target": "Hmm... Jakie to ciekawe! Niedługo podzielę się odkryciami z pozostałymi, kupo." },
    { "gameKey": "quest/018/HeaVnz522_01857#TEXT_HEAVNZ522_01857_FIELDTRIPMOGB01857_000_010", "hash": "F2C8175E80297D0D", "target": "Jak przelatywałem nad ruinami, z jaj wyłaziły straszne larwy. Nigdy czegoś takiego nie widziałem! Wypatrzyłem je w trzech miejscach. Pozbądź się ich, żebyśmy mogli ruszyć dalej, kupo!" },
    { "gameKey": "quest/018/HeaVnz522_01857#TEXT_HEAVNZ522_01857_FIELDTRIPMOGB01857_000_020", "hash": "B6DF2458A436DA64", "target": "Na widok takich paskudztw aż ciarki przechodzą! Nie ruszymy dalej, dopóki się ich nie pozbędziemy." },
    { "gameKey": "quest/018/HeaVnz522_01857#TEXT_HEAVNZ522_01857_GUIDEMOG01855_000_021", "hash": "816B41EA5FD5993A", "target": "Co za emocjonująca wyprawa, kupo!" },
    { "gameKey": "quest/018/HeaVnz522_01857#TEXT_HEAVNZ522_01857_FIELDTRIPMOGA01856_000_022", "hash": "4A764EC7B8F571F7", "target": "Tutaj nie sposób się nudzić. Zaraz opowiem reszcie, co udało mi się odkryć, kupo." },
    { "gameKey": "quest/018/HeaVnz522_01857#TEXT_HEAVNZ522_01857_GUIDEMOG01855_000_030", "hash": "94681B6E66A02E02", "target": "To dopiero była wyprawa, kupo!" },
    { "gameKey": "quest/018/HeaVnz522_01857#TEXT_HEAVNZ522_01857_FIELDTRIPMOGA01856_000_031", "hash": "D74C0E8D3FE27E72", "target": "Doprawdy fascynujące! Muszę powiedzieć pozostałym." },
    { "gameKey": "quest/018/HeaVnz522_01857#TEXT_HEAVNZ522_01857_FIELDTRIPMOGB01857_000_040", "hash": "5DCC67CD8BCFBD05", "target": "Już po tych paskudztwach? Wielkie dzięki, kupo! Teraz możemy spokojnie wrócić do zwiedzania ruin." }
  ]
}
