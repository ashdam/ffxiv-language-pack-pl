{
  "conversation": "quest/033/LucKmc117_03338",
  "gameVersion": "2026.09.15.0000.0000",
  "entries": [
    { "gameKey": "quest/033/LucKmc117_03338#TEXT_LUCKMC117_03338_SEQ_00", "hash": "C1B84E9E9300DD2F", "target": "Almet dziwnie milczy." },
    { "gameKey": "quest/033/LucKmc117_03338#TEXT_LUCKMC117_03338_TODO_00", "hash": "39174B9485BCAC69", "target": "Porozmawiać z czarodziejem Urianger" },
    { "gameKey": "quest/033/LucKmc117_03338#TEXT_LUCKMC117_03338_TODO_01", "hash": "1CDF884DC483AA6A", "target": "Podać Runarowi antidotum na truciznę" },
    { "gameKey": "quest/033/LucKmc117_03338#TEXT_LUCKMC117_03338_TODO_02", "hash": "A156CA40FA0E3333", "target": "Podać Runarowi drugą dawkę antidotum" },
    { "gameKey": "quest/033/LucKmc117_03338#TEXT_LUCKMC117_03338_TODO_03", "hash": "FCED362F57A6FE25", "target": "Podać Runarowi trzecią dawkę antidotum" },
    { "gameKey": "quest/033/LucKmc117_03338#TEXT_LUCKMC117_03338_TODO_04", "hash": "7F3C8D24EE5F7D56", "target": "Porozmawiać z czarodziejem Urianger" },
    { "gameKey": "quest/033/LucKmc117_03338#TEXT_LUCKMC117_03338_THANCRED_000_000", "hash": "B80F6ADC807FF025", "target": "..." },
    { "gameKey": "quest/033/LucKmc117_03338#TEXT_LUCKMC117_03338_RYNE_000_005", "hash": "3B538977DFB707DD", "target": "Dlaczego to zrobiła?" },
    { "gameKey": "quest/033/LucKmc117_03338#TEXT_LUCKMC117_03338_URIANGER_000_010", "hash": "E52373A72170B7B4", "target": "Ach, Y'shtolo... Gdybyśmy przybyli choć kilka kroków wcześniej." },
    { "gameKey": "quest/033/LucKmc117_03338#TEXT_LUCKMC117_03338_CYMET_000_015", "hash": "672301B297DC0915", "target": "Powinnyśmy były mocniej ich odpierać." },
    { "gameKey": "quest/033/LucKmc117_03338#TEXT_LUCKMC117_03338_THANCRED_000_020", "hash": "8962F74F36CE8416", "target": "Almet. Powiedz, że wiesz, czy ta dziura prowadzi gdzieś do lasu." },
    { "gameKey": "quest/033/LucKmc117_03338#TEXT_LUCKMC117_03338_ALMET_000_021", "hash": "10D3DB57EF97E86A", "target": "Gdyby istniało inne wyjście ze świątyni, z pewnością byśmy o nim wiedziały." },
    { "gameKey": "quest/033/LucKmc117_03338#TEXT_LUCKMC117_03338_ALMET_000_022", "hash": "76366CDD16F57E9B", "target": "Obawiam się jednak, że to bez znaczenia. Próbowałyśmy zmierzyć głębokość przepaści. Bezskutecznie." },
    { "gameKey": "quest/033/LucKmc117_03338#TEXT_LUCKMC117_03338_ALMET_000_023", "hash": "078A0E4180DCC7F0", "target": "Upadek z takiej wysokości..." },
    { "gameKey": "quest/033/LucKmc117_03338#TEXT_LUCKMC117_03338_UIMET_000_024", "hash": "A11642858937878A", "target": "Siostro! Przynoszę wieści!" },
    { "gameKey": "quest/033/LucKmc117_03338#TEXT_LUCKMC117_03338_UIMET_000_025", "hash": "AE138D08FC5E6E43", "target": "Żołnierze z Eulmore i Dzieci uciekli z Yx'Mai." },
    { "gameKey": "quest/033/LucKmc117_03338#TEXT_LUCKMC117_03338_UIMET_000_026", "hash": "5DFD77E547844D17", "target": "Opuścili też Slitherbough, choć wciąż są na bagnach w pobliżu Lakeland." },
    { "gameKey": "quest/033/LucKmc117_03338#TEXT_LUCKMC117_03338_UIMET_000_027", "hash": "AAA0279164D5F11D", "target": "Niestety, kilku Błogosławionych zostało otrutych podczas odpierania żołnierzy." },
    { "gameKey": "quest/033/LucKmc117_03338#TEXT_LUCKMC117_03338_UIMET_000_028", "hash": "6C7C57930A1833A6", "target": "Jednego z nich znalazłyśmy zagubionego w Yx'Mai, z gorączką i ciężkimi ranami." },
    { "gameKey": "quest/033/LucKmc117_03338#TEXT_LUCKMC117_03338_UIMET_000_029", "hash": "DB076274E74734C7", "target": "Zabrano go do Fanow na leczenie, lecz obawiam się, że niewiele możemy dla niego zrobić." },
    { "gameKey": "quest/033/LucKmc117_03338#TEXT_LUCKMC117_03338_UIMET_000_030", "hash": "9433B1987F10909A", "target": "Bez antidotum on i inni Błogosławieni długo nie przeżyją." },
    { "gameKey": "quest/033/LucKmc117_03338#TEXT_LUCKMC117_03338_THANCRED_000_031", "hash": "93DD8D19649D0F38", "target": "Musimy więc działać szybko. Jeśli masz zapasową fiolkę, Minfilia i ja dostarczymy ją Błogosławionym w Slitherbough." },
    { "gameKey": "quest/033/LucKmc117_03338#TEXT_LUCKMC117_03338_THANCRED_000_032", "hash": "ACC7F5DE759891AC", "target": "Ty i Urianger wróćcie do Fanow, by zająć się rannym mieszkańcem." },
    { "gameKey": "quest/033/LucKmc117_03338#TEXT_LUCKMC117_03338_RYNE_100_032", "hash": "A63C4310CD09713C", "target": "A co z Y'shtolą...?" },
    { "gameKey": "quest/033/LucKmc117_03338#TEXT_LUCKMC117_03338_THANCRED_000_033", "hash": "E3EBE40C3562A71C", "target": "Wiem, że odejście wygląda bezdusznie, ale Y'shtola skoczyła w tę przepaść z ważnego powodu." },
    { "gameKey": "quest/033/LucKmc117_03338#TEXT_LUCKMC117_03338_THANCRED_100_033", "hash": "669D7ABC3E130BB5", "target": "Musimy ocalić Błogosławionych. Za wszelką cenę." },
    { "gameKey": "quest/033/LucKmc117_03338#TEXT_LUCKMC117_03338_RYNE_110_033", "hash": "C05171C3251B19D5", "target": "Dobrze." },
    { "gameKey": "quest/033/LucKmc117_03338#TEXT_LUCKMC117_03338_ALMET_000_034", "hash": "4220AA7C719FD49F", "target": "Moje siostry i ja zostaniemy tutaj. Musimy upewnić się, że nie kryją się tu żołnierze." },
    { "gameKey": "quest/033/LucKmc117_03338#TEXT_LUCKMC117_03338_URIANGER_000_035", "hash": "2E7A8933E8EB2D26", "target": "Chodź, <split(<string(gstr1)>, ,1)>. Nie pozwólmy, by ofiara Y'shtoli poszła na marne." },
    { "gameKey": "quest/033/LucKmc117_03338#TEXT_LUCKMC117_03338_URIANGER_000_036", "hash": "71FD4B423335C0C8", "target": "Do Fanow." },
    { "gameKey": "quest/033/LucKmc117_03338#TEXT_LUCKMC117_03338_RUNAR_000_040", "hash": "2A40CC19FE5C4D16", "target": "\\<jęk>" },
    { "gameKey": "quest/033/LucKmc117_03338#TEXT_LUCKMC117_03338_URIANGER_000_050", "hash": "BFAE18A783B8B030", "target": "Niech niebiosa mają nas w opiece. Runar..." },
    { "gameKey": "quest/033/LucKmc117_03338#TEXT_LUCKMC117_03338_URIANGER_000_051", "hash": "CC197D4A64E21197", "target": "To on zatrzymał pochód Eulmorańczyków. Dał ci tym czas na przebycie świątyni." },
    { "gameKey": "quest/033/LucKmc117_03338#TEXT_LUCKMC117_03338_URIANGER_000_052", "hash": "4A1C3680CDEC2317", "target": "Prędko, antidotum." },
    { "gameKey": "quest/033/LucKmc117_03338#TEXT_LUCKMC117_03338_URIANGER_000_060", "hash": "5C55B85757413263", "target": "Prędko, <split(<string(gstr1)>, ,1)>. Obawiam się, że zostało mu niewiele czasu." },
    { "gameKey": "quest/033/LucKmc117_03338#TEXT_LUCKMC117_03338_RUNAR_000_070", "hash": "92207B684D135D30", "target": "\\<jęk>" },
    { "gameKey": "quest/033/LucKmc117_03338#TEXT_LUCKMC117_03338_SYSTEM_000_080", "hash": "26B68FC705C14C15", "target": "Runar nadal wygląda na cierpiącego. Być może potrzebuje kolejnej dawki lekarstwa." },
    { "gameKey": "quest/033/LucKmc117_03338#TEXT_LUCKMC117_03338_SYSTEM_000_090", "hash": "7CE5E35D25420207", "target": "Lekarstwo zaczyna działać. Kolor powoli wraca na jego policzki." },
    { "gameKey": "quest/033/LucKmc117_03338#TEXT_LUCKMC117_03338_RUNAR_000_095", "hash": "E77E1BB5610F0C26", "target": "Mistrzyni... Matoya..." },
    { "gameKey": "quest/033/LucKmc117_03338#TEXT_LUCKMC117_03338_URIANGER_000_100", "hash": "3A36B6E6A694C771", "target": "Wygląda na to, że najgorsze minęło, choć jego rany nadal wymagają opieki." },
    { "gameKey": "quest/033/LucKmc117_03338#TEXT_LUCKMC117_03338_URIANGER_000_101", "hash": "C34C39EE38995C34", "target": "Zajmę się nim bezzwłocznie." }
  ]
}
