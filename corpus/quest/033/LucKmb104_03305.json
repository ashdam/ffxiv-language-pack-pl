{
  "conversation": "quest/033/LucKmb104_03305",
  "gameVersion": "2026.09.15.0000.0000",
  "entries": [
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_SEQ_00", "hash": "9EC84DF29F4EA5ED", "target": "Operacja zbliża się wielkimi krokami, a Lyna zamierza powierzyć ci zadanie." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_SEQ_01", "hash": "DCD5B513CBFD423A", "target": "Na potrzeby operacji amaro muszą otrzymać to samo serum, które przyszło ci zażyć. Aby skłonić zwierzęta do współpracy, skropiono ich paszę tą paskudną miksturą. Pozostało je tylko nakarmić. Lyna prosi cię o pomoc i poleca przynieść paszę z lądowiska amaro." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_SEQ_02", "hash": "3C4169AF4D3662DC", "target": "Pasza jest już w twoich rękach. Czas sprawdzić, czy amaro dadzą się oszukać." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_SEQ_03", "hash": "38F0FBFC31687264", "target": "Niektórym amaro smak paszy wyraźnie nie odpowiada, lecz wszystkie ją zjadają. Lyna będzie czekać na twój raport." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_SEQ_04", "hash": "0D126BC8EC730DAB", "target": "Przygotowania do operacji idą pełną parą. Lyna poleca ci się przygotować i czekać na rozkaz wymarszu na szczycie głównej wieży strażniczej." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_SEQ_05", "hash": "B9277965B9FE5A37", "target": "Operacja się rozpoczęła. Z punktu widokowego nad Laxan Loft obserwujesz, jak proszek nasenny działa na żołnierzy Eulmore. Na rozkaz Lyny dosiadasz amaro i zlatujesz do twierdzy, by uratować Minfilię." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_SEQ_06", "hash": "EAC903B2F7794A45", "target": "Przedzierasz się przez Laxan Loft i odnajdujesz Minfilię, lecz drogę zastępuje wam generał Ran'jit, który bez trudu cię obezwładnia. Gdy wydaje się, że czeka cię wypaczony eulmorański wymiar sprawiedliwości, z pomocą przybywa Thancred. Choć i on nie dorównuje przeciwnikowi, stwarza wam okazję do ucieczki. Prowadzi was do sąsiedniego Il Mheg, gdzie pościg nie powinien wam grozić. Wkrótce jednak pojawia się nowy problem: zewsząd i znikąd dobiegają figlarne głosy, a drużynę ogarnia jakiś czar.<br><br>※Jeśli opuścisz Il Mheg, możesz wrócić przez bramę na północno-zachodniej granicy Lakeland." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_SEQ_07", "hash": "B434F20A844BF934", "target": "Thancred z rozdrażnieniem wyjaśnia, że Il Mheg jest domem ludu fae, przede wszystkim pixie. Te psotne stworzenia używają potężnych iluzji, by płatać figle intruzom. Teraz jesteście całkowicie na ich łasce..." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_TODO_00", "hash": "EA0438B432B85829", "target": "Zdobyć paszę z serum" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_TODO_01", "hash": "3E01B632A5D37DD1", "target": "Nakarmić amaro paszą z serum" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_TODO_02", "hash": "14D8D612A9433186", "target": "Porozmawiać z Lyną" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_TODO_03", "hash": "3AC56216737A735E", "target": "Porozmawiać ze zwiadowcą Crystarium" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_TODO_04", "hash": "700B18443E0FA6BE", "target": "Porozmawiać ze zwiadowcą Crystarium" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_TODO_05", "hash": "D51051BFEAFCC4C0", "target": "Porozmawiać z Thancredem" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_AMAROA03304_000_000", "hash": "B7A6E7533C105A86", "target": "Kwi, kwi!" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_AMAROB03304_000_005", "hash": "11DACEAC5A360985", "target": "Kwi..." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_AMAROC03304_000_010", "hash": "FED6C522F0D73B1F", "target": "Kwi, kwi! Kwiiiiii!" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_AMAROD03304_000_015", "hash": "A4F6A1BA74412698", "target": "Kwi?" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_000_020", "hash": "C2BEF09D95495291", "target": "Przed operacją amaro muszą otrzymać to samo serum co my." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_000_021", "hash": "AD550FCA132A0F83", "target": "Jak <if(gnum4,pani,pan)> wie, nie jest ono smaczne. Aby je do niego przekonać, skropiliśmy nim paszę." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_000_022", "hash": "2B8B8357BB7B4866", "target": "Pozostało je nakarmić. Jestem pewna, że to zadanie sprawi <if(gnum4,pani,panu)> przyjemność. Proszę przynieść paszę z lądowiska amaro i nakarmić cztery zwierzęta. To wszystko." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_000_030", "hash": "8CFB9841973A96D9", "target": "Pasza z serum leży przy lądowisku. Po nakarmieniu naszych podopiecznych proszę mi zameldować." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_AMAROA03304_000_040", "hash": "A0CCE8B539CC0967", "target": "Kwi, kwi! Kwi!" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_SYSTEM_000_041", "hash": "676134C851A60939", "target": "Amaro z apetytem pożera paszę." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_AMAROB03304_000_042", "hash": "628C44ABA57F8D72", "target": "Kwi? Kwi..." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_SYSTEM_000_043", "hash": "7D3CE4DBFD8448BC", "target": "Amaro bezmyślnie przeżuwa paszę." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_AMAROC03304_000_044", "hash": "112D194F343AC68A", "target": "Kwi, kwi, kwi! Kwi, kwi!" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_SYSTEM_000_045", "hash": "5727BADE1E3C1E50", "target": "Amaro z początku jest nieufny, lecz w końcu głód bierze górę i zwierzę zjada paszę." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_AMAROD03304_000_046", "hash": "76D89E5648FA29DE", "target": "Kwi? Chrrr..." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_SYSTEM_000_047", "hash": "5687A69B2F305972", "target": "Zapach odrzuca amaro, lecz zwierzę i tak przyjmuje paszę." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_AMAROA03304_000_050", "hash": "17E15977371AE71A", "target": "Kwi, kwi!" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_AMAROB03304_000_055", "hash": "B65C7DC699F1A407", "target": "Kwi... Kwi..." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_AMAROC03304_000_060", "hash": "91C34D527E7596C7", "target": "Kwiiiiii!" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_AMAROD03304_000_065", "hash": "C55E4EB4C6689865", "target": "Chrrr..." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_000_070", "hash": "FEAAAEC259C7487B", "target": "Amaro są nakarmione?" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_000_071", "hash": "AE1583F539CB70E6", "target": "Dobrze. Pozostałe otrzymały już dawkę, więc nie musimy się obawiać, że któryś z naszych wierzchowców ulegnie działaniu proszku nasennego." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_000_072", "hash": "5E614A80B9E5B096", "target": "Wszystkie oddziały kończą przygotowania. Pora jest bliska." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_000_073", "hash": "EA36CD4AD03661C1", "target": "Proszę się przygotować i czekać na rozkaz wymarszu na szczycie głównej wieży strażniczej. Gdy tylko dotrze mundur, każę go dostarczyć." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_000_074", "hash": "1ADC8258668A6624", "target": "To wszystko. Niech noc nam sprzyja." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_000_080", "hash": "3FBF0B11B38B98A1", "target": "Dlaczego wciąż <if(gnum4,pani,pan)> tu jest? Proszę czekać na rozkaz na szczycie głównej wieży strażniczej." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_CRYSTARIUMGARDPICKET_000_090", "hash": "39522195D19CC3D6", "target": "Operacja zaraz się rozpocznie! Proszę być w gotowości!" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_SYSTEM_000_091", "hash": "1B4E06D297D046FF", "target": "Podczas operacji zmieni się wygląd części twojego wyposażenia. Twoje atrybuty i zdolności pozostaną bez zmian." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_RYNE_000_092", "hash": "A3A876F8DFEEACBC", "target": "D-dziękuję. Czy jesteście... z Crystarium?" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_000_093", "hash": "C393555533951ED0", "target": "Tak. Przybyliśmy cię uratować." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_000_094", "hash": "A159F7BE87AF344D", "target": "Twoja broń─wykonana według tych samych wytycznych co broń Thancreda." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_000_095", "hash": "8BB5EF390A93C077", "target": "Bądź gotowa jej użyć." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_RYNE_000_096", "hash": "F88CB6EC4764F49F", "target": "R-rozumiem. Proszę, prowadźcie." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_RANJIT_000_097", "hash": "BECEE108A49FB12F", "target": "Hm. Bezczelni złodzieje." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_RANJIT_000_098", "hash": "887E03B6798CECA6", "target": "Pożałujecie, że tu przyszliście." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_SYSTEM_000_100", "hash": "6432F0D2AA04DC09", "target": "Kontynuować zadanie głównego scenariusza?" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_ALPHINAUD_000_110", "hash": "218B3F336CCAA91A", "target": "To wróżki, jak mniemam?" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_ALISAIE_000_115", "hash": "E4CE42BB173EF729", "target": "Martwiłam się o pozostałych w Lakeland, ale chyba powinnam martwić się o nas." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_RYNE_000_120", "hash": "55E08552A692E33E", "target": "Próbuję sobie przypomnieć... ale to jak patrzenie przez mgłę." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_THANCRED_000_130", "hash": "0EA62D3576D77243", "target": "Il Mheg to królestwo wróżek i, jak można się spodziewać, mieszka w nim lud fae." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_THANCRED_000_131", "hash": "069A9B58DD225276", "target": "Najliczniejsze są pixie, które uwielbiają psoty. Za pomocą potężnych iluzji płatają figle każdemu, kto zapuści się na ich ziemie." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_THANCRED_000_132", "hash": "4C055A669A01C1DF", "target": "Potrafią choćby sprawić, że znana ścieżka wyda ci się zupełnie obca, albo wmówić ci, że jesteś gdzie indziej." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_THANCRED_000_133", "hash": "E0D1948C01403063", "target": "I z przykrością stwierdzam, że teraz jesteśmy całkowicie na ich łasce." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_QIB_001_SCREENTEXT_1", "hash": "3A9B1E8D7F5CA3DC", "target": "Przebij się do Minfilii!" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_QIB_001_SCREENTEXT_3", "hash": "8467A50036376F3F", "target": "Ucieknij z Laxan Loft!" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_QIB_001_SCREENTEXT_4", "hash": "8C825D3465529770", "target": "Pokonaj Ran'jita!" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_BATTLETALK_000_010", "hash": "295F7388BF06274C", "target": "Pierwszy oddział już wszedł. Ruszajmy za nim." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_ALPHINAUD_BATTLETALK_000_020", "hash": "0927382102EC13E8", "target": "Tu jesteś, <split(<string(gstr1)>, ,1)>! Może nam pomożesz?" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_EULMORESOLDIER03305A_BATTLETALK_000_021", "hash": "3CB2119E4026056A", "target": "Posiłki! Potrzebujemy posiłków!" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_BATTLETALK_000_030", "hash": "8D3A526943759B87", "target": "Moi ludzie zajmą wroga, a my uratujemy Wyrocznię." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_BATTLETALK_000_031", "hash": "BE82BDB4CBF5C8BE", "target": "Chodźmy, trzymajmy się blisko muru!" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_EULMORESOLDIER03305A_BATTLETALK_000_040", "hash": "5FE8AB50927BE6DA", "target": "Tu też są! Do broni, do broni!" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_BATTLETALK_000_050", "hash": "19ED8A2C2D39980F", "target": "Cholera. Załatwmy to szybko!" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_ALISAIE_BATTLETALK_000_060", "hash": "D71D280AA1C419C8", "target": "Wreszcie się doczekaliśmy. Przebijmy się przez ten motłoch i ruszajmy dalej!" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_ALPHINAUD_BATTLETALK_000_070", "hash": "9D6C74FE1A4CE97F", "target": "Twój zapał jest godny podziwu, siostro, ale kazano nam <italic(1)>unikać<italic(0)> uwagi wroga, a nie ją przyciągać!" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_BATTLETALK_000_080", "hash": "3086A7881004DA84", "target": "Nie mamy czasu. Zostawcie ich straży." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_BATTLETALK_000_081", "hash": "DB5D89B39EBE6627", "target": "Eulmore może się szczycić największą armią na świecie..." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_BATTLETALK_000_082", "hash": "22870F013DF749EB", "target": "Ale każda z nas dorównuje ich żołnierzom!" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_EULMORESOLDIER03305B_BATTLETALK_000_090", "hash": "10669621BD5A4A26", "target": "Intruzi! Zatrzymać ich!" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_ALISAIE_BATTLETALK_000_091", "hash": "F660FD96A7AB3612", "target": "Nie, tylko nie znowu!" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_EULMORESOLDIER03305C_BATTLETALK_000_100", "hash": "8732000D1B0DDAA0", "target": "Ścierwo z Crystarium!" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_ALPHINAUD_BATTLETALK_000_101", "hash": "4DBA8ECAE0B5643E", "target": "To wcale nie mały oddział. Naprawdę zamierzali dokonać inwazji." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_EULMORESOLDIER03305D_BATTLETALK_000_110", "hash": "1E285F8014EF333D", "target": "Kto może stać, może walczyć! Odepchnąć ich!" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_BATTLETALK_000_111", "hash": "67F4ADCB1C3D39CB", "target": "Na nogach zostało ich więcej, niż bym chciała..." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_BATTLETALK_000_112", "hash": "D930E7AF46A9102D", "target": "Ale musimy iść dalej. Im dłużej to potrwa, tym trudniejsze będzie nasze zadanie." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_ALPHINAUD_BATTLETALK_000_120", "hash": "455FEF3230AF8827", "target": "Chyba nie posuwamy się naprzód..." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_ALISAIE_BATTLETALK_000_130", "hash": "516CBF7B251F2482", "target": "<split(<string(gstr1)>, ,1)>, Lyna─idźcie przodem! My ich tu zatrzymamy!" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_BATTLETALK_000_140", "hash": "5A06E81D0D3CBFAC", "target": "Rozumiem. Za mną, <split(<string(gstr1)>, ,1)>!" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_BATTLETALK_000_150", "hash": "CCDDEDF12CEB8C97", "target": "Droga jest w miarę wolna. Dobrze." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_BATTLETALK_000_160", "hash": "2D43981EAB72EFDB", "target": "Tam jest!" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_BATTLETALK_000_161", "hash": "62AAAEB1510FF001", "target": "Szybko─proszę ją uwolnić!" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_BATTLETALK_000_200", "hash": "0502CE9EBE34CA4F", "target": "Dołączmy do reszty i wynośmy się stąd." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_RYNE_BATTLETALK_000_201", "hash": "EBE0E2C5CA6F8235", "target": "Tyle kłopotu przeze mnie... Tak mi przykro..." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_BATTLETALK_000_202", "hash": "A1D520244F7F7648", "target": "Przeproś nas, gdy już uciekniemy." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_BATTLETALK_000_210", "hash": "51C2D85CD840C3BD", "target": "Cicho tu. Zbyt cicho." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_BATTLETALK_000_220", "hash": "E0EC8764859B59C7", "target": "Czy to... Ran'jit!? To się źle skończy..." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_RANJIT_BATTLETALK_000_230", "hash": "7B20D09CA9A08C1D", "target": "Wrócisz do Eulmore." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_RYNE_BATTLETALK_000_231", "hash": "45FA2F610B5FC7BC", "target": "N-nie! Nie wrócę do tej celi!" },
