{
  "conversation": "quest/033/LucKmb104_03305",
  "gameVersion": "2026.11.03.0000.0000",
  "entries": [
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_SEQ_00", "hash": "9EC84DF29F4EA5ED", "target": "Zbliża się pora wymarszu. Lyna ma dla ciebie zadanie." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_SEQ_01", "hash": "DCD5B513CBFD423A", "target": "Przed akcją amaro muszą dostać ten sam środek co ty. Żeby jakoś przemycić to paskudztwo, dodano je do paszy. Wystarczy nakarmić zwierzęta. Lyna prosi cię o pomoc i wysyła po paszę na lądowisko amaro." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_SEQ_02", "hash": "3C4169AF4D3662DC", "target": "Masz już paszę. Ciekawe, czy amaro wyczują podstęp." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_SEQ_03", "hash": "38F0FBFC31687264", "target": "Niektórym amaro pasza wyraźnie nie smakuje, ale w końcu wszystkie ją zjadają. Zdaj raport Lynie." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_SEQ_04", "hash": "0D126BC8EC730DAB", "target": "Przygotowania dobiegają końca. Lyna każe ci przygotować się i czekać na rozkaz wymarszu na szczycie głównej wieży strażniczej." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_SEQ_05", "hash": "B9277965B9FE5A37", "target": "Zaczęło się. Z góry widzisz, jak żołnierze Eulmore w Laxan Loft padają pod działaniem proszku nasennego. Na rozkaz Lyny dosiadasz amaro i ruszasz w dół, by odbić Minfilię." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_SEQ_06", "hash": "EAC903B2F7794A45", "target": "Przedzierasz się przez Laxan Loft i odnajdujesz Minfilię. W drodze powrotnej zastępuje wam drogę generał Ran'jit i bez trudu cię obezwładnia. Zdaje się, że zaraz wymierzy ci sprawiedliwość wedle zasad Eulmore, lecz w ostatniej chwili na pomoc przychodzi Thancred. Choć sam też nie może sprostać generałowi, odwraca jego uwagę na tyle długo, by udało wam się uciec. Z pomocą Egzarchy przedostajecie się do sąsiedniego Il Mheg, gdzie pościg nie powinien was dosięgnąć. Zaraz jednak słyszycie psotne głosy dobiegające ze wszystkich stron. Wygląda na to, że ktoś rzucił na was urok.<br><br>※Jeśli opuścisz Il Mheg, możesz wrócić przez bramę na północno-zachodniej granicy Lakeland." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_SEQ_07", "hash": "B434F20A844BF934", "target": "Zirytowany Thancred wyjaśnia, że Il Mheg zamieszkuje lud fae, a najliczniejsze są tu pixie. Za pomocą potężnych iluzji płatają figle każdemu, kto zapuści się na ich ziemie. Teraz to wy jesteście zdani na ich łaskę..." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_TODO_00", "hash": "EA0438B432B85829", "target": "Zdobyć paszę z dodatkiem serum" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_TODO_01", "hash": "3E01B632A5D37DD1", "target": "Nakarmić amaro paszą z dodatkiem serum" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_TODO_02", "hash": "14D8D612A9433186", "target": "Porozmawiać z dowódczynią Lyną" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_TODO_03", "hash": "3AC56216737A735E", "target": "Porozmawiać ze zwiadowczynią Crystarium" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_TODO_04", "hash": "700B18443E0FA6BE", "target": "Porozmawiać ze zwiadowczynią Crystarium" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_TODO_05", "hash": "D51051BFEAFCC4C0", "target": "Porozmawiać z Thancredem" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_AMAROA03304_000_000", "hash": "B7A6E7533C105A86", "target": "Kwi, kwi!" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_AMAROB03304_000_005", "hash": "11DACEAC5A360985", "target": "Kwi..." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_AMAROC03304_000_010", "hash": "FED6C522F0D73B1F", "target": "Kwi, kwi! Kwiiiiii!" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_AMAROD03304_000_015", "hash": "A4F6A1BA74412698", "target": "Kwi?" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_000_020", "hash": "C2BEF09D95495291", "target": "Przed akcją amaro muszą dostać ten sam środek co my." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_000_021", "hash": "AD550FCA132A0F83", "target": "Jak <if(gnum4,pani,pan)> wie, środek nie należy do smacznych. Dlatego dodaliśmy go do paszy." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_000_022", "hash": "2B8B8357BB7B4866", "target": "Teraz wystarczy nakarmić amaro. Jestem pewna, że to się <if(gnum4,pani,panu)> spodoba. Proszę zabrać paszę z lądowiska i dać ją czterem amaro. To wszystko." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_000_030", "hash": "8CFB9841973A96D9", "target": "Pasza leży przy lądowisku. Proszę zdać raport po nakarmieniu zwierząt." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_AMAROA03304_000_040", "hash": "A0CCE8B539CC0967", "target": "Kwi, kwi! Kwi!" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_SYSTEM_000_041", "hash": "676134C851A60939", "target": "Amaro z apetytem pożera paszę." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_AMAROB03304_000_042", "hash": "628C44ABA57F8D72", "target": "Kwi? Kwi..." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_SYSTEM_000_043", "hash": "7D3CE4DBFD8448BC", "target": "Amaro sennie przeżuwa paszę." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_AMAROC03304_000_044", "hash": "112D194F343AC68A", "target": "Kwi, kwi, kwi! Kwi, kwi!" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_SYSTEM_000_045", "hash": "5727BADE1E3C1E50", "target": "Amaro z początku nie ufa zapachowi, ale głód bierze górę i zwierzę zjada paszę." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_AMAROD03304_000_046", "hash": "76D89E5648FA29DE", "target": "Kwi? Chrrr..." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_SYSTEM_000_047", "hash": "5687A69B2F305972", "target": "Amaro aż się cofa od zapachu, ale w końcu zjada paszę." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_AMAROA03304_000_050", "hash": "17E15977371AE71A", "target": "Kwi, kwi!" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_AMAROB03304_000_055", "hash": "B65C7DC699F1A407", "target": "Kwi... Kwi..." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_AMAROC03304_000_060", "hash": "91C34D527E7596C7", "target": "Kwiiiiii!" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_AMAROD03304_000_065", "hash": "C55E4EB4C6689865", "target": "Chrrr..." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_000_070", "hash": "FEAAAEC259C7487B", "target": "Amaro są nakarmione?" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_000_071", "hash": "AE1583F539CB70E6", "target": "Dobrze. Reszta już dostała swoją dawkę, więc proszek nasenny nie powinien zadziałać na żadne z naszych amaro." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_000_072", "hash": "5E614A80B9E5B096", "target": "Wszystkie oddziały są prawie gotowe. Niedługo ruszamy." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_000_073", "hash": "EA36CD4AD03661C1", "target": "Proszę się przygotować i czekać na rozkaz wymarszu na szczycie głównej wieży strażniczej. Gdy tylko mundur będzie gotowy, poślę go na wieżę." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_000_074", "hash": "1ADC8258668A6624", "target": "To wszystko. Niech noc nam sprzyja." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_000_080", "hash": "3FBF0B11B38B98A1", "target": "Dlaczego wciąż <if(gnum4,pani,pan)> tu jest? Proszę czekać na rozkaz na wieży." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_CRYSTARIUMGARDPICKET_000_090", "hash": "39522195D19CC3D6", "target": "Operacja zaraz się rozpocznie! Proszę być w gotowości!" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_SYSTEM_000_091", "hash": "1B4E06D297D046FF", "target": "Podczas operacji zmieni się wygląd niektórych elementów wyposażenia. Atrybuty i zdolności pozostaną bez zmian." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_RYNE_000_092", "hash": "A3A876F8DFEEACBC", "target": "D-dziękuję. Czy jesteście... z Crystarium?" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_000_093", "hash": "C393555533951ED0", "target": "Tak. Przybyliśmy cię uratować." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_000_094", "hash": "A159F7BE87AF344D", "target": "Oto twoje sztylety. Wykuto je na wzór tych, które dał ci Thancred." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_000_095", "hash": "8BB5EF390A93C077", "target": "W razie potrzeby ich użyj." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_RYNE_000_096", "hash": "F88CB6EC4764F49F", "target": "R-rozumiem. Prowadźcie, proszę." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_RANJIT_000_097", "hash": "BECEE108A49FB12F", "target": "Hm. Bezczelne szczury." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_RANJIT_000_098", "hash": "887E03B6798CECA6", "target": "Pożałujecie, że tu przyszliście." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_SYSTEM_000_100", "hash": "6432F0D2AA04DC09", "target": "Kontynuować zadanie głównego scenariusza?" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_ALPHINAUD_000_110", "hash": "218B3F336CCAA91A", "target": "To pewnie głosy wróżek?" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_ALISAIE_000_115", "hash": "E4CE42BB173EF729", "target": "Martwiłam się o tych, którzy zostali w Lakeland, ale chyba to my mamy większy kłopot." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_RYNE_000_120", "hash": "55E08552A692E33E", "target": "Próbuję sobie przypomnieć... ale mam w głowie mgłę." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_THANCRED_000_130", "hash": "0EA62D3576D77243", "target": "Il Mheg zwą królestwem wróżek. Nic dziwnego: roi się tu od rozmaitych istot z ludu fae." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_THANCRED_000_131", "hash": "069A9B58DD225276", "target": "Najliczniejsze są pixie, które uwielbiają psoty. Za pomocą potężnych iluzji płatają figle każdemu, kto zapuści się na ich ziemie." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_THANCRED_000_132", "hash": "4C055A669A01C1DF", "target": "Sprawią, że zgubisz się na dobrze znanej ścieżce albo przysięgniesz, że jesteś w zupełnie innym miejscu." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_THANCRED_000_133", "hash": "E0D1948C01403063", "target": "I obawiam się, że właśnie się nami bawią." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_QIB_001_SCREENTEXT_1", "hash": "3A9B1E8D7F5CA3DC", "target": "Przebij się do Minfilii!" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_QIB_001_SCREENTEXT_3", "hash": "8467A50036376F3F", "target": "Ucieknij z Laxan Loft!" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_QIB_001_SCREENTEXT_4", "hash": "8C825D3465529770", "target": "Osłab Ran'jita!" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_BATTLETALK_000_010", "hash": "295F7388BF06274C", "target": "Pierwszy oddział już w środku. Idziemy za nimi." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_ALPHINAUD_BATTLETALK_000_020", "hash": "0927382102EC13E8", "target": "O, jesteś, <split(<string(gstr1)>, ,1)>! Przyda nam się pomoc!" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_EULMORESOLDIER03305A_BATTLETALK_000_021", "hash": "3CB2119E4026056A", "target": "Posiłki! Potrzebujemy posiłków!" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_BATTLETALK_000_030", "hash": "8D3A526943759B87", "target": "Straż zajmie wroga, a my odbijemy Wyrocznię." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_BATTLETALK_000_031", "hash": "BE82BDB4CBF5C8BE", "target": "Za mną! Trzymajcie się muru!" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_EULMORESOLDIER03305A_BATTLETALK_000_040", "hash": "5FE8AB50927BE6DA", "target": "Tu też są! Do broni, do broni!" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_BATTLETALK_000_050", "hash": "19ED8A2C2D39980F", "target": "Cholera. Załatwmy ich szybko!" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_ALISAIE_BATTLETALK_000_060", "hash": "D71D280AA1C419C8", "target": "Co tak długo? Rozpędźmy tych drani i ruszajmy dalej!" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_ALPHINAUD_BATTLETALK_000_070", "hash": "9D6C74FE1A4CE97F", "target": "Podziwiam twój zapał, siostro, ale mieliśmy <italic(1)>unikać<italic(0)> rozgłosu, pamiętasz?" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_BATTLETALK_000_080", "hash": "3086A7881004DA84", "target": "Nie mamy czasu. Zostawcie ich straży." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_BATTLETALK_000_081", "hash": "DB5D89B39EBE6627", "target": "Eulmore ma może najliczniejszą armię na świecie..." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_BATTLETALK_000_082", "hash": "22870F013DF749EB", "target": "Ale nasi żołnierze wcale im nie ustępują!" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_EULMORESOLDIER03305B_BATTLETALK_000_090", "hash": "10669621BD5A4A26", "target": "Intruzi! Zatrzymać ich!" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_ALISAIE_BATTLETALK_000_091", "hash": "F660FD96A7AB3612", "target": "Nie, tylko nie znowu!" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_EULMORESOLDIER03305C_BATTLETALK_000_100", "hash": "8732000D1B0DDAA0", "target": "Szuje z Crystarium!" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_ALPHINAUD_BATTLETALK_000_101", "hash": "4DBA8ECAE0B5643E", "target": "To nie byle oddział. Naprawdę chcieli napaść na Crystarium." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_EULMORESOLDIER03305D_BATTLETALK_000_110", "hash": "1E285F8014EF333D", "target": "Kto stoi na nogach, ten do walki! Odepchnąć ich!" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_BATTLETALK_000_111", "hash": "67F4ADCB1C3D39CB", "target": "Za wielu nie zasnęło..." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_BATTLETALK_000_112", "hash": "D930E7AF46A9102D", "target": "Ale nie możemy tu zostać. Im dłużej zwlekamy, tym większa szansa, że reszta się obudzi." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_ALPHINAUD_BATTLETALK_000_120", "hash": "455FEF3230AF8827", "target": "Tak nigdzie nie dojdziemy..." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_ALISAIE_BATTLETALK_000_130", "hash": "516CBF7B251F2482", "target": "<split(<string(gstr1)>, ,1)>, Lyna, idźcie przodem! My ich zatrzymamy!" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_BATTLETALK_000_140", "hash": "5A06E81D0D3CBFAC", "target": "Rozumiem. Za mną, <split(<string(gstr1)>, ,1)>!" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_BATTLETALK_000_150", "hash": "CCDDEDF12CEB8C97", "target": "Dobrze, tu straż jest mniej liczna." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_BATTLETALK_000_160", "hash": "2D43981EAB72EFDB", "target": "Tam jest!" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_BATTLETALK_000_161", "hash": "62AAAEB1510FF001", "target": "Szybko, proszę rozwiązać więzy!" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_BATTLETALK_000_200", "hash": "0502CE9EBE34CA4F", "target": "Wracamy do reszty. Wynośmy się stąd!" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_RYNE_BATTLETALK_000_201", "hash": "EBE0E2C5CA6F8235", "target": "Tyle kłopotu przeze mnie... Tak mi przykro..." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_BATTLETALK_000_202", "hash": "A1D520244F7F7648", "target": "Na przeprosiny przyjdzie czas. Najpierw się stąd wydostańmy." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_BATTLETALK_000_210", "hash": "51C2D85CD840C3BD", "target": "Cicho tu. Zbyt cicho." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_BATTLETALK_000_220", "hash": "E0EC8764859B59C7", "target": "Czy to... Ran'jit?! Niedobrze..." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_RANJIT_BATTLETALK_000_230", "hash": "7B20D09CA9A08C1D", "target": "Wrócisz do Eulmore." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_RYNE_BATTLETALK_000_231", "hash": "45FA2F610B5FC7BC", "target": "N-nie! Nie wrócę do tej celi!" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_RANJIT_BATTLETALK_000_232", "hash": "ABF0446E75282AA1", "target": "To dla twojego bezpieczeństwa." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_RYNE_BATTLETALK_000_233", "hash": "8F4B369568DCCC18", "target": "Ach!" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_RANJIT_BATTLETALK_000_240", "hash": "434E782DBA8FC79F", "target": "Żałosne." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_ALISAIE_BATTLETALK_000_241", "hash": "F4922706826CB0C1", "target": "Wszystko w porządku!?" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_RYNE_BATTLETALK_000_242", "hash": "97CC2F7AAC067B51", "target": "N-nic mi nie jest... Tylko... nie mogę się ruszyć..." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_RANJIT_BATTLETALK_000_243", "hash": "2AB37D19924E8030", "target": "Zostań tu, a ja zajmę się tym robactwem." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_LYNA_BATTLETALK_000_244", "hash": "AEDFA9FC02128404", "target": "Opowieści nie kłamały. Jest silniejszy, niż sądziłam. Nie damy mu rady!" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_ALPHINAUD_BATTLETALK_000_245", "hash": "AB2647D1DB79F570", "target": "Nie będzie tak atakował bez końca! Gdy tylko nadarzy się okazja, uciekamy!" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_RANJIT_BATTLETALK_000_250", "hash": "301AE341FB62CB89", "target": "Nic z tego." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_RANJIT_BATTLETALK_000_251", "hash": "7DDB5F9F771A6E30", "target": "A teraz już tylko ty i ja." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_ALPHINAUD_BATTLETALK_000_252", "hash": "B25EC1B5DBC27FF2", "target": "Uch... Uważaj, <split(<string(gstr1)>, ,1)>!" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_RANJIT_BATTLETALK_000_260", "hash": "EEA69E4BF24524EF", "target": "Masz więcej hartu niż reszta." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_RANJIT_BATTLETALK_000_261", "hash": "92CD474ABF2E3263", "target": "Ale czy to wystarczy...?" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_RANJIT_BATTLETALK_000_262", "hash": "974554F0000E78C7", "target": "Gukumatz, do mnie!" },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_RANJIT_BATTLETALK_000_263", "hash": "CF75E70C6D12480B", "target": "Widzę, że nie mam do czynienia ze <if(gnum4,zwykłą szeregową,zwykłym szeregowcem)>." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_RANJIT_BATTLETALK_000_264", "hash": "8443245ABCA3962F", "target": "Uporu nie mogę ci odmówić." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_RANJIT_BATTLETALK_000_270", "hash": "669EF6C68BB39CA6", "target": "Już wiem, na co cię stać. Dość tej zabawy." },
    { "gameKey": "quest/033/LucKmb104_03305#TEXT_LUCKMB104_03305_RANJIT_BATTLETALK_000_271", "hash": "6402E3B4E162B269", "target": "Zaraz pożałujesz, że stajesz mi na drodze." }
