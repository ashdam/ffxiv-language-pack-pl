{
  "conversation": "quest/055/KinGkw399_05507",
  "gameVersion": "2026.11.03.0000.0000",
  "entries": [
    { "gameKey": "quest/055/KinGkw399_05507#TEXT_KINGKW399_05507_SYSTEM_000_000", "hash": "340D16014A3CF03C", "target": "Brigid może zmienić atrybuty twojej broni fantomowej." },
    { "gameKey": "quest/055/KinGkw399_05507#TEXT_KINGKW399_05507_BRIGID_000_001", "hash": "C438632B364BA457", "target": "Chcesz zmienić atrybuty swojej broni fantomowej? Nic prostszego, o ile masz potrzebne materiały." },
    { "gameKey": "quest/055/KinGkw399_05507#TEXT_KINGKW399_05507_Q1_000_100", "hash": "ADFBE956C1DB93CE", "target": "Co zrobisz?" },
    { "gameKey": "quest/055/KinGkw399_05507#TEXT_KINGKW399_05507_A1_000_100", "hash": "1762CF3284297051", "target": "Zmienię atrybuty broni fantomowej." },
    { "gameKey": "quest/055/KinGkw399_05507#TEXT_KINGKW399_05507_A2_000_100", "hash": "6A69D25507AD8CC9", "target": "Chcę wiedzieć, jak zmienić atrybuty broni fantomowej." },
    { "gameKey": "quest/055/KinGkw399_05507#TEXT_KINGKW399_05507_A3_000_100", "hash": "F2EB2FD290A58DD2", "target": "Nic." },
    { "gameKey": "quest/055/KinGkw399_05507#TEXT_KINGKW399_05507_SYSTEM_000_010", "hash": "105FC1A0288349D5", "target": "Możesz na nowo wybrać trzy atrybuty broni fantomowej lub zmienić ich wartości. Tak jak przy pierwszym ulepszeniu, jeden otrzyma niższą wartość od pozostałych dwóch." },
    { "gameKey": "quest/055/KinGkw399_05507#TEXT_KINGKW399_05507_SYSTEM_000_011", "hash": "D57C7DB64851B5E0", "target": "Po dostosowaniu wartości wybierz „Potwierdź”." },
    { "gameKey": "quest/055/KinGkw399_05507#TEXT_KINGKW399_05507_SYSTEM_000_012", "hash": "B260683951585D4B", "target": "Każda zmiana atrybutów kosztuje jedną bryłkę Ecliptic Arcanite. Dobrze przemyśl swój wybór." },
    { "gameKey": "quest/055/KinGkw399_05507#TEXT_KINGKW399_05507_BRIGID_000_020", "hash": "E58D74ACEBC16D06", "target": "Do zmiany atrybutów potrzebuję jednej bryłki Ecliptic Arcanite. Jej zdobycie zostawiam tobie." },
    { "gameKey": "quest/055/KinGkw399_05507#TEXT_KINGKW399_05507_SYSTEM_000_021", "hash": "8C10B3B3DF8DA77B", "target": "Ecliptic Arcanite można kupić u Erminy w Phantom Village." },
    { "gameKey": "quest/055/KinGkw399_05507#TEXT_KINGKW399_05507_BRIGID_000_030", "hash": "AD9EF2482B7B2584", "target": "Obawiam się, że mogę zmienić atrybuty tylko broni fantomowej. Najpierw ją załóż, a potem znów się do mnie odezwij." },
    { "gameKey": "quest/055/KinGkw399_05507#TEXT_KINGKW399_05507_BRIGID_000_040", "hash": "31FE44535718A6BE", "target": "Gotowe! Jeśli zechcesz kiedyś wypróbować inny zestaw atrybutów, wystarczy poprosić." },
    { "gameKey": "quest/055/KinGkw399_05507#TEXT_KINGKW399_05507_SYSTEM_000_106", "hash": "6E4AC061EE75DCCE", "target": "Zmieniono atrybuty twojej broni fantomowej (<if([gnum68<8],<sheet(ClassJob,gnum68,0)>,<if([gnum68>18],<sheet(ClassJob,gnum68,0)>,)>)>)." }
  ]
}
