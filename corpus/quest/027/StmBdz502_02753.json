    { "gameKey": "quest/027/StmBdz502_02753#TEXT_STMBDZ502_02753_SEQ_00", "hash": "122117968FA3D94C", "target": "Khaishan wygląda, jakby ze zmartwienia aż chciał coś powiedzieć." },
    { "gameKey": "quest/027/StmBdz502_02753#TEXT_STMBDZ502_02753_TODO_00", "hash": "D2352CF1D4A1EB98", "target": "Zbadać Morze Ostrzy" },
    { "gameKey": "quest/027/StmBdz502_02753#TEXT_STMBDZ502_02753_TODO_01", "hash": "A1F7DC4730F99EAE", "target": "Porozmawiać ze wstrząśniętym kupcem" },
    { "gameKey": "quest/027/StmBdz502_02753#TEXT_STMBDZ502_02753_TODO_02", "hash": "A9094167F5C87C48", "target": "Zdać relację Khaishanowi" },
    { "gameKey": "quest/027/StmBdz502_02753#TEXT_STMBDZ502_02753_SYSTEM_000_000", "hash": "3B11142BFFC70494", "target": "Niepewny ruch głową zdradza, że Khaishana coś trapi." },
    { "gameKey": "quest/027/StmBdz502_02753#TEXT_STMBDZ502_02753_KHAISHAN_000_001", "hash": "2F1ED3965D19CB9E", "target": "..." },
    { "gameKey": "quest/027/StmBdz502_02753#TEXT_STMBDZ502_02753_SYSTEM_000_003", "hash": "A1EDD80775020544", "target": "Khaishan nagle wyciąga rękę na północ. Chyba dzieje się tam coś, czemu warto się przyjrzeć." },
    { "gameKey": "quest/027/StmBdz502_02753#TEXT_STMBDZ502_02753_KHAISHAN_000_004", "hash": "2366B9043FFB0DB7", "target": "..." },
    { "gameKey": "quest/027/StmBdz502_02753#TEXT_STMBDZ502_02753_MERCHANT02753_000_010", "hash": "2EB41BAE4436E99F", "target": "Ogromnie ci dziękuję. Niewiele brakowało, a byłoby po mnie. Khaishanowi też podziękuję, że przysłał pomoc." },
    { "gameKey": "quest/027/StmBdz502_02753#TEXT_STMBDZ502_02753_MERCHANT02753_000_011", "hash": "B29E0BE7BEAD7418", "target": "Aż się dziwię, że udało ci się zrozumieć, o co mu chodzi. Z Qestirami nigdy nie jest to takie proste." },
    { "gameKey": "quest/027/StmBdz502_02753#TEXT_STMBDZ502_02753_MERCHANT02753_000_012", "hash": "664959D106A2AC33", "target": "Uważają, że słowa to same kłamstwa, więc się nie odzywają. Ale są uczciwi i można na nich polegać─dlatego tyle osób chętnie z nimi handluje." },
    { "gameKey": "quest/027/StmBdz502_02753#TEXT_STMBDZ502_02753_MERCHANT02753_000_013", "hash": "47220621FD852273", "target": "Powiedz Khaishanowi, że niedługo będę. Tylko załaduję wóz z powrotem i ruszam." },
    { "gameKey": "quest/027/StmBdz502_02753#TEXT_STMBDZ502_02753_MERCHANT02753_000_014", "hash": "F6F850CDA4EF498B", "target": "Powiedz Khaishanowi, że niedługo będę. Tylko załaduję wóz z powrotem i ruszam." },
    { "gameKey": "quest/027/StmBdz502_02753#TEXT_STMBDZ502_02753_KHAISHAN_000_020", "hash": "F9B0DFF37676878E", "target": "..." },
    { "gameKey": "quest/027/StmBdz502_02753#TEXT_STMBDZ502_02753_SYSTEM_000_021", "hash": "78437BCBA848B4C7", "target": "Khaishan wyraźnie się odpręża. Nic nie mówi, ale w jego ciepłym spojrzeniu widać wdzięczność." }
