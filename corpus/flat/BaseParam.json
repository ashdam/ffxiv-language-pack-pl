    { "gameKey": "BaseParam#1.1", "hash": "7DB526A2B9309F46", "target": "Siła" },
    { "gameKey": "BaseParam#1.2", "hash": "33B3502FF4EDCBE6", "target": "Wpływa na siłę fizycznych ataków mieczami jednoręcznymi, toporami dwuręcznymi, mieczami dwuręcznymi, ostrzami z mechanizmem strzeleckim, bronią do walki wręcz, włóczniami dwuręcznymi, katanami, kosami dwuręcznymi, toporami jednoręcznymi, przyborami magii klątw, księgami magicznymi, rapierami, pędzlami, orężem błękitnych magów, przyborami zaklinaczy, globusami nieba i orężem mędrców." },
