    { "gameKey": "MJIText#46", "hash": "4C4EA395B83506EF", "target": "Kwitnienie" },
    { "gameKey": "MJIText#47", "hash": "57BCF7DA36FF35AF", "target": "Twój przyczółek w tej nieujarzmionej krainie, sklecony naprędce z materiałów zebranych w dziczy." },
    { "gameKey": "MJIText#48", "hash": "B1C0E2B1B3F85B45", "target": "Serce twojego wyspiarskiego przedsięwzięcia, o jeden przytulny krok powyżej niezbędnego minimum." },
    { "gameKey": "MJIText#49", "hash": "5423FBD015B63289", "target": "Podstawa twojego kwitnącego wyspiarskiego przedsięwzięcia, w pełni odnowiona przez mammety biegłe w stolarstwie." },
    { "gameKey": "MJIText#50", "hash": "BA22E7D21BB11B67", "target": "Cztery ściany i dach, pod którym twoje rozpromienione mammety z zapałem wytwarzają rękodzieło." },
    { "gameKey": "MJIText#51", "hash": "7A9448F6945BC14F", "target": "Praktyczny, choć skromny obiekt, w którym twoje niezawodne mammety wytwarzają wyroby rzemieślnicze." },
    { "gameKey": "MJIText#52", "hash": "80A1EA805EDCAAEF", "target": "Okazałe miejsce pracy zaprojektowane z myślą o zawodowych mammetach rzemieślnikach." },
    { "gameKey": "MJIText#53", "hash": "77E28AB2D227CF9B", "target": "Podstawowy magazyn materiałów z wyspy i miejsce zbiórki mammetów wyruszających na wyprawy badawcze." },
    { "gameKey": "MJIText#54", "hash": "D8E980370B3409C7", "target": "Obiekt dysponujący przestrzenią magazynową i zasobami wystarczającymi, by wspierać niezawodną drużynę mammetów zbierających surowce." },
    { "gameKey": "MJIText#55", "hash": "BE5204087E12FC77", "target": "Przestronna wyspiarska składnica najwyższej klasy, obsługiwana przez elitarnych zbieraczy wśród mammetów. " },
    { "gameKey": "MJIText#56", "hash": "C42037F5AE413FF9", "target": "Pusta działka pełna architektonicznego potencjału." },
    { "gameKey": "MJIText#57", "hash": "C9682342FB85033E", "target": "Olbrzymie, wirujące skrzydła nie tyle spełnią twe wzniosłe marzenia, ile napędzą młyn mielący twoje zboże. Uwielbiane przez wyspiarskie mammety." },
    { "gameKey": "MJIText#58", "hash": "0F5C82B39126B04E", "target": "Zaciszna kryjówka wśród wysokich, zielonych konarów. Uwielbiana przez wyspiarskie mammety." },
    { "gameKey": "MJIText#59", "hash": "1ACC370C77083739", "target": "Pełne dobrych chęci automaty odpowiedzialne za temperaturę tej uroczej kąpieli pod gołym niebem przechwalają się, że wypali ona nieczystości z twojej skóry i pozostawi cię w czystości... jeśli przeżyjesz. Uwielbiana przez wyspiarskie mammety." },
    { "gameKey": "MJIText#60", "hash": "4DD06BE263B87A25", "target": "Choć materiały były ograniczone, a mammety pełniące rolę architektów toczyły gorące spory o wizję artystyczną, dołożono wielkich starań, by zbudować tę latarnię morską w stylu lominsańskim. Uwielbiana przez wyspiarskie mammety." },
    { "gameKey": "MJIText#61", "hash": "F23D90896867CBEF", "target": "Odpowiedź na odwieczne pytanie─wydra <italic(1)>tryskająca<italic(0)> wodą potrafi być jeszcze dziwniejsza niż wydra poza wodą. Uwielbiana przez wyspiarskie mammety." },
    { "gameKey": "MJIText#62", "hash": "FC1D8A18ECEA6DDC", "target": "Pole uprawne" },
    { "gameKey": "MJIText#63", "hash": "A08483F4565D2E4C", "target": "Pastwisko" },
    { "gameKey": "MJIText#64", "hash": "11DA545A1628A617", "target": "Grządki żyznej, spulchnionej ziemi, doskonałe do uprawy roślin." },
    { "gameKey": "MJIText#65", "hash": "3D940F0B79DFE3F9", "target": "Bujna, zielona łąka, na której znajdą miejsce wyspiarskie zwierzęta wszelkich kształtów i rozmiarów." },
    { "gameKey": "MJIText#66", "hash": "6ABB3F169506C94A", "target": "Indeks gospodarza wyspy" },
    { "gameKey": "MJIText#67", "hash": "5EFEC6D34174DCCE", "target": "Rozbrykany ogród" },
    { "gameKey": "MJIText#68", "hash": "432D594B8E8178F0", "target": "Ten tak zwany „ogród” to w istocie plac zabaw wymyślony przez grupę mammetów, które potajemnie tworzą własny raj, budowla po budowli. Uwielbiany przez wyspiarskie mammety." },
    { "gameKey": "MJIText#69", "hash": "BC6B5F3FAF761D07", "target": "Spichlerz IV" },
    { "gameKey": "MJIText#70", "hash": "CFEB8C1E9CBBA836", "target": "Spichlerz V" },
    { "gameKey": "MJIText#71", "hash": "56B6F3239C777BA8", "target": "Kruszejące Groty" },
    { "gameKey": "MJIText#72", "hash": "CEAF047C80BC6549", "target": "Najnowocześniejszy obiekt zaprojektowany specjalnie z myślą o wsparciu doświadczonych mammetów zbieraczy." },
    { "gameKey": "MJIText#73", "hash": "E34923BFB8077B50", "target": "Przytulna chata IV" },
    { "gameKey": "MJIText#74", "hash": "D44F933ADFA3E422", "target": "Elegancki dowód sukcesu i wyspiarskiej zamożności, od dziobu po solidną drugą kondygnację." },
    { "gameKey": "MJIText#75", "hash": "9C53900D7BEBD707", "target": "Warsztat IV" },
    { "gameKey": "MJIText#76", "hash": "A7C8FD86454CA7CD", "target": "Usprawniony obiekt stworzony, by jeszcze podnieść imponującą już wydajność doświadczonych mammetów rzemieślników." },
    { "gameKey": "MJIText#77", "hash": "827033EE4A4815CB", "target": "Bruk ceglany" },
    { "gameKey": "MJIText#78", "hash": "D59943700F30A8B6", "target": "Bruk ceglany" },
    { "gameKey": "MJIText#79", "hash": "9CB2155A264A5D5D", "target": "Bruk ceglany" },
    { "gameKey": "MJIText#80", "hash": "7A147D2632E1E40F", "target": "Niezbadany szlak" },
    { "gameKey": "MJIText#81", "hash": "DC30DA8AEACEE975", "target": "Co zaczęło się jako fregata, skończyło jako miejsce zabaw. Uwielbiane przez wyspiarskie mammety." },
    { "gameKey": "MJIText#82", "hash": "F9AF7658A98306C6", "target": "Urokliwa wieża zegarowa" },
    { "gameKey": "MJIText#83", "hash": "3584B61724386BE2", "target": "Spokojnie odmierzający czas zegar z wolno kołyszącym się wahadłem. Uwielbiany przez wyspiarskie mammety." },
    { "gameKey": "MJIText#84", "hash": "A8937C7A9DACC32D", "target": "Ambicja gospodarza wyspy" },
    { "gameKey": "MJIText#85", "hash": "D93C84269768B121", "target": "Punkt widokowy gospodarza wyspy" },
    { "gameKey": "MJIText#86", "hash": "6D996FDB7BBE0FA0", "target": "Wspaniały magazyn przeznaczony wyłącznie dla mistrzowskich mammetów zbieraczy." },
    { "gameKey": "MJIText#87", "hash": "31161AE1AD709271", "target": "Przytulna chata V" },
    { "gameKey": "MJIText#88", "hash": "76AA8BBD8A314D5C", "target": "Wystawny dowód korzyści płynących z wyspiarskiej przedsiębiorczości. " },
    { "gameKey": "MJIText#89", "hash": "2BC1B8F6B4455A9F", "target": "Warsztat V" },
    { "gameKey": "MJIText#90", "hash": "73105B9BEAA2CB92", "target": "Imponujący zakład pracy wyposażony we wszystko, czego potrzeba zręcznym dłoniom mistrzowskich mammetów-rzemieślników." },
    { "gameKey": "MJIText#91", "hash": "593E20062E6AEB13", "target": "Eteryczny gaj" },
    { "gameKey": "MJIText#92", "hash": "5FA57A856F3BBC09", "target": "Niezwykłe połączenie drzewa i kryształu emanujące potężną energią eteryczną. Uwielbiane przez wyspiarskie mammety." },
    { "gameKey": "MJIText#93", "hash": "75E49F41459E85C2", "target": "Sanktuarium na wyspie" },
    { "gameKey": "MJIText#94", "hash": "77C7B57A249D7099", "target": "Wymyślone przez mammety szukające schronienia w sanktuarium, które do nich nie należy. Uwielbiane przez mammety z wyspy." },
    { "gameKey": "MJIText#95", "hash": "B2A8745FA912D87D", "target": "Czerwona cegła" },
    { "gameKey": "MJIText#96", "hash": "A0CADAAD656163C5", "target": "Czerwona cegła" },
