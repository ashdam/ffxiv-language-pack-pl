{
  "sheet": "MKDSupportJob",
  "gameVersion": "2026.10.16.0000.0000",
  "entries": [
    { "gameKey": "MKDSupportJob#0.0", "hash": "4BBA88EAFD0DFFBE", "target": "Phantom Freelancer" },
    { "gameKey": "MKDSupportJob#0.1", "hash": "76F611C565F60298", "target": "Ph. Freelancer" },
    { "gameKey": "MKDSupportJob#0.3", "hash": "3953277178CB9660", "target": "Wspomnienia wędrówek dopiero rozpoczętych i dawno zakończonych ucieleśniają rozmaite techniki wsparcia wolnego poszukiwacza przygód." },
    { "gameKey": "MKDSupportJob#0.4", "hash": "412B1D804A96C865", "target": "Phantom Freelancer" },
    { "gameKey": "MKDSupportJob#1.0", "hash": "C30351012BBD5294", "target": "Phantom Knight" },
    { "gameKey": "MKDSupportJob#1.1", "hash": "B7742C3F6F6062BA", "target": "Ph. Knight" },
    { "gameKey": "MKDSupportJob#1.3", "hash": "CB4EAD52D55681A1", "target": "Naśladuj pradawne wspomnienia wiernego, honorowego rycerza i broń towarzyszy przed krzywdą." },
    { "gameKey": "MKDSupportJob#1.4", "hash": "17736741DE595AC3", "target": "Phantom Knight" },
    { "gameKey": "MKDSupportJob#2.0", "hash": "8A42DD63A3ACF012", "target": "Phantom Berserker" },
    { "gameKey": "MKDSupportJob#2.1", "hash": "01CD0B177F6F1679", "target": "Ph. Berserker" },
    { "gameKey": "MKDSupportJob#2.3", "hash": "E669094F2B1A4CD3", "target": "Dzikość i niezawodna odwaga cechują wspomnienia dawnego berserkera. Te techniki niosą wielkie ryzyko i jeszcze większą nagrodę." },
    { "gameKey": "MKDSupportJob#2.4", "hash": "6ECCC42B7579E461", "target": "Phantom Berserker" },
    { "gameKey": "MKDSupportJob#3.0", "hash": "C2D12FB2C9B6A31B", "target": "Phantom Monk" },
    { "gameKey": "MKDSupportJob#3.1", "hash": "C21E1151B4A1B77E", "target": "Ph. Monk" },
    { "gameKey": "MKDSupportJob#3.3", "hash": "E417CA80B42BF051", "target": "Te wspomnienia niezłomnej dyscypliny i cichej medytacji mnicha wskazują drogę do niezrównanego mistrzostwa walki." },
    { "gameKey": "MKDSupportJob#3.4", "hash": "6051667EAF00102B", "target": "Phantom Monk" },
    { "gameKey": "MKDSupportJob#4.0", "hash": "065E7EE7FD1AA355", "target": "Phantom Ranger" },
    { "gameKey": "MKDSupportJob#4.1", "hash": "DA40B205203EED50", "target": "Ph. Ranger" },
    { "gameKey": "MKDSupportJob#4.3", "hash": "A8D4B3F06ADAF857", "target": "Przywołaj te wspomnienia dumnego, pełnego zapału tropiciela i naucz się wzywać w walce siły natury." },
    { "gameKey": "MKDSupportJob#4.4", "hash": "83A1E8B0063A048F", "target": "Phantom Ranger" },
    { "gameKey": "MKDSupportJob#5.0", "hash": "C1202425AB9661AB", "target": "Phantom Samurai" },
    { "gameKey": "MKDSupportJob#5.1", "hash": "0CB15F0D72E73D90", "target": "Ph. Samurai" },
    { "gameKey": "MKDSupportJob#5.3", "hash": "AAEC0E4F6CD5B280", "target": "Surowy trening i ścisły kodeks rycerski ucieleśniają te wspomnienia pradawnego samuraja. Sięgnij do nich, by powalać wrogów jednym śmiertelnym ciosem." },
    { "gameKey": "MKDSupportJob#5.4", "hash": "FE05F616139A5E46", "target": "Phantom Samurai" },
    { "gameKey": "MKDSupportJob#6.0", "hash": "589CD9793E04FCCF", "target": "Phantom Bard" },
    { "gameKey": "MKDSupportJob#6.1", "hash": "84B332711BFCCE26", "target": "Ph. Bard" },
    { "gameKey": "MKDSupportJob#6.3", "hash": "4AEE4A89EAF12ED2", "target": "Wspomnienia te rozbrzmiewają żywymi obrazami melodyjnej pieśni barda. Wykorzystaj je, by stosować te same ballady w walce." },
    { "gameKey": "MKDSupportJob#6.4", "hash": "678FD76402DFA2FD", "target": "Phantom Bard" },
    { "gameKey": "MKDSupportJob#7.0", "hash": "59D75D44C52FCB24", "target": "Phantom Geomancer" },
    { "gameKey": "MKDSupportJob#7.1", "hash": "B74B3ED77A609765", "target": "Ph. Geomancer" },
    { "gameKey": "MKDSupportJob#7.3", "hash": "9CA0BD2D2881BBBC", "target": "Wspomnienia tego geomanty kipią bezgranicznym zrozumieniem praw natury. Sięgnij do nich, by stosować techniki zależne od pogody." },
    { "gameKey": "MKDSupportJob#7.4", "hash": "B35CECE4CF63F8D8", "target": "Phantom Geomancer" },
    { "gameKey": "MKDSupportJob#8.0", "hash": "831F8E32CA8D8E00", "target": "Phantom Time Mage" },
    { "gameKey": "MKDSupportJob#8.1", "hash": "0EFB1F2F9815D989", "target": "Ph. Time Mage" },
    { "gameKey": "MKDSupportJob#8.3", "hash": "EC6B14041C7FED64", "target": "Wspomnienia tego dawnego maga czasu wiele ujawniają o prawach czasu i o tym, jak naginać je na swoją korzyść." },
    { "gameKey": "MKDSupportJob#8.4", "hash": "67933EE6C17A84FF", "target": "Phantom Time Mage" },
    { "gameKey": "MKDSupportJob#9.0", "hash": "CEC9A57C7236801F", "target": "Phantom Cannoneer" },
    { "gameKey": "MKDSupportJob#9.1", "hash": "50DCC7A7B0DB6A78", "target": "Ph. Cannoneer" },
    { "gameKey": "MKDSupportJob#9.3", "hash": "50996DEA327C7143", "target": "Wspomnienia tego artylerzysty nasyca zarówno teoretyczne, jak i praktyczne mistrzostwo balistyki. Naśladuj je, by bombardować wrogów potężnymi pociskami." },
    { "gameKey": "MKDSupportJob#9.4", "hash": "7B88AE375932635D", "target": "Phantom Cannoneer" },
    { "gameKey": "MKDSupportJob#10.0", "hash": "EB96F82B0BEA7553", "target": "Phantom Chemist" },
    { "gameKey": "MKDSupportJob#10.1", "hash": "8A4AFCEF656A7A43", "target": "Ph. Chemist" },
    { "gameKey": "MKDSupportJob#10.3", "hash": "AEC479FDD0A03016", "target": "Wspomnienia tego aptekarza oferują znajomość pradawnej teorii medycyny, w tym technik regeneracyjnych, które z pewnością przechylą szalę bitwy na twoją korzyść." },
    { "gameKey": "MKDSupportJob#10.4", "hash": "D3FC862A930971C4", "target": "Phantom Chemist" },
    { "gameKey": "MKDSupportJob#11.0", "hash": "87E4C2A262E3EA1C", "target": "Phantom Oracle" },
    { "gameKey": "MKDSupportJob#11.1", "hash": "C150467564E3CA95", "target": "Ph. Oracle" },
    { "gameKey": "MKDSupportJob#11.3", "hash": "E643C03BA734F9E9", "target": "Te wspomnienia, obdarzone nadnaturalnymi zmysłami i proroczym wglądem wieszcza, obiecują mistrzostwo licznych umiejętności wsparcia." },
    { "gameKey": "MKDSupportJob#11.4", "hash": "82DE7552F738268E", "target": "Phantom Oracle" },
    { "gameKey": "MKDSupportJob#12.0", "hash": "0E505003A09E9C8C", "target": "Phantom Thief" },
    { "gameKey": "MKDSupportJob#12.1", "hash": "7062667C38345050", "target": "Ph. Thief" },
    { "gameKey": "MKDSupportJob#12.3", "hash": "82D4D91A9FF89098", "target": "Te wspomnienia zręcznego złodzieja o silnych zasadach udostępniają techniki przetrwania, które bez wątpienia przydadzą się na wyspie." },
    { "gameKey": "MKDSupportJob#12.4", "hash": "D98643AC83B63A4B", "target": "Phantom Thief" },
    { "gameKey": "MKDSupportJob#13.0", "hash": "580BE9E28DEDF63F", "target": "Phantom Mystic Knight" },
    { "gameKey": "MKDSupportJob#13.1", "hash": "C96DC7260A5B8906", "target": "Ph. Mystic Knight" },
    { "gameKey": "MKDSupportJob#13.3", "hash": "F574493F67998A4E", "target": "Te wspomnienia, przeniknięte pilnością i magiczną biegłością mistycznego rycerza, są kluczem do nasycania broni potężnymi zaklęciami." },
    { "gameKey": "MKDSupportJob#13.4", "hash": "DFE8A9B1362DC23C", "target": "Phantom Mystic Knight" },
    { "gameKey": "MKDSupportJob#14.0", "hash": "C02E96D721E11BF4", "target": "Phantom Gladiator" },
    { "gameKey": "MKDSupportJob#14.1", "hash": "6F1EEEE07DB9D981", "target": "Ph. Gladiator" },
    { "gameKey": "MKDSupportJob#14.3", "hash": "683446439DBC4214", "target": "Wspomnienia tego zaciekłego, nieugiętego gladiatora obiecują opanowanie niezliczonych umiejętności ataku i obrony." },
    { "gameKey": "MKDSupportJob#14.4", "hash": "BC54C9F41DB74D02", "target": "Phantom Gladiator" },
    { "gameKey": "MKDSupportJob#15.0", "hash": "B09D27343AEBC7E1", "target": "Phantom Dancer" },
    { "gameKey": "MKDSupportJob#15.1", "hash": "1582410AA34A561E", "target": "Ph. Dancer" },
    { "gameKey": "MKDSupportJob#15.3", "hash": "D69F7B825DC00C36", "target": "Wchłoń wspomnienia podniosłego, ekspresyjnego tancerza, by odtworzyć jego zwinne kroki i obdarzyć się szeregiem dobrodziejstw." },
    { "gameKey": "MKDSupportJob#15.4", "hash": "D20C5321D6BD6B1A", "target": "Phantom Dancer" },
    { "gameKey": "MKDSupportJob#16.0", "hash": "06B2B0A5C99F2DBD", "target": "Phantom Ninja" },
    { "gameKey": "MKDSupportJob#16.1", "hash": "8F56E876FC401C4F", "target": "Ph. Ninja" },
    { "gameKey": "MKDSupportJob#16.3", "hash": "9B8B077ECB331126", "target": "Te wspomnienia skrytości i bezruchu ninja przydadzą się w wielu niebezpiecznych sytuacjach." },
    { "gameKey": "MKDSupportJob#16.4", "hash": "E919C3298694CC35", "target": "Phantom Ninja" },
    { "gameKey": "MKDSupportJob#17.0", "hash": "5BC2270F54F27FFF", "target": "Phantom White Mage" },
    { "gameKey": "MKDSupportJob#17.1", "hash": "4D9EC77ECD475A41", "target": "Ph. White Mage" },
    { "gameKey": "MKDSupportJob#17.3", "hash": "EE540B6859FF054A", "target": "Osiągnij mistrzostwo technik leczniczych dzięki kojącym wspomnieniom oddanego białego maga." },
    { "gameKey": "MKDSupportJob#17.4", "hash": "117C41EC028D1088", "target": "Phantom White Mage" },
    { "gameKey": "MKDSupportJob#18.0", "hash": "B55880FFAF6CDBB3", "target": "Phantom Black Mage" },
    { "gameKey": "MKDSupportJob#18.1", "hash": "060A666F2F67EF1B", "target": "Ph. Black Mage" },
    { "gameKey": "MKDSupportJob#18.3", "hash": "C86FDA97E5196C90", "target": "Te wspomnienia, nasycone gorliwymi badaniami i eksperymentami czarnego maga, obdarzą cię magiczną sztuką zniszczenia." },
    { "gameKey": "MKDSupportJob#18.4", "hash": "43693A42F118A904", "target": "Phantom Black Mage" },
    { "gameKey": "MKDSupportJob#19.0", "hash": "E12C161BABF06A4B", "target": "Phantom Dragoon" },
    { "gameKey": "MKDSupportJob#19.1", "hash": "44CEDF3B21385198", "target": "Ph. Dragoon" },
    { "gameKey": "MKDSupportJob#19.3", "hash": "EF9EFF2C6C3E6508", "target": "Wspomnienia podróży wyszkolonego smoczego rycerza nauczą cię bezkarnie skakać i przeszywać wrogów." },
    { "gameKey": "MKDSupportJob#19.4", "hash": "29A845E91EC643D0", "target": "Phantom Dragoon" },
    { "gameKey": "MKDSupportJob#20.0", "hash": "CAA854A5D2DDF058", "target": "Phantom Summoner" },
    { "gameKey": "MKDSupportJob#20.1", "hash": "5634B4CB24388E2F", "target": "Ph. Summoner" },
    { "gameKey": "MKDSupportJob#20.3", "hash": "3385F14B21EA5D19", "target": "Przywołaj wspomnienia wykształconego, doświadczonego przywoływacza i naucz się wzywać potężne stworzenia biegłe zarówno w ataku, jak i obronie." },
    { "gameKey": "MKDSupportJob#20.4", "hash": "73CE0E0896122F2C", "target": "Phantom Summoner" },
    { "gameKey": "MKDSupportJob#21.0", "hash": "5CCD5CC7B3E6F47A", "target": "Phantom Blue Mage" },
    { "gameKey": "MKDSupportJob#21.1", "hash": "30F3F4C56BC1AB83", "target": "Ph. Blue Mage" },
    { "gameKey": "MKDSupportJob#21.3", "hash": "9620855D71CD7A69", "target": "Wspomnienia tego znużonego światem czarnoksiężnika przesiąka głęboka paranoja. Sięgnij do nich, by zyskać potworną moc w magicznej postaci." },
    { "gameKey": "MKDSupportJob#21.4", "hash": "B9F232A4A3E2C154", "target": "Phantom Blue Mage" },
    { "gameKey": "MKDSupportJob#22.0", "hash": "CF9AC10BF9144C53", "target": "Phantom Red Mage" },
    { "gameKey": "MKDSupportJob#22.1", "hash": "D635707728341CB4", "target": "Ph. Red Mage" },
    { "gameKey": "MKDSupportJob#22.3", "hash": "18FA63CFE418CB82", "target": "Wspomnienia dowcipnego, wędrownego czerwonego maga pozwolą ci władać czarną i białą magią w doskonałej równowadze." },
    { "gameKey": "MKDSupportJob#22.4", "hash": "6A0D9809BA858A47", "target": "Phantom Red Mage" },
    { "gameKey": "MKDSupportJob#23.0", "hash": "1E9E4CD0C908D103", "target": "Phantom Necromancer" },
    { "gameKey": "MKDSupportJob#23.1", "hash": "82C92D9A2376B333", "target": "Ph. Necromancer" },
    { "gameKey": "MKDSupportJob#23.3", "hash": "01DC065F9E320F23", "target": "Wspomnienia te, skażone uporem sprofanowanego nekromanty, obiecują moc walki nawet po śmierci." },
    { "gameKey": "MKDSupportJob#23.4", "hash": "B460ADB08BA7DE76", "target": "Phantom Necromancer" }
  ]
}
