{
  "sheet": "TripleTriadRule",
  "gameVersion": "2026.10.06.0000.0000",
  "entries": [
    { "gameKey": "TripleTriadRule#1.0", "hash": "9900BF0908925FDD", "target": "Ruletka" },
    { "gameKey": "TripleTriadRule#1.1", "hash": "DAB0D1C13A07BA11", "target": "Obowiązujące zasady są wybierane losowo." },
    { "gameKey": "TripleTriadRule#2.0", "hash": "8AB8D4CFEE6C9267", "target": "Wszystkie odkryte" },
    { "gameKey": "TripleTriadRule#2.1", "hash": "BBAD9E8156D75F08", "target": "Obie talie są odkryte." },
    { "gameKey": "TripleTriadRule#3.0", "hash": "480C4E4E8878A3D4", "target": "Trzy odkryte" },
    { "gameKey": "TripleTriadRule#3.1", "hash": "B83A782E72DA7C94", "target": "Trzy losowe karty z każdej talii są odkryte." },
    { "gameKey": "TripleTriadRule#4.0", "hash": "6619EF4066D7A53B", "target": "Równe wartości" },
    { "gameKey": "TripleTriadRule#4.1", "hash": "86D84AE165E1A915", "target": "Jeśli co najmniej dwa boki wyłożonej karty stykają się z innymi kartami i ich wartości są równe wartościom stykających się boków tych kart, sąsiednie karty zostają odwrócone." },
    { "gameKey": "TripleTriadRule#5.0", "hash": "F92399AB03D332D4", "target": "Nagła śmierć" },
    { "gameKey": "TripleTriadRule#5.1", "hash": "B368E2E726085D2E", "target": "Po remisie rozgrywany jest mecz rozstrzygający. Każdy gracz używa w nim przejętych kart." },
    { "gameKey": "TripleTriadRule#6.0", "hash": "166AE3EAA129AEB9", "target": "Plus" },
    { "gameKey": "TripleTriadRule#6.1", "hash": "FA5E0AD57B19E00B", "target": "Jeśli co najmniej dwa boki wyłożonej karty stykają się z innymi kartami, a sumy wartości każdej pary stykających się boków są równe, sąsiednie karty zostają odwrócone." },
    { "gameKey": "TripleTriadRule#7.0", "hash": "C6F376A5FA2108E5", "target": "Losowo" },
    { "gameKey": "TripleTriadRule#7.1", "hash": "8F78CCFB246D2467", "target": "Talie są losowane z kart posiadanych przez graczy." },
    { "gameKey": "TripleTriadRule#8.0", "hash": "0D910283A9833DC6", "target": "Kolejność" },
    { "gameKey": "TripleTriadRule#8.1", "hash": "6869157DDEA53EA3", "target": "Karty należy wykładać w kolejności, w jakiej znajdują się w talii." },
    { "gameKey": "TripleTriadRule#9.0", "hash": "250B05AE2CD0C21B", "target": "Chaos" },
    { "gameKey": "TripleTriadRule#9.1", "hash": "8903A3DD0C5ADAAB", "target": "Karty należy wykładać w losowej kolejności ustalonej przed meczem." },
    { "gameKey": "TripleTriadRule#10.0", "hash": "A5B3BF02345FD6A8", "target": "Odwrócenie" },
    { "gameKey": "TripleTriadRule#10.1", "hash": "AE356ABEAB5294AA", "target": "Niższe wartości odwracają wyższe." },
    { "gameKey": "TripleTriadRule#11.0", "hash": "5D2AC7238ABD7564", "target": "Upadły as" },
    { "gameKey": "TripleTriadRule#11.1", "hash": "8156C4C01A07B89F", "target": "Bok o wartości 1 może odwrócić bok o wartości A. Przy zasadzie Odwrócenie bok o wartości A odwraca bok o wartości 1." },
    { "gameKey": "TripleTriadRule#12.0", "hash": "69639697C876676A", "target": "Wzmocnienie" },
    { "gameKey": "TripleTriadRule#12.1", "hash": "39ACD397A2AB2886", "target": "Wartości karty wzrastają proporcjonalnie do liczby już wyłożonych kart tego samego typu." },
    { "gameKey": "TripleTriadRule#13.0", "hash": "1534E53BECDECDC6", "target": "Osłabienie" },
    { "gameKey": "TripleTriadRule#13.1", "hash": "93FCA575A192ED88", "target": "Wartości karty maleją proporcjonalnie do liczby już wyłożonych kart tego samego typu." },
    { "gameKey": "TripleTriadRule#14.0", "hash": "D50CB1818C182F20", "target": "Zamiana" },
    { "gameKey": "TripleTriadRule#14.1", "hash": "DEB2AA8786C5F17F", "target": "Jedna losowa karta z talii każdego gracza zostaje zamieniona z kartą drugiego gracza." },
    { "gameKey": "TripleTriadRule#15.0", "hash": "EE9C8CD7206DBAAD", "target": "Dobór" },
    { "gameKey": "TripleTriadRule#15.1", "hash": "96CC07CF6F196522", "target": "Talie należy zbudować z zestawu losowo wybranych kart." }
  ]
}
