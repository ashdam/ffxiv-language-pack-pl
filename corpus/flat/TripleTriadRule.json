{
  "sheet": "TripleTriadRule",
  "gameVersion": "2026.10.16.0000.0000",
  "entries": [
    { "gameKey": "TripleTriadRule#1.0", "hash": "9900BF0908925FDD", "target": "Ruletka" },
    { "gameKey": "TripleTriadRule#1.1", "hash": "DAB0D1C13A07BA11", "target": "Zasady są ustalane losowo." },
    { "gameKey": "TripleTriadRule#2.0", "hash": "8AB8D4CFEE6C9267", "target": "Odkryte karty" },
    { "gameKey": "TripleTriadRule#2.1", "hash": "BBAD9E8156D75F08", "target": "Obaj gracze pokazują wszystkie karty na ręce." },
    { "gameKey": "TripleTriadRule#3.0", "hash": "480C4E4E8878A3D4", "target": "Trzy odkryte" },
    { "gameKey": "TripleTriadRule#3.1", "hash": "B83A782E72DA7C94", "target": "Obaj gracze pokazują trzy losowo wybrane karty z ręki." },
    { "gameKey": "TripleTriadRule#4.0", "hash": "6619EF4066D7A53B", "target": "Równe boki" },
    { "gameKey": "TripleTriadRule#4.1", "hash": "86D84AE165E1A915", "target": "Jeśli co najmniej dwa boki wykładanej karty mają taką samą wartość jak przylegające boki sąsiednich kart, przejmujesz te karty." },
    { "gameKey": "TripleTriadRule#5.0", "hash": "F92399AB03D332D4", "target": "Dogrywka" },
    { "gameKey": "TripleTriadRule#5.1", "hash": "B368E2E726085D2E", "target": "Po remisie gracze rozgrywają kolejny pojedynek taliami złożonymi z kart, które kontrolowali na koniec poprzedniego." },
    { "gameKey": "TripleTriadRule#6.0", "hash": "166AE3EAA129AEB9", "target": "Plus" },
    { "gameKey": "TripleTriadRule#6.1", "hash": "FA5E0AD57B19E00B", "target": "Jeśli po wyłożeniu karty sumy wartości stykających się boków są równe w co najmniej dwóch parach, przejmujesz sąsiednie karty z tych par." },
    { "gameKey": "TripleTriadRule#7.0", "hash": "C6F376A5FA2108E5", "target": "Losowa ręka" },
    { "gameKey": "TripleTriadRule#7.1", "hash": "8F78CCFB246D2467", "target": "Każdy gracz rozgrywa pojedynek pięcioma losowymi kartami ze swojej kolekcji." },
    { "gameKey": "TripleTriadRule#8.0", "hash": "0D910283A9833DC6", "target": "Po kolei" },
    { "gameKey": "TripleTriadRule#8.1", "hash": "6869157DDEA53EA3", "target": "Obaj gracze wykładają karty w kolejności, w której ułożyli je w talii." },
    { "gameKey": "TripleTriadRule#9.0", "hash": "250B05AE2CD0C21B", "target": "Chaos" },
    { "gameKey": "TripleTriadRule#9.1", "hash": "8903A3DD0C5ADAAB", "target": "Obaj gracze wykładają karty w losowo ustalonej kolejności." },
    { "gameKey": "TripleTriadRule#10.0", "hash": "A5B3BF02345FD6A8", "target": "Odwrócenie" },
    { "gameKey": "TripleTriadRule#10.1", "hash": "AE356ABEAB5294AA", "target": "Siła kart jest odwrócona: niższe wartości pokonują wyższe." },
    { "gameKey": "TripleTriadRule#11.0", "hash": "5D2AC7238ABD7564", "target": "Zabójca asów" },
    { "gameKey": "TripleTriadRule#11.1", "hash": "8156C4C01A07B89F", "target": "Wartość 1 pokonuje A. Przy „Odwróceniu” A pokonuje 1." },
    { "gameKey": "TripleTriadRule#12.0", "hash": "69639697C876676A", "target": "Premia typu" },
    { "gameKey": "TripleTriadRule#12.1", "hash": "39ACD397A2AB2886", "target": "Wartości kart danego typu rosną o liczbę kart tego typu leżących na stole." },
    { "gameKey": "TripleTriadRule#13.0", "hash": "1534E53BECDECDC6", "target": "Kara typu" },
    { "gameKey": "TripleTriadRule#13.1", "hash": "93FCA575A192ED88", "target": "Wartości kart danego typu maleją o liczbę kart tego typu leżących na stole." },
    { "gameKey": "TripleTriadRule#14.0", "hash": "D50CB1818C182F20", "target": "Zamiana" },
    { "gameKey": "TripleTriadRule#14.1", "hash": "DEB2AA8786C5F17F", "target": "Przed pojedynkiem gracze zamieniają się jedną losową kartą ze swoich talii." },
    { "gameKey": "TripleTriadRule#15.0", "hash": "EE9C8CD7206DBAAD", "target": "Dobór" },
    { "gameKey": "TripleTriadRule#15.1", "hash": "96CC07CF6F196522", "target": "Gracze budują talie z losowo oferowanych kart i rozgrywają pojedynek." }
  ]
}
