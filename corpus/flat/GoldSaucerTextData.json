    { "gameKey": "GoldSaucerTextData#110", "hash": "84D84A7AAD4E841E", "target": "Witamy na trasie treningowej!" },
    { "gameKey": "GoldSaucerTextData#111", "hash": "BF96EA78D17D50F6", "target": "Wykonaj wszystkie polecenia trenera wyścigowego." },
    { "gameKey": "GoldSaucerTextData#112", "hash": "083C747FAFA061C5", "target": "Trasa treningowa ukończona!" },
    { "gameKey": "GoldSaucerTextData#113", "hash": "44DDF474A61E236B", "target": "???" },
    { "gameKey": "GoldSaucerTextData#114", "hash": "331032DD412E0D00", "target": "Przyspiesz." },
    { "gameKey": "GoldSaucerTextData#115", "hash": "B9B72CBD091A456E", "target": "Przyspieszaj aż do wyczerpania wytrzymałości." },
    { "gameKey": "GoldSaucerTextData#116", "hash": "7420BA74E4139502", "target": "Przyspiesz do pełnej prędkości, a następnie zwolnij." },
    { "gameKey": "GoldSaucerTextData#117", "hash": "A1B2E1AD8FF332E9", "target": "Steruj." },
    { "gameKey": "GoldSaucerTextData#118", "hash": "D5BAA5E9CB636E76", "target": "Uruchom magiczny panel." },
    { "gameKey": "GoldSaucerTextData#119", "hash": "2381DFBA4F0A0797", "target": "Skocz." },
    { "gameKey": "GoldSaucerTextData#120", "hash": "F13C0DB98DE78C14", "target": "Otwórz skrzynię ze skarbem." },
    { "gameKey": "GoldSaucerTextData#121", "hash": "45338633B4148BD3", "target": "Użyj przedmiotu wyścigowego." },
    { "gameKey": "GoldSaucerTextData#131", "hash": "7A864D6C4FC26089", "target": "Zasady Mini Cactpot są proste. Najpierw odkrywasz trzy liczby z ośmiu ukrytych na losie. Następnie wybierasz jedną z ośmiu linii─pionową, poziomą lub ukośną." },
    { "gameKey": "GoldSaucerTextData#132", "hash": "F1E5994A1E7CD945", "target": "Po wybraniu linii zostają odkryte wszystkie liczby, a suma trzech liczb w wybranej linii określa wygraną MGP. To takie proste!" },
    { "gameKey": "GoldSaucerTextData#133", "hash": "AB0CA2D93927EBE4", "target": "Teraz wystarczy wybrać czterocyfrowy numer. Zwycięski numer zostanie wylosowany później. Jeśli zgadza się ostatnia cyfra twojego numeru, wygrywasz czwartą nagrodę. Dwie zgodne ostatnie cyfry dają trzecią, trzy─drugą, a zgodność wszystkich cyfr przynosi główną wygraną." },
    { "gameKey": "GoldSaucerTextData#139", "hash": "467D32F4D6911F58", "target": "Wyzwania chocobo" },
