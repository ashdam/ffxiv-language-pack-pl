    { "gameKey": "GoldSaucerTextData#51", "hash": "C57DA856F2682C53", "target": "Wazon na wynos" },
    { "gameKey": "GoldSaucerTextData#52", "hash": "60E7E85E69077756", "target": "Dostarczone wazony" },
    { "gameKey": "GoldSaucerTextData#61", "hash": "9B419500ED2259E7", "target": "Życie jest tańcem" },
    { "gameKey": "GoldSaucerTextData#62", "hash": "A02D0C58F2FF6196", "target": "Wejdź na główną scenę i zapamiętaj układ wielkiego numeru tanecznego." },
    { "gameKey": "GoldSaucerTextData#63", "hash": "5DA7F609BA7D6CB1", "target": "Zapamiętaj układ panów i pań tańca i wykonaj bezbłędnie na dany znak co najmniej dziesięć ruchów." },
    { "gameKey": "GoldSaucerTextData#64", "hash": "EAFA31257BA70C03", "target": "Pierwsza zwrotka" },
    { "gameKey": "GoldSaucerTextData#65", "hash": "85AA84002FCBFD1A", "target": "Druga zwrotka" },
    { "gameKey": "GoldSaucerTextData#66", "hash": "0D8FB4B3378C85FB", "target": "Trzecia zwrotka" },
    { "gameKey": "GoldSaucerTextData#67", "hash": "8BFDDDD2C857069F", "target": "Czwarta zwrotka" },
    { "gameKey": "GoldSaucerTextData#68", "hash": "1B148750F424EB4B", "target": "Bezbłędne ruchy" },
    { "gameKey": "GoldSaucerTextData#71", "hash": "F1BCFE488286AB5C", "target": "Dokąd wiatr poniesie" },
    { "gameKey": "GoldSaucerTextData#72", "hash": "558CEE55B754815D", "target": "Wejdź na główną scenę i zmierz swój spryt z Typhonem─niedoścignionym mistrzem parskania. Zdołasz utrzymać się na podium do końca czasu czy przeminiesz z wiatrem?" },
    { "gameKey": "GoldSaucerTextData#73", "hash": "BD7F39E18FE67D3D", "target": "Przewiduj, gdzie nastąpi kolejny wybuch z nosa Typhona, i przemieść się w bezpieczne twoim zdaniem miejsce." },
    { "gameKey": "GoldSaucerTextData#74", "hash": "492431748E8F0043", "target": "Uniknięte parsknięcia" },
    { "gameKey": "GoldSaucerTextData#81", "hash": "FFBE01A11A731A5F", "target": "Zdemaskować impa" },
    { "gameKey": "GoldSaucerTextData#82", "hash": "A9B2C0BFC23C323D", "target": "Podły imp przyjął postać szacownego gościa Gold Saucer i ukrywa się gdzieś na terenie obiektu. Znajdź wiernego sobowtóra zleceniodawcy GATE i zaaplikuj mu solidną porcję proszku brightash." },
    { "gameKey": "GoldSaucerTextData#91", "hash": "D5E0D1B105C0F219", "target": "Na skraju przepaści" },
    { "gameKey": "GoldSaucerTextData#101", "hash": "56A899DA8BBEFF5C", "target": "Kup los Mini Cactpot" },
    { "gameKey": "GoldSaucerTextData#104", "hash": "149E7C1598E376C6", "target": "<sheet(GoldSaucerTextData,lnum1,0)><if([lnum2>0], \\[Ocena: <num(lnum2)>～<num(lnum3)>\\],)>." },
