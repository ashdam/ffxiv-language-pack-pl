    { "gameKey": "AnimaWeapon5SpiritTalkParam#36.0", "hash": "19C0E217B55881A7", "target": "Nie mogę się doczekać, aż zrobię dobry użytek z tej mocy." },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#36.1", "hash": "57444305A6C55A8D", "target": "Z radością czekam na chwilę, gdy zrobię dobry użytek z tej mocy." },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#37.0", "hash": "4D97F7DEF1348158", "target": "Muszę mieć więcej eteru!" },
