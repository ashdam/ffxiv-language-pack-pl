  "entries": [
    { "gameKey": "AnimaWeapon5SpiritTalkParam#1.0", "hash": "3E37221D9A5A4A2F", "target": "Moje ciało... jest takie ciężkie..." },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#1.1", "hash": "1F91C5DA0C815185", "target": "Moje ciało... jest takie ciężkie..." },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#2.0", "hash": "475E835BD1648CAE", "target": "Och! Coś się zmieniło. Czuję... pełnię." },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#2.1", "hash": "F55B75B1A7207C26", "target": "Och! Czuję jakąś zmianę. Czuję... pełnię." },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#3.0", "hash": "EE3FA631213841A9", "target": "Co to za uczucie?" },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#3.1", "hash": "4938F1365CE7D475", "target": "Co to za uczucie?" },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#4.0", "hash": "CCA81C8081522616", "target": "Czuję tu wielką moc." },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#4.1", "hash": "72EED0375D8D3C76", "target": "Wyczuwam tu wielką moc." },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#5.0", "hash": "21909E7AFB824DC2", "target": "Co za potężna moc! Wkrótce stanie się częścią mnie!" },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#5.1", "hash": "A706A171B8FD6AA3", "target": "Co za potężna moc! Wkrótce uczynię ją swoją!" },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#6.0", "hash": "F7E44ADF737CC455", "target": "Dziś szczęście się do nas uśmiecha!" },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#6.1", "hash": "64E2344ED67A6DB0", "target": "Dziś szczęście się do nas uśmiecha!" },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#7.0", "hash": "61308B24DC8DB16B", "target": "To... dziwne uczucie..." },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#7.1", "hash": "33AE2F1C77501793", "target": "Jakie dziwne uczucie..." },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#8.0", "hash": "6E8557D84044EACC", "target": "Czy to moc kryształów?" },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#8.1", "hash": "396697F6A878B6F3", "target": "Czy to moc kryształów?" },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#9.0", "hash": "41A3DB3683AD8BD6", "target": "Ta moc... Moje ciało potrzebuje czasu, by się przyzwyczaić." },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#9.1", "hash": "F4A56DD22B0E4F75", "target": "Potrzebuję czasu, by przyzwyczaić się do tej mocy..." },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#10.0", "hash": "E466A25BDA394799", "target": "Ten eter nie jest całkiem taki jak twój." },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#10.1", "hash": "09E9A0311A14AADE", "target": "Ten eter wydaje się znajomy, a jednak jakoś inny." },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#11.0", "hash": "CF08E3D3CA3E27EF", "target": "Eter... Czuję, jak przeze mnie płynie!" },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#11.1", "hash": "A8E164C4F977BBF6", "target": "Czuję, jak eter we mnie wzbiera!" },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#12.0", "hash": "C89AD80E53754B94", "target": "Moja moc... rośnie!" },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#12.1", "hash": "CF4EF6D1B0BFD16C", "target": "Moja moc... rośnie!" },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#13.0", "hash": "C450407A4FF80A70", "target": "Tyle eteru, że ledwie mogę to wytrzymać!" },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#13.1", "hash": "88D7CB96B83517FA", "target": "Nie wiem, ile jeszcze eteru zdołam pomieścić." },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#14.0", "hash": "21056771E46AF4E0", "target": "Czy na pewno to bezpieczne?" },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#14.1", "hash": "8997038998EFCF5A", "target": "To mi nie zaszkodzi?" },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#15.0", "hash": "CD3A214825F3670A", "target": "Wkrótce ta moc będzie pod moją kontrolą." },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#15.1", "hash": "5AB9C29465F5D5B9", "target": "Wkrótce ta moc będzie moja." },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#16.0", "hash": "119206668C828779", "target": "Znów posilam się eterem kryształów." },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#16.1", "hash": "F6D4076D051CF026", "target": "Znów ucztuję, sycąc się eterem kryształów." },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#17.0", "hash": "9CBBC2D496D06099", "target": "Czuję, jak wlewa się we mnie eter." },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#17.1", "hash": "BF3B3632C2C7E7FB", "target": "Czuję, jak napływa we mnie eter." },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#18.0", "hash": "D68027BE23F74F7F", "target": "Eter wzbiera we mnie." },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#18.1", "hash": "7E43CCB9BFACCE91", "target": "Eter wzbiera we mnie." },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#19.0", "hash": "024879AD08F37E7D", "target": "Z każdym ziarnkiem piasku rosnę w siłę." },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#19.1", "hash": "0055FA1B745611CF", "target": "Z każdym ziarnkiem piasku zyskuję siłę." },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#20.0", "hash": "0E34F126EC048CCB", "target": "Ten piasek coraz bardziej mi się podoba." },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#20.1", "hash": "99294CA0107EB2D1", "target": "Całkiem lubię ten piasek." },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#21.0", "hash": "4B88697106DFD087", "target": "Masz więcej?" },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#21.1", "hash": "B6343FCF5ABA7C17", "target": "Proszę, czy mogę dostać jeszcze trochę?" },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#22.0", "hash": "B6145C691B08FC82", "target": "Mmm... Ten eter mnie podtrzymuje." },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#22.1", "hash": "C4D5A599C09EEF89", "target": "Mmm... Ten eter mnie podtrzymuje." },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#23.0", "hash": "9459C78195D47D5C", "target": "Wkrótce osiągnę pełnię swojego potencjału!" },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#23.1", "hash": "461D58C3C5709786", "target": "Wkrótce osiągnę pełnię swojego potencjału!" },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#24.0", "hash": "7EF6D8407F7BF290", "target": "Czuję w sobie nową moc." },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#24.1", "hash": "63213EA3E3936863", "target": "Czuję, jak narasta we mnie nowa siła." },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#25.0", "hash": "A36784E73071BBB7", "target": "Odwdzięczę się <if(gnum4,pani,panu)> tym samym." },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#25.1", "hash": "1F1F7E9518EFD2D4", "target": "Podzielę się z <if(gnum4,panią,panem)> tą siłą." },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#26.0", "hash": "1B6B677433C01D0E", "target": "Pewnego dnia stanę się godny tej mocy." },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#26.1", "hash": "7A77B0777081FB27", "target": "Moja siła jest na <if(gnum4,pani,pana)> rozkazy!" },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#27.0", "hash": "03601406BC09D63F", "target": "Muszę stać się silniejszy!" },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#27.1", "hash": "5D2F4A85E991B164", "target": "Stanę się silniejsza!" },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#28.0", "hash": "38651506643F1301", "target": "Wciąż mogę stać się o wiele lepszy." },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#28.1", "hash": "2F83895C7663147D", "target": "Wciąż mam wielkie możliwości rozwoju." },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#29.0", "hash": "A901F79C82D2578F", "target": "Ten dar się nie zmarnuje." },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#29.1", "hash": "A8968E9DF75CF84D", "target": "Ten dar się nie zmarnuje." },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#30.0", "hash": "8797523DC08CF97D", "target": "Przenika mnie na wskroś!" },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#30.1", "hash": "CF637CD830668AA0", "target": "Czuję, jak mnie przenika!" },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#31.0", "hash": "BE9A0E67A8104869", "target": "Spójrz na moją nową siłę!" },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#31.1", "hash": "09BCD1B1E7783A2B", "target": "Spójrz na moją nową siłę!" },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#32.0", "hash": "E9DE435561DC0A09", "target": "Gdy zdobędę dość siły, żaden cel nie będzie poza naszym zasięgiem." },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#32.1", "hash": "06227D983CD0F012", "target": "Gdy zdobędę dość siły, żaden cel nie będzie poza naszym zasięgiem." },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#33.0", "hash": "5F681DD7217624A6", "target": "Twoi wrogowie zadrżą przed naszą potęgą!" },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#33.1", "hash": "BBB316ECCCA299BE", "target": "Twoi wrogowie zadrżą przed naszą potęgą!" },
    { "gameKey": "AnimaWeapon5SpiritTalkParam#34.0", "hash": "20A1C669E71B7F11", "target": "Mój duch jeszcze nigdy nie płonął tak jasno!" },
