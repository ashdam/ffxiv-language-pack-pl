    { "gameKey": "GeneralAction#1.0", "hash": "F172C0074052DC60", "target": "Atak automatyczny" },
    { "gameKey": "GeneralAction#1.1", "hash": "491F40B1F8E4ED43", "target": "Automatycznie atakuje bieżący cel w odstępach czasu zależnych od używanej broni." },
    { "gameKey": "GeneralAction#2.0", "hash": "33A46B5B60E9E964", "target": "Skok" },
    { "gameKey": "GeneralAction#2.1", "hash": "F20F103FE205C548", "target": "Wykonuje wyskok z ziemi lub innego podłoża dzięki ugięciu i gwałtownemu wyprostowi nóg." },
    { "gameKey": "GeneralAction#3.0", "hash": "0453C0983E4338A9", "target": "Limit Break" },
    { "gameKey": "GeneralAction#3.1", "hash": "615074376A682417", "target": "Zużywa energię zgromadzoną we wskaźniku limitu drużyny, by wykonać potężną technikę walki. Technika zależy od <colortype(500)><edgecolortype(501)>roli<edgecolortype(0)><colortype(0)> członka drużyny, który ją uruchomi.<br>Obrońca: Wzmacnia obronę drużyny (obszar działania: 50y).<br>DPS wręcz: Atak na pojedynczy cel.<br>Fizyczny DPS dystansowy: Atak na wszystkie cele w linii prostej (zasięg: 30y).<br>Magiczny DPS dystansowy: Atak obszarowy (8y/10y/15y).<br>Uzdrowiciel: Przywracanie HP. Wskrzeszenie na poziomie 3 (obszar działania: 50y).<br>※Jeśli cel nie jest osłabiony w chwili wskrzeszenia, zostanie przywrócony do życia bez osłabienia. Jeśli jest wtedy osłabiony, czas trwania osłabienia zostanie zresetowany." },
    { "gameKey": "GeneralAction#4.0", "hash": "756A7B05B883A50C", "target": "Sprint" },
    { "gameKey": "GeneralAction#4.1", "hash": "44383BF4902D4A34", "target": "Zwiększa szybkość ruchu.<br><colortype(504)><edgecolortype(505)>Czas trwania: <edgecolortype(0)><colortype(0)>10 s (20 s poza walką)<br>※Niedostępne w PvP." },
    { "gameKey": "GeneralAction#5.0", "hash": "4DA935E90959B1A1", "target": "Desynthesis" },
    { "gameKey": "GeneralAction#5.1", "hash": "65027456863EA414", "target": "Rozkłada przedmiot na co najmniej jeden z materiałów, z których go wykonano." },
    { "gameKey": "GeneralAction#6.0", "hash": "4E8E82F33E3E09FC", "target": "Naprawa" },
