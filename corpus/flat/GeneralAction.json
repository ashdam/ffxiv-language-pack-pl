    { "gameKey": "GeneralAction#7.0", "hash": "D1226DC8E16704ED", "target": "Teleportacja" },
    { "gameKey": "GeneralAction#7.1", "hash": "FE8D5981F73409D9", "target": "Zamienia twoje ciało w eter i natychmiast przenosi cię do dowolnego eterytu, z którym masz już nawiązane zestrojenie. Po przybyciu na miejsce należy uiścić opłatę w gilach." },
